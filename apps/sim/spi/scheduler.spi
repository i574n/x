///- --package .
///> rust -d sha2
///> gleam
test scheduler static =
    :< testing

:< sm'_operators
:< prelude
:< glyphs
:< events
:< inbox

:| task_status =
    | Done
    | Erred
    | Crashed

:== task_result = { status : task_status; out : string }

:== visible_entry = { key : string; result : task_result }

:| eviction =
    | NoEviction
    | EvictNow
    | EvictAfter : i32

:== fault_set = { cancel : bool; rerun : bool; eviction : eviction; naive : bool; limit : i32 }

:| task_command =
    | StartTask : { key : string; sources : list string }
    | CancelTask : string

:== task_work =
    { running : dictm.dict string (list string); queue : list string; results : dictm.dict string task_result }

:== owner_map = { refs : dictm.dict string i32; post_key : dictm.dict string string; owner : dictm.dict string string }

:== life_cycle = { doomed : dictm.dict string i32; clock : i32 }

:== counts = dictm.dict string i32

:== run_counts =
    {starts : counts; cancelled : counts; evicted : counts; cancels : i32; rescues : i32; recomputes : i32;
     peak_inflight : i32; peak_results : i32}

:== scheduler =
    {in_box : inbox; task_work : task_work; owner_map : owner_map; life_cycle : life_cycle; run_counts : run_counts;
     visible_map : dictm.dict string visible_entry; faults : fault_set; out_commands : list task_command}

:= no_counts () : run_counts =
    { starts = dictm.empty (); cancelled = dictm.empty (); evicted = dictm.empty (); cancels = 0i32; rescues = 0i32
      recomputes = 0i32; peak_inflight = 0i32; peak_results = 0i32 }

:= no_work () : task_work = { running = dictm.empty (); queue = Nil; results = dictm.empty () }

:= no_owners () : owner_map = { refs = dictm.empty (); post_key = dictm.empty (); owner = dictm.empty () }

:= no_life () : life_cycle = { doomed = dictm.empty (); clock = 0i32 }

:= new_scheduler (f : fault_set) : scheduler =
    { in_box = new_inbox (); task_work = no_work (); owner_map = no_owners (); life_cycle = no_life ()
      run_counts = no_counts (); visible_map = dictm.empty (); faults = f; out_commands = Nil }

:= counted_with (bump : run_counts -> run_counts) (s : scheduler) : scheduler =
    { s ?| run_counts = bump s.run_counts }

:= bumped (key : string) (d : dictm.dict string i32) : dictm.dict string i32 =
    dictm.updated key 0i32 (\ n => n + 1i32) d

:= with_work (g : task_work -> task_work) (s : scheduler) : scheduler = { s ?| task_work = g s.task_work }

:= with_owners (g : owner_map -> owner_map) (s : scheduler) : scheduler = { s ?| owner_map = g s.owner_map }

:= with_life (g : life_cycle -> life_cycle) (s : scheduler) : scheduler = { s ?| life_cycle = g s.life_cycle }

:= emitted (c : task_command) (s : scheduler) : scheduler = { s ?| out_commands = c :: s.out_commands }

:= result_evicted (key : string) (s : scheduler) : scheduler =
    s
    |> with_work (\ w => { w ?| results = dictm.remove key w.results })
    |> counted_with \ c => { c ?| evicted = bumped key c.evicted }

:= evicted_key (key : string) (s : scheduler) : scheduler =
    ? dictm.has key s.task_work.results |> not ?> s |: result_evicted key s

:= doomed_key (key : string) (s : scheduler) : scheduler =
    ?= s.faults.eviction ?|
    | NoEviction => s
    | EvictNow => evicted_key key s
    | EvictAfter n => s |> with_life (\ l => { l ?| doomed = dictm.insert key (l.clock + n) l.doomed })

:= due_keys (all : bool) (l : life_cycle) : list string =
    dictm.keys l.doomed |> keep (\ k => all || dictm.present k l.doomed <= l.clock)

:= undoomed (due : list string) (l : life_cycle) : life_cycle =
    { l ?| doomed = due |> listm.fold (\ d k => dictm.remove k d) l.doomed }

:= evicted_unless_held (s : scheduler) (k : string) : scheduler = ? dictm.has k s.owner_map.refs ?> s |: evicted_key k s

:= expired (all : bool) (s : scheduler) : scheduler =
    := due = due_keys all s.life_cycle
    due |> listm.fold evicted_unless_held (s |> with_life (undoomed due))

:= rescue_counted (key : string) (s : scheduler) : scheduler =
    ? dictm.has key s.task_work.results ?> s |> counted_with (\ c => { c ?| rescues = c.rescues + 1i32 }) |: s

:= rescued (key : string) (s : scheduler) : scheduler =
    ? dictm.has key s.life_cycle.doomed |> not ?> s
    |: s |> with_life (\ l => { l ?| doomed = dictm.remove key l.doomed }) |> rescue_counted key

:= cancelled_task (key : string) (s : scheduler) : scheduler =
    s |> with_work (\ w => { w ?| running = dictm.remove key w.running }) |> emitted (CancelTask key)
    |> counted_with (\ c => { c ?| cancels = c.cancels + 1i32; cancelled = bumped key c.cancelled })

:= dropped_ref (key : string) (s : scheduler) : scheduler =
    s
    |> with_owners (\ o => { o ?| refs = dictm.remove key o.refs })
    |> with_work \ w => { w ?| queue = w.queue |> keep \ q => q <> key }

:= unreferenced (key : string) (s : scheduler) : scheduler =
    := s = dropped_ref key s |> doomed_key key
    ? s.faults.cancel && dictm.has key s.task_work.running ?> cancelled_task key s |: s

:= released_key (key : string) (s : scheduler) : scheduler =
    := n = dictm.present key s.owner_map.refs - 1i32
    ? n > 0i32 ?> s |> with_owners (\ o => { o ?| refs = dictm.insert key n o.refs }) |: unreferenced key s

:= queued_has (key : string) (s : scheduler) : bool = has (\ q => q = key) s.task_work.queue

:= idle_key (key : string) (s : scheduler) : bool =
    not (dictm.has key s.task_work.results || dictm.has key s.task_work.running || queued_has key s)

:= enqueued (key : string) (s : scheduler) : scheduler =
    := s = s |> with_work (\ w => { w ?| queue = listm.append w.queue [ key ] })
    ? dictm.has key s.run_counts.evicted ?> s |> counted_with \ c => { c ?| recomputes = c.recomputes + 1i32 }
    |: s

:= ref_count (key : string) (s : scheduler) : i32 = ?= dictm.find key s.owner_map.refs ?| Some x => x | None => 0i32

:= owned_by (key : string) (id : string) (n : i32) (o : owner_map) : owner_map =
    { o ?| refs = dictm.insert key n o.refs; owner = dictm.insert key id o.owner }

:= acquired_key (key : string) (id : string) (s : scheduler) : scheduler =
    := n = ref_count key s + 1i32
    := s = rescued key s |> with_owners (owned_by key id n)
    ? n = 1i32 && idle_key key s ?> enqueued key s |: s

:= same_key (a : option string) (b : option string) : bool =
    ?= a, b ?|
    | Some x, Some y => x = y
    | None, None => !+
    | _ => !-

:= with_post_key (id : string) (k : option string) (o : owner_map) : owner_map =
    ?= k ?|
    | Some key => { o ?| post_key = dictm.insert id key o.post_key }
    | None => { o ?| post_key = dictm.remove id o.post_key }

:= released_old (old : option string) (s : scheduler) : scheduler = ?= old ?| Some k => released_key k s | None => s

:= acquired_next (next : option string) (id : string) (s : scheduler) : scheduler =
    ?= next ?| Some k => acquired_key k id s | None => s

:= moved_target (s : scheduler) (id : string) (old : option string) (next : option string) : scheduler =
    s |> with_owners (with_post_key id next) |> released_old old |> acquired_next next id

:= retargeted (s : scheduler) (id : string) : scheduler =
    := old = dictm.find id s.owner_map.post_key
    := next = wanted_key s.in_box id
    ? same_key old next ?> s |: moved_target s id old next

:= rerun_due (s : scheduler) (k : string) : bool =
    dictm.has k s.task_work.results && not (dictm.has k s.task_work.running || queued_has k s)

:= requeued_completed (s : scheduler) : scheduler =
    := again = dictm.keys s.owner_map.refs |> keep (rerun_due s)
    s |> with_work (\ w => { w ?| queue = listm.append w.queue again })

:= running_one (key : string) (id : string) (s : scheduler) : scheduler =
    s |> with_work (\ w => { w ?| running = dictm.insert key [ id ] w.running })

:= start_command (key : string) (id : string) (s : scheduler) : task_command =
    StartTask { key; sources = sources s.in_box id }

:= started_one (key : string) (s : scheduler) : scheduler =
    := id = dictm.present key s.owner_map.owner
    := s = running_one key id s
    s |> counted_with (\ c => { c ?| starts = bumped key c.starts }) |> emitted (start_command key id s)

:~ ^ started_queued (s : scheduler) : scheduler =
    ?= s.task_work.queue ?|
    | key :: rest ?& dictm.size s.task_work.running < s.faults.limit =>
        s |> with_work (\ w => { w ?| queue = rest }) |> started_one key |> started_queued
    | _ => s

:= peaked (n : i32) (r : i32) (c : run_counts) : run_counts =
    { c ?| peak_inflight = ? n > c.peak_inflight ?> n |: c.peak_inflight
           peak_results = ? r > c.peak_results ?> r |: c.peak_results }

:= with_peak (s : scheduler) : scheduler =
    s |> counted_with (peaked (dictm.size s.task_work.running) (dictm.size s.task_work.results))

:= reconciled_with (rerun : bool) (s : scheduler) : scheduler =
    := dirty, b = dirty_taken s.in_box
    := s = dirty |> listm.fold retargeted { s ?| in_box = b }
    := s = ? rerun ?> requeued_completed s |: s
    started_queued s |> with_peak

:= reconciled (s : scheduler) : scheduler = reconciled_with s.faults.rerun s

:= drained (s : scheduler) : scheduler = reconciled_with !- s

:== visible_by_id = dictm.dict string visible_entry

:= shown_for (key : string) (r : task_result) (owners : list string) (v : visible_by_id) : visible_by_id =
    owners |> listm.fold (\ v id => dictm.insert id { key; result = r } v) v

:= work_finished (key : string) (r : task_result) (w : task_work) : task_work =
    { w ?| running = dictm.remove key w.running; results = dictm.insert key r w.results }

:= shown_if_naive (key : string) (r : task_result) (owners : list string) (s : scheduler) : scheduler =
    ? s.faults.naive ?> { s ?| visible_map = shown_for key r owners s.visible_map } |: s

:= finished_task (key : string) (r : task_result) (s : scheduler) : scheduler =
    ?= dictm.find key s.task_work.running ?|
    | Some owners => s |> with_work (work_finished key r) |> shown_if_naive key r owners
    | None => s

:= delivered_to (d : delivery) (s : scheduler) : scheduler =
    { s ?| in_box = delivered s.in_box d }
    |> with_life (\ l => { l ?| clock = l.clock + 1i32 })
    |> expired !-
    |> reconciled

:= result_shown (s : scheduler) (v : visible_by_id) (id : string) (key : string) : visible_by_id =
    ?= dictm.find key s.task_work.results ?|
    | Some r => dictm.insert id { key; result = r } v
    | None => v

:= settled_view (s : scheduler) : scheduler =
    ? dictm.size s.visible_map > 0i32 ?> s
    |: { s ?| visible_map = wanted_keys s.in_box |> dictm.fold (result_shown s) (dictm.empty ()) }

:= commands_taken (s : scheduler) : list task_command * scheduler =
    listm.rev s.out_commands, { s ?| out_commands = Nil }

:= fake_out (l : list string) : string = cut 0i32 12i32 (crypto.hash_text (delimited (char_of 0i32) l))

:= fake_result (l : list string) : task_result = { status = Done; out = fake_out l }

:= executed_by (exec : list string -> task_result) (s : scheduler) (c : task_command) : scheduler =
    ?= c ?|
    | StartTask t => finished_task t.key (exec t.sources) s
    | CancelTask _ => s

:= executed (s : scheduler) (c : task_command) : scheduler = executed_by fake_result s c

:~ ^ executed_all_by (exec : list string -> task_result) (s : scheduler) : scheduler =
    := cmds, s = commands_taken s
    ?= cmds ?|
    | Nil => s
    | _ => cmds |> listm.fold (executed_by exec) s |> drained |> executed_all_by exec

:= executed_all (s : scheduler) : scheduler = executed_all_by fake_result s

:= plain_faults () : fault_set = { cancel = !+; rerun = !-; eviction = NoEviction; naive = !-; limit = 4i32 }

:= sync_run_with (exec : list string -> task_result) (f : fault_set) (l : list delivery) : scheduler =
    := ~deliveries = l
    deliveries
    |> listm.fold (\ s d => delivered_to d s |> executed_all_by exec) (new_scheduler f)
    |> expired !+
    |> settled_view

:= sync_run (f : fault_set) (l : list delivery) : scheduler = sync_run_with fake_result f l

:= deferred_run (f : fault_set) (l : list delivery) : scheduler =
    := ~deliveries = l
    deliveries
    |> listm.fold (\ s d => delivered_to d s) (new_scheduler f)
    |> executed_all
    |> expired !+
    |> settled_view

:= visible_out (s : scheduler) (id : string) : string =
    ?= dictm.find id s.visible_map ?|
    | Some e => e.result.out
    | None => "-"

:= liked_post (id : string) : list delivery = [ post_at 0i32 id None "inl a = 1"; like_at 1i32 id "u" ]

:= computed_once_shape (id : string) (s : scheduler) : i32 * string * i32 =
    dictm.size s.run_counts.starts, visible_out s id, sm'.length (visible_out s id)

test a_liked_post_is_computed_once =
    := ~id = "p0"
    sync_run (plain_faults ()) (liked_post id) |> computed_once_shape id
    |> _assert_eq (1i32, fake_out [ "inl a = 1" ], 12i32)

test withdrawn_demand_cancels_the_running_task =
    := ~id = "p0"
    := s = deferred_run (plain_faults ()) [ post_at 0i32 id None "x"; like_at 1i32 id "u"; unlike_at 2i32 id "u" ]
    (s.run_counts.cancels, dictm.size s.visible_map) |> _assert_eq (1i32, 0i32)

:= same_source_roots (a : string) : list delivery =
    [ post_at 0i32 a None "x"; post_at 1i32 "b" None "x"; like_at 2i32 a "u"; like_at 3i32 "b" "u" ]

test same_source_roots_share_one_task =
    := ~a = "a"
    := s = sync_run (plain_faults ()) (same_source_roots a)
    (dictm.size s.run_counts.starts, visible_out s a = visible_out s "b") |> _assert_eq (1i32, !+)

:= evict_now () : fault_set =
    := plain = plain_faults ()
    { plain ?| eviction = EvictNow }

:= relike_stream (id : string) : list delivery =
    [ post_at 0i32 id None "x"; like_at 1i32 id "u"; unlike_at 2i32 id "u"; like_at 3i32 id "u" ]

:= recompute_shape (id : string) (s : scheduler) : i32 * i32 =
    s.run_counts.recomputes, dictm.present (dictm.present id s.owner_map.post_key) s.run_counts.evicted

test eviction_then_relike_recomputes =
    := ~id = "p0"
    sync_run (evict_now ()) (relike_stream id) |> recompute_shape id |> _assert_eq (1i32, 1i32)

:= crash_finished (s : scheduler) (c : task_command) : scheduler =
    ?= c ?|
    | StartTask t => finished_task t.key { status = Crashed; out = "boom" } s
    | CancelTask _ => s

:= liked_once_by (id : string) (s : scheduler) : scheduler =
    s |> delivered_to (post_at 0i32 id None "x") |> delivered_to (like_at 1i32 id "u")

:= crashed_run (id : string) : scheduler =
    := cmds, s = commands_taken (new_scheduler (plain_faults ()) |> liked_once_by id)
    cmds |> listm.fold crash_finished s |> drained |> expired !+ |> settled_view

:= crash_out (s : scheduler) (id : string) : string =
    ?= dictm.find id s.visible_map ?|
    | Some e =>
        ?= e.result.status ?|
        | Crashed => e.result.out
        | _ => "not a crash"
    | None => "-"

test a_crashed_task_is_a_visible_crash_result =
    := ~id = "p0"
    := s = crashed_run id
    (crash_out s id, dictm.size s.run_counts.starts) |> _assert_eq ("boom", 1i32)