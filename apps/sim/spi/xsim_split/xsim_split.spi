///- --package .. --timeout 600000
///> gleam
test xsim_split static =
    :< testing

:< sm'_operators
:< prelude
:< glyphs
:< protocol
:< splitter

:= split_joined (label : string) (limit : i32) (source : string) : string =
    split_cell (cell_id label) limit source |> delimited (char_of 0i32)

test joined_chunks_split_back_into_the_same_cells =
    := ~source = "go x.com now"
    split_joined "c1" 280i32 source |> split_all (char_of 0i32) |> _assert_eq (split_cell (cell_id "c1") 280i32 source)

:= list_export () : () =
    export
        "split_cell"
        ((\ (label, limit, source) => split_cell (cell_id label) limit source) : string * i32 * string -> list string)

:= joined_export () : () =
    export
        "split_cell_joined"
        ((\ (label, limit, source) => split_joined label limit source) : string * i32 * string -> string)

///> _
:= main () : i32 =
    list_export ()
    joined_export ()
    export "file_cells" ((\ text => file_cells text) : string -> list string)
    export "thread_posts" ((\ text => posts_of text) : string -> list string)
    0i32
