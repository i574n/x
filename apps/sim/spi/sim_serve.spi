///- --package .
///> gleam
test sim_serve static =
    :< testing

:< sm'_operators
:< prelude

:== term = erlang_term::term

:= call (m : string) (f : string) (args : list term) : term = erlang_term::apply m f args

:= str (s : string) : term = erlang_term::of s

:= int (n : i32) : term = erlang_term::of n

:= text (t : term) : string = erlang_term::cast t

:= atom (a : string) : term = erlang_term::atom a

:= second (t : term) : term = call "erlang" "element" [ int 2i32; t ]

:= truth (t : term) : bool = erlang_term::cast t

:= tag_of (t : term) : term = call "erlang" "element" [ int 1i32; t ]

:= is_ok (t : term) : bool = truth (call "erlang" "is_tuple" [ t ]) && erlang_term::equal (tag_of t) (atom "ok")

:= pair (k : string) (v : term) : term = erlang_term::tuple [ atom k; v ]

:= tcp (f : string) (args : list term) : term = call "gen_tcp" f args

:= byte_count (s : string) : i32 = call "erlang" "byte_size" [ str s ] |> erlang_term::cast

:= loopback () : term = erlang_term::tuple [ int 127i32; int 0i32; int 0i32; int 1i32 ]

:= raw_options () : list term = [ atom "binary"; pair "packet" (atom "raw"); pair "active" (erlang_term::of !-) ]

:= listen_options () : term =
    := extra = [ pair "reuseaddr" (erlang_term::of !+); pair "ip" (loopback ()) ]
    listm::append (raw_options ()) extra |> erlang_term::list_term

:= listened () : term = tcp "listen" [ int 0i32; listen_options () ] |> second

:= port_of (listener : term) : i32 = call "inet" "port" [ listener ] |> second |> erlang_term::cast

:= head_end (s : string) : i32 = sm'::index_of "\r\n\r\n" s

:= after_prefix (prefix : string) (line : string) : string =
    sm'::trim (sm'::substring (sm'::length prefix) (sm'::length line - sm'::length prefix) line)

:~ header_value (name : string) (head : string) : string =
    := prefix = name ++# ":"
    ?= pieces "\r\n" head |> keep (\ l => sm'::starts_with prefix (sm'::to_lower l)) ?|
    | l :: _ => after_prefix prefix l
    | Nil => ""

:= count_or_zero (s : string) : i32 = ?= count_of_text s ?| Some n => n | None => 0i32

:= body_length (head : string) : i32 = count_or_zero (header_value "content-length" head)

:= complete (acc : string) : bool =
    := at = head_end acc
    at >= 0i32 && byte_count acc >= at + 4i32 + body_length (cut 0i32 at acc)

:= recv_chunk (sock : term) : term = tcp "recv" [ sock; int 0i32; int 10000i32 ]

:~ ^ received (sock : term) (acc : string) : string =
    := got = ? complete acc ?> atom "done" |: recv_chunk sock
    ? is_ok got ?> received sock (acc ++# text (second got)) |: acc

:~ ^ drained (sock : term) (acc : string) : string =
    := got = recv_chunk sock
    ? is_ok got ?> drained sock (acc ++# text (second got)) |: acc

:== request = { method : string; path : string; query : string; head : string; raw : string }

:= first_line (head : string) : string = cut 0i32 (sm'::index_of "\r\n" head) head

:= target_of (head : string) : string = ?= pieces " " (first_line head) ?| _ :: t :: _ => t | _ => "/"

:= split_once (sep : string) (s : string) : string * string =
    := i = sm'::index_of sep s
    := rest = i + sm'::length sep
    ? i < 0i32 ?> s, "" |: cut 0i32 i s, sm'::substring rest (sm'::length s - rest) s

:= method_of (head : string) : string = ?= pieces " " head ?| m :: _ => m | Nil => ""

:~ request_of (raw : string) : request =
    := head = cut 0i32 (head_end raw) raw
    := target, _ = split_once "#" (target_of head)
    := path, query = split_once "?" target
    { method = method_of head; path; query; head; raw }

:= url_decoded (s : string) : string = call "uri_string" "percent_decode" [ str (sm'::replace "+" " " s) ] |> text

:= pair_value (name : string) (item : string) : option string =
    := k, v = split_once "=" item
    ? v <> "" && url_decoded k = name ?> Some (url_decoded v) |: None

:~ ^ first_value (name : string) (items : list string) : string =
    ?= items ?|
    | item :: rest => ?= pair_value name item ?| Some v => v | None => first_value name rest
    | Nil => ""

:= gated (cond : bool) (pairs : list (string * term)) : list (string * term) = ? cond ?> pairs |: Nil

:= listed (name : string) (query : string) : list string =
    first_value name (pieces "&" query) |> pieces "," |> keep (\ s => s <> "")

:== index = dictm::dict string term

:== write_state = { me : term; created : dictm::dict string (); next_id : i32 }

:== api_world =
    { token : string; user_token : string; by_handle : index; by_id : index; page_size : i32; by_post : index;
        stale : bool; now : string; raw : term; issued : list string; writes : write_state }

:= writes_of (me : term) (created : dictm::dict string ()) (next_id : i32) : write_state = { me; created; next_id }

:= no_writes () : write_state = writes_of (erlang_term::of "") (dictm::empty ()) 9001i32
:= field (key : string) (m : term) : term = call "maps" "get" [ str key; m; str "" ]

:= items_at (key : string) (m : term) : term = call "maps" "get" [ str key; m; erlang_term::list_term Nil ]

:= terms_of (items : term) : list term =
    := n = call "erlang" "length" [ items ] |> erlang_term::cast
    listm::init n (\ i => call "lists" "nth" [ int (i + 1i32); items ])

:= id_text (id : term) : string =
    ? truth (call "erlang" "is_binary" [ id ]) ?> text id |: text (call "erlang" "integer_to_binary" [ id ])

:= json_file (path : string) : term = call "json" "decode" [ str (file_system::read_all_text path) ]

:= dir_of (path : string) : string = call "filename" "dirname" [ str path ] |> text

:= sibling (path : string) (name : term) : string = dir_of path ++# "/" ++# text name

:= users_in (w : term) : list term = terms_of (items_at "users" w)

:~ included_users (path : string) (w : term) : list term =
    := extras = terms_of (items_at "include" w) |> each (\ t => users_in (json_file (sibling path t)))
    listm::append (users_in w) (listm::concat extras)

:= with_author (u : term) (p : term) : term = call "maps" "put" [ str "author_id"; field "id" u; p ]

:= post_key (p : term) : string = id_text (field "id" p)

:= handle_of (u : term) : string = sm'::to_lower (text (field "username" u))

:~ with_posts (u : term) (posts : dictm::dict string term) : dictm::dict string term =
    terms_of (items_at "posts" u) |> listm::fold (\ d p => dictm::insert (post_key p) (with_author u p) d) posts

:= with_user (w : api_world) (u : term) : api_world =
    := handles = dictm::insert (handle_of u) u w::by_handle
    { w ?| by_handle = handles; by_id = dictm::insert (post_key u) u w::by_id; by_post = with_posts u w::by_post }

:= page_size_of (w : term) : i32 = call "maps" "get" [ str "following_page_size"; w; int 100i32 ] |> erlang_term::cast

:= fresh () : dictm::dict string term = dictm::empty ()

:= blank_world (token : string) (user_token : string) (now : string) : api_world =
    { token; user_token; by_handle = fresh (); by_id = fresh (); page_size = 100i32; by_post = fresh ();
        stale = !-; now; raw = str ""; issued = Nil; writes = no_writes () }

:= first_refresh (w : term) : list string = [ text (field "refresh_token" (field "oauth2" w)) ]

:= world_auth (w : term) (b : api_world) : api_world =
    := writes = writes_of (field "me" w) b::writes::created b::writes::next_id
    { b ?| raw = w; issued = first_refresh w; writes = writes; page_size = page_size_of w }

:= empty_world (w : term) : api_world =
    blank_world (text (field "token" w)) (text (field "user_token" w)) (text (field "now" w)) |> world_auth w

:~ world_of (path : string) : api_world =
    := w = json_file path
    included_users path w |> listm::fold with_user (empty_world w)

:= pct (s : string) : string = call "uri_string" "quote" [ str s; erlang_term::charlist "" ] |> text

:= unescaped (s : string) : string = call "uri_string" "percent_decode" [ str s ] |> text

:= base64_of (bytes : term) : string = call "base64" "encode" [ bytes ] |> text

:= hmac_sha1 (key : string) (base : string) : string =
    base64_of (call "crypto" "mac" [ atom "hmac"; atom "sha"; str key; str base ])

:= pair_text (t : term) : string = text (call "erlang" "element" [ int 1i32; t ]) ++# "=" ++# text (second t)

:= encoded_pair (kv : string * string) : term = kv |> \ (k, v) => erlang_term::tuple [ str (pct k); str (pct v) ]

:~ signed_params (params : list (string * string)) : string =
    := tuples = params |> each encoded_pair |> erlang_term::list_term
    call "lists" "sort" [ tuples ] |> terms_of |> each pair_text |> delimited "&"

:== signing = { method : string; url : string; params : list (string * string); consumer : string; token : string }

:~ oauth1_signature (s : signing) : string =
    := base = s::method ++# "&" ++# pct s::url ++# "&" ++# pct (signed_params s::params)
    hmac_sha1 (pct s::consumer ++# "&" ++# pct s::token) base

:= example_oauth () : list (string * string) =
    [ ("oauth_consumer_key", "xvz1evFS4wEEPTGEFPHBog"); ("oauth_nonce", "kYjzVBB8Y0ZFabxSWbWovY3uYSQ2pTgmZeNu2VS4cg");
        ("oauth_signature_method", "HMAC-SHA1"); ("oauth_timestamp", "1318622958") ]

:= example_rest () : list (string * string) =
    [ ("include_entities", "true"); ("status", "Hello Ladies + Gentlemen, a signed OAuth request!");
        ("oauth_token", "370773112-GmHxMAgYyLbNEtIKZeRNFsMKPR9EyMZeS9weJAEb"); ("oauth_version", "1.0") ]

:= example_secrets () : string * string =
    "kAcSOqF21Fu85e7zjz7ZN2U4ZRhfV3WpwPAoE3Z7kBw", "LswwdoUaIvS8ltyTt5jkRh4J50vUPVVHtR2YPi5kE"

:= example_signing () : signing =
    := params = listm::append (example_rest ()) (example_oauth ())
    := consumer, token = example_secrets ()
    { method = "POST"; url = "https://api.x.com/1.1/statuses/update.json"; params; consumer; token }

:= oauth1_self_test () : bool = oauth1_signature (example_signing ()) = "Ls93hJiZbQ3akF3HF3x1Bz8/zU4="

:= header_field (part : string) : string * string =
    split_once "=" (sm'::trim part) |> \ (k, v) => (unescaped k, unescaped (sm'::replace "\"" "" v))

:= oauth_fields (auth : string) : list (string * string) =
    pieces "," (sm'::substring 6i32 (sm'::length auth - 6i32) auth) |> each header_field

:= fields_value (key : string) (fields : list (string * string)) : string =
    ?= fields |> keep (\ (k, _) => k = key) ?| (_, v) :: _ => v | Nil => ""

:= oauth1_secret (w : api_world) (key : string) : string = text (field key (field "oauth1" w::raw))

:= owned_by (w : api_world) (fields : list (string * string)) : bool =
    := consumer = fields_value "oauth_consumer_key" fields = oauth1_secret w "consumer_key"
    consumer && fields_value "oauth_token" fields = oauth1_secret w "token"

:= signing_url (r : request) : string = "http://" ++# header_value "host" r::head ++# r::path

:= oauth1_secrets (w : api_world) : string * string = oauth1_secret w "consumer_secret", oauth1_secret w "token_secret"

:= unsigned (fields : list (string * string)) : list (string * string) =
    fields |> keep (\ (k, _) => k <> "oauth_signature")

:= request_signing (w : api_world) (r : request) (fields : list (string * string)) : signing =
    := consumer, token = oauth1_secrets w
    { method = r::method; url = signing_url r; params = unsigned fields; consumer; token }

:~ oauth1_valid (w : api_world) (r : request) (auth : string) : bool =
    := fields = oauth_fields auth
    owned_by w fields && fields_value "oauth_signature" fields = oauth1_signature (request_signing w r fields)

:= client_basic (w : api_world) : string =
    := o = field "oauth2" w::raw
    "Basic " ++# base64_of (str (text (field "client_id" o) ++# ":" ++# text (field "client_secret" o)))

:= bearer_kind (w : api_world) (auth : string) : string =
    ? auth = "Bearer " ++# w::token ?> "app" |? auth = "Bearer " ++# w::user_token ?> "user" |: ""

:= is_client (w : api_world) (r : request) (auth : string) : bool =
    auth = client_basic w && r::path = "/2/oauth2/token"

:= is_oauth1 (w : api_world) (r : request) (auth : string) : bool =
    sm'::starts_with "OAuth " auth && oauth1_valid w r auth

:~ auth_kind (w : api_world) (r : request) : string =
    := auth = header_value "authorization" r::head
    ? bearer_kind w auth <> "" ?> bearer_kind w auth
    |? is_client w r auth ?> "client" |? is_oauth1 w r auth ?> "oauth1" |: ""

:= map_of (pairs : list (string * term)) : term =
    call "maps" "from_list" [ pairs |> each (\ (k, v) => pair k v) |> erlang_term::list_term ]

:= copied (keys : list string) (u : term) : term = map_of (keys |> each (\ k => (k, field k u)))

:= public (u : term) : term = copied [ "id"; "name"; "username" ] u

:= missing_detail (handle : string) : string = "Could not find user with usernames: [" ++# handle ++# "]."

:= problem_kind () : term = str "https://api.x.com/2/problems/resource-not-found"

:= missing_about (handle : string) : list (string * term) =
    [ ("value", str handle); ("detail", str (missing_detail handle)); ("title", str "Not Found Error") ]

:~ not_found (handle : string) : term =
    := resource = [ ("resource_type", str "user"); ("parameter", str "usernames"); ("type", problem_kind ()) ]
    map_of (listm::append (missing_about handle) resource)

:= known (h : string) (w : api_world) : bool = dictm::has (sm'::to_lower h) w::by_handle

:= user_of (h : string) (w : api_world) : term = dictm::present (sm'::to_lower h) w::by_handle |> public

:= listed_field (key : string) (items : list term) : list (string * term) =
    ?= items ?| Nil => Nil | _ => [ (key, erlang_term::list_term items) ]

:= found_users (w : api_world) (handles : list string) : list term =
    handles |> keep (\ h => known h w) |> each (\ h => user_of h w)

:= missing_users (w : api_world) (handles : list string) : list term =
    handles |> keep (\ h => not (known h w)) |> each not_found

:~ users_by (w : api_world) (query : string) : term =
    := handles = listed "usernames" query
    := errors = listed_field "errors" (missing_users w handles)
    map_of (listm::append (listed_field "data" (found_users w handles)) errors)

:~ users_by_ids (w : api_world) (query : string) : term =
    := ids = listed "ids" query |> keep (\ i => dictm::has i w::by_id)
    map_of [ ("data", ids |> each (\ i => dictm::present i w::by_id |> public) |> erlang_term::list_term) ]

:= problem (status : i32) (title : string) (detail : string) : term =
    := words = [ ("title", str title); ("detail", str detail) ]
    map_of (listm::append words [ ("type", str "about:blank"); ("status", int status) ])

:= unauthorized () : term = problem 401i32 "Unauthorized" "Unauthorized"

:= query_first (name : string) (fallback : string) (query : string) : string =
    := v = first_value name (pieces "&" query)
    ? v = "" ?> fallback |: v

:= in_range (low : i32) (high : i32) (s : string) : bool =
    ?= count_of_text s ?| Some n => n >= low && n <= high | None => !-

:~ ^ sliced (start : i32) (count : i32) (l : list term) : list term =
    ?= l ?|
    | x :: rest ?& start > 0i32 => sliced (start - 1i32) count rest
    | x :: rest ?& count > 0i32 => x :: sliced 0i32 (count - 1i32) rest
    | _ => Nil

:~ followed (w : api_world) (u : term) : list term =
    := ids = terms_of (items_at "following" u) |> each id_text |> keep (\ i => dictm::has i w::by_id)
    ids |> each (\ i => dictm::present i w::by_id)

:= following_meta (shown : i32) (next : i32) (more : bool) : term =
    := token = ? more ?> [ ("next_token", str ("p" ++# sm'::obj_to_string next)) ] |: Nil
    map_of (("result_count", int shown) :: token)

:= page_body (page : list term) (meta : term) : term =
    map_of (listm::append (listed_field "data" (page |> each public)) [ ("meta", meta) ])

:~ following_body (w : api_world) (u : term) (start : i32) (count : i32) : term =
    := all = followed w u
    := page = sliced start count all
    page_body page (following_meta (listm::length page) (start + count) (start + count < listm::length all))

:= page_start (token : string) : i32 = count_or_zero (sm'::substring 1i32 (sm'::length token - 1i32) token)

:= bad_size (size : string) : i32 * term =
    400i32, problem 400i32 "Invalid Request" ("max_results must be 1..1000, got " ++# size)

:= page_count (w : api_world) (size : string) : i32 =
    := asked = count_or_zero size
    ? asked < w::page_size ?> asked |: w::page_size

:= page_asked (query : string) : i32 = page_start (query_first "pagination_token" "p0" query)

:~ following (w : api_world) (u : term) (query : string) : i32 * term =
    := size = query_first "max_results" "100" query
    ? in_range 1i32 1000i32 size ?> (200i32, following_body w u (page_asked query) (page_count w size)) |: bad_size size

:= encoded (t : term) : string = call "erlang" "iolist_to_binary" [ call "json" "encode" [ t ] ] |> text

:= client_reasons () : list (i32 * string) =
    [ (200i32, "OK"); (201i32, "Created"); (400i32, "Bad Request"); (401i32, "Unauthorized");
        (402i32, "Payment Required"); (403i32, "Forbidden"); (404i32, "Not Found") ]

:= server_reasons () : list (i32 * string) =
    [ (422i32, "Unprocessable Entity"); (429i32, "Too Many Requests"); (500i32, "Internal Server Error");
        (502i32, "Bad Gateway"); (503i32, "Service Unavailable") ]

:= reasons () : list (i32 * string) = listm::append (client_reasons ()) (server_reasons ())

:= reason (status : i32) : string =
    ?= reasons () |> keep (\ (s, _) => s = status) ?| (_, r) :: _ => r | Nil => "Status"

:= status_line (status : i32) : string = "HTTP/1.1 " ++# sm'::obj_to_string status ++# " " ++# reason status

:= headers_text (body : string) : string =
    := length = "\r\nContent-Length: " ++# sm'::obj_to_string (byte_count body)
    "\r\nContent-Type: application/json; charset=utf-8" ++# length ++# "\r\nConnection: close\r\n\r\n"

:= response_text (status : i32) (body : string) : string = status_line status ++# headers_text body ++# body

:= asked_fields (r : request) : list (string * term) =
    [ ("method", str r::method); ("path", str r::path); ("query", str r::query) ]

:= body_of (r : request) : string =
    := start = head_end r::raw + 4i32
    sm'::substring start (sm'::length r::raw - start) r::raw

:= context_of (kind : string) : term = ? kind = "" ?> atom "null" |: str kind

:~ log_row (r : request) (kind : string) : term =
    := body = gated (r::method = "POST") [ ("body", str (body_of r)) ]
    := auth = [ ("authorized", erlang_term::of (kind <> "")); ("context", context_of kind) ]
    map_of (listm::concat [ asked_fields r; auth; body ])

:~ logged (log : string) (r : request) (kind : string) : () =
    := line = str (encoded (log_row r kind) ++# "\n")
    call "file" "write_file" [ str log; line; erlang_term::list_term [ atom "append" ] ] |> ignore

:| api_route =
    | UsersBy
    | UsersByIds
    | Following : term
    | Timeline : term
    | Lookup
    | Single : string
    | SearchRecent
    | SearchAll
    | Elsewhere

:= user_route (w : api_world) (id : string) (rest : string) : api_route =
    ? not (dictm::has id w::by_id) ?> Elsewhere
    |? rest = "following" ?> Following (dictm::present id w::by_id)
    |? rest = "tweets" ?> Timeline (dictm::present id w::by_id) |: Elsewhere

:= users_route (w : api_world) (parts : list string) : api_route =
    ?= parts ?| "by" :: Nil => UsersBy | Nil => UsersByIds | id :: rest :: Nil => user_route w id rest | _ => Elsewhere

:= search_route (kind : string) : api_route =
    ? kind = "recent" ?> SearchRecent |? kind = "all" ?> SearchAll |: Elsewhere

:= tweets_route (parts : list string) : api_route =
    ?= parts ?| Nil => Lookup | id :: Nil => Single id | "search" :: kind :: Nil => search_route kind | _ => Elsewhere

:~ route_of (w : api_world) (path : string) : api_route =
    ?= pieces "/" path ?|
    | "" :: "2" :: "users" :: parts => users_route w parts
    | "" :: "2" :: "tweets" :: parts => tweets_route parts
    | _ => Elsewhere

:= post_route (route : api_route) : bool =
    ?= route ?| Timeline _ => !+ | Lookup => !+ | Single _ => !+ | SearchRecent => !+ | SearchAll => !+ | _ => !-

:= served_here (w : api_world) (r : request) : bool =
    := route = route_of w r::path
    r::method <> "GET" || ((?= route ?| Elsewhere => !- | _ => !+) && not (w::stale && post_route route))

:= json_reply (status : i32) (body : term) : string = response_text status (encoded body)

:= has_key (key : string) (m : term) : bool = truth (call "maps" "is_key" [ str key; m ])

:= field_or (key : string) (fallback : term) (m : term) : term = call "maps" "get" [ str key; m; fallback ]

:= escaped (s : string) : string = s |> sm'::replace "&" "&amp;" |> sm'::replace "<" "&lt;" |> sm'::replace ">" "&gt;"

:= asked (fields : list string) (name : string) : bool = has (\ f => f = name) fields

:= nonempty (key : string) (p : term) : bool = ?= terms_of (items_at key p) ?| Nil => !- | _ => !+

:= metric_names () : list string =
    [ "bookmark_count"; "impression_count"; "like_count"; "quote_count"; "reply_count"; "repost_count" ]

:= metrics_of (p : term) : term =
    := counts = field_or "metrics" (map_of Nil) p
    map_of (metric_names () |> each (\ k => (k, field_or k (int 0i32) counts)))

:= history_of (p : term) : term = field_or "edit_history" (erlang_term::list_term [ field "id" p ]) p

:= base_pairs (p : term) : list (string * term) =
    [ ("id", field "id" p); ("text", str (escaped (text (field "text" p)))); ("edit_history_post_ids", history_of p) ]

:= media_keys (p : term) : term = terms_of (items_at "media" p) |> each (field "media_key") |> erlang_term::list_term

:= conversation (p : term) : term = field_or "conversation_id" (field "id" p) p

:= field_pair (fields : list string) (name : string) (value : term) : list (string * term) =
    gated (asked fields name) [ (name, value) ]

:~ simple_pairs (p : term) (fields : list string) : list (string * term) =
    := pick = field_pair fields
    := made = pick "created_at" (field "created_at" p)
    listm::concat [ pick "conversation_id" (conversation p); made; pick "author_id" (field "author_id" p) ]

:= urls_pair (p : term) : list (string * term) = [ ("entities", map_of [ ("urls", items_at "urls" p) ]) ]

:= media_pair (p : term) : list (string * term) = [ ("attachments", map_of [ ("media_keys", media_keys p) ]) ]

:= present_pair (fields : list string) (name : string) (key : string) (p : term) : bool =
    asked fields name && nonempty key p

:~ counted_pairs (p : term) (fields : list string) : list (string * term) =
    := refs = gated (present_pair fields "referenced_posts" "refs" p) [ ("referenced_posts", items_at "refs" p) ]
    listm::append (field_pair fields "public_metrics" (metrics_of p)) refs

:~ nested_pairs (p : term) (fields : list string) : list (string * term) =
    := urls = gated (present_pair fields "entities" "urls" p) (urls_pair p)
    listm::concat [ counted_pairs p fields; urls; gated (present_pair fields "attachments" "media" p) (media_pair p) ]

:~ rendered (p : term) (fields : list string) : term =
    map_of (listm::concat [ base_pairs p; simple_pairs p fields; nested_pairs p fields ])

:~ ^ deduped (seen : dictm::dict string ()) (items : list (string * term)) : list term =
    ?= items ?|
    | (k, v) :: rest ?& dictm::has k seen => deduped seen rest
    | (k, v) :: rest => v :: deduped (dictm::insert k () seen) rest
    | Nil => Nil

:= unique (items : list (string * term)) : list term = deduped (dictm::empty ()) items

:== expansion_ask = { fields : list string; expansions : list string; media_fields : list string }

:= ask_of (query : string) : expansion_ask =
    := media_fields = listed "media.fields" query
    { fields = listed "post.fields" query; expansions = listed "expansions" query; media_fields }

:= post_of (w : api_world) (i : string) : term = dictm::present i w::by_post

:= posts_of (w : api_world) (ids : list string) : list term =
    ids |> keep (\ i => dictm::has i w::by_post) |> each (post_of w)

:= ref_targets (w : api_world) (p : term) : list term = terms_of (items_at "refs" p) |> each post_key |> posts_of w

:= expands_refs (a : expansion_ask) (p : term) : bool = asked a::expansions "referenced_posts" && nonempty "refs" p

:~ data_item (a : expansion_ask) (p : term) : term =
    := item = rendered p a::fields
    ? expands_refs a p ?> call "maps" "put" [ str "referenced_posts"; items_at "refs" p; item ] |: item

:= targets_of (w : api_world) (a : expansion_ask) (posts : list term) : list term =
    posts |> keep (expands_refs a) |> each (ref_targets w) |> listm::concat

:= author_entry (t : term) : string * term = id_text (field "author_id" t), map_of [ ("id", field "author_id" t) ]

:~ included_authors (w : api_world) (a : expansion_ask) (posts : list term) : list (string * term) =
    ? asked a::expansions "referenced_posts.author_id" ?> targets_of w a posts |> each author_entry |: Nil

:= wanted_key (a : expansion_ask) (k : string) : bool = k = "media_key" || asked a::media_fields k

:= kept_media (a : expansion_ask) (m : term) : term =
    := keys = call "maps" "keys" [ m ] |> terms_of |> each text |> keep (wanted_key a)
    map_of (keys |> each (\ k => (k, field k m)))

:= media_entries (a : expansion_ask) (p : term) : list (string * term) =
    terms_of (items_at "media" p) |> each (\ m => (text (field "media_key" m), kept_media a m))

:~ included_media (a : expansion_ask) (posts : list term) : list (string * term) =
    ? asked a::expansions "attachments.media_keys" ?> posts |> each (media_entries a) |> listm::concat |: Nil

:= shown_targets (w : api_world) (a : expansion_ask) (posts : list term) : list term =
    targets_of w a posts |> each (\ t => (post_key t, rendered t a::fields)) |> unique

:= media_listed (a : expansion_ask) (posts : list term) : list (string * term) =
    listed_field "media" (unique (included_media a posts))

:~ includes_pairs (w : api_world) (a : expansion_ask) (posts : list term) : list (string * term) =
    := users = listed_field "users" (unique (included_authors w a posts))
    listm::concat [ listed_field "posts" (shown_targets w a posts); users; media_listed a posts ]

:~ expanded (w : api_world) (a : expansion_ask) (posts : list term) : list (string * term) =
    := includes = ?= includes_pairs w a posts ?| Nil => Nil | pairs => [ ("includes", map_of pairs) ]
    listm::append (listed_field "data" (each (data_item a) posts)) includes

:= not_found_post (detail : string) (id : string) : list (string * term) =
    [ ("value", str id); ("detail", str (detail ++# id ++# "].")); ("title", str "Not Found Error") ]

:= post_missing (id : string) : term = map_of (not_found_post "Could not find post with ids: [" id)

:= missing_posts (w : api_world) (ids : list string) : list (string * term) =
    ids |> keep (\ i => not (dictm::has i w::by_post)) |> each post_missing |> listed_field "errors"

:~ lookup (w : api_world) (query : string) : term =
    := ids = listed "ids" query
    map_of (listm::append (expanded w (ask_of query) (posts_of w ids)) (missing_posts w ids))

:= single_missing (id : string) : term =
    := about = not_found_post "Could not find post with id: [" id
    := entry = map_of (listm::append about [ ("resource_type", str "post"); ("parameter", str "id") ])
    map_of [ ("errors", erlang_term::list_term [ entry ]) ]

:~ single (w : api_world) (id : string) (query : string) : term =
    := found = \ () => map_of [ ("data", rendered (post_of w id) (listed "post.fields" query)) ]
    ? dictm::has id w::by_post ?> found () |: single_missing id

:= stamp (p : term) : string = cut 0i32 19i32 (text (field "created_at" p))

:= not_before (a : string) (b : string) : bool = truth (call "erlang" ">=" [ str a; str b ])

:~ ^ inserted (p : term) (sorted : list term) : list term =
    ?= sorted ?|
    | x :: rest ?& not_before (stamp x) (stamp p) => x :: inserted p rest
    | _ => p :: sorted

:= newest_first (posts : list term) : list term = posts |> listm::fold (\ acc p => inserted p acc) Nil

:= ref_kinds (p : term) : list string = terms_of (items_at "refs" p) |> each (\ r => text (field "type" r))

:= drops (excluded : list string) (word : string) (kind : string) (p : term) : bool =
    asked excluded word && asked (ref_kinds p) kind

:= excluded_by (excluded : list string) (p : term) : bool =
    drops excluded "replies" "replied_to" p || drops excluded "retweets" "reposted" p

:= after_start (since : string) (p : term) : bool = since = "" || not_before (stamp p) (cut 0i32 19i32 since)

:= before_end (until : string) (p : term) : bool = until = "" || not (not_before (stamp p) (cut 0i32 19i32 until))

:= windowed (query : string) (posts : list term) : list term =
    := started = posts |> keep (after_start (query_first "start_time" "" query))
    started |> keep (before_end (query_first "end_time" "" query))

:= user_posts (w : api_world) (u : term) : list term = terms_of (items_at "posts" u) |> each post_key |> posts_of w

:~ timeline_posts (w : api_world) (u : term) (query : string) : list term =
    := excluded = listed "exclude" query
    user_posts w u |> keep (\ p => not (excluded_by excluded p)) |> windowed query

:= count_meta (n : i32) : list (string * term) = [ ("meta", map_of [ ("result_count", int n) ]) ]

:~ timeline_body (w : api_world) (u : term) (query : string) (size : i32) : term =
    := newest = sliced 0i32 size (newest_first (timeline_posts w u query))
    map_of (listm::append (expanded w (ask_of query) newest) (count_meta (listm::length newest)))

:= protected_detail (u : term) : string =
    "Sorry, you are not authorized to see the posts of @" ++# text (field "username" u) ++# "."

:= protected_entry (u : term) : term =
    := kind = str "https://api.x.com/2/problems/not-authorized-for-resource"
    map_of [ ("title", str "Authorization Error"); ("detail", str (protected_detail u)); ("type", kind) ]

:= protected_body (u : term) : term = map_of [ ("errors", erlang_term::list_term [ protected_entry u ]) ]

:= status_of (key : string) (u : term) : i32 = call "maps" "get" [ str key; u ] |> erlang_term::cast

:= user_problem (u : term) : term =
    problem (status_of "status" u) (text (field "problem_title" u)) (text (field "problem_detail" u))

:= bad_timeline_size (size : string) : string =
    json_reply 400i32 (problem 400i32 "Invalid Request" ("max_results must be 5..100, got " ++# size))

:= is_protected (u : term) : bool = truth (field_or "protected" (erlang_term::of !-) u)

:= plain_fault (u : term) : string = response_text (status_of "plain_status" u) (text (field "plain_body" u))

:~ timeline_fault (u : term) : option string =
    ? has_key "plain_status" u ?> Some (plain_fault u)
    |? has_key "status" u ?> Some (json_reply (status_of "status" u) (user_problem u))
    |? is_protected u ?> Some (json_reply 200i32 (protected_body u)) |: None

:~ timeline_reply (w : api_world) (u : term) (query : string) (size : string) : string =
    := body = \ () => json_reply 200i32 (timeline_body w u query (count_or_zero size))
    ?= timeline_fault u ?| Some reply => reply | None => body ()

:~ timeline (w : api_world) (u : term) (query : string) : string =
    := size = query_first "max_results" "10" query
    ? in_range 5i32 100i32 size ?> timeline_reply w u query size |: bad_timeline_size size

:= seconds_of (stamp : string) : term = call "calendar" "rfc3339_to_system_time" [ erlang_term::charlist stamp ]

:= zulu () : term = erlang_term::list_term [ pair "offset" (erlang_term::charlist "Z") ]

:= rfc3339_of (seconds : term) : string =
    call "unicode" "characters_to_binary" [ call "calendar" "system_time_to_rfc3339" [ seconds; zulu () ] ] |> text

:~ window_start (w : api_world) (days : i32) : string =
    cut 0i32 19i32 (rfc3339_of (call "erlang" "-" [ seconds_of w::now; int (days * 86400i32) ]))

:= oldest_of (w : api_world) (days : i32) (all : bool) (query : string) : string =
    := oldest = window_start w days
    := since = cut 0i32 19i32 (query_first "start_time" "" query)
    ? since <> "" && (all || not (not_before oldest since)) ?> since |: oldest

:= spaced (q : string) : string = q |> sm'::replace "\t" " " |> sm'::replace "\r" " " |> sm'::replace "\n" " "

:= with_term (d : dictm::dict string string) (token : string) : dictm::dict string string =
    split_once ":" token |> \ (k, v) => dictm::insert k v d

:~ search_terms (query : string) : dictm::dict string string =
    := tokens = pieces " " (spaced (query_first "query" "" query)) |> keep (\ s => sm'::index_of ":" s >= 0)
    tokens |> listm::fold with_term (dictm::empty ())

:= term_or (key : string) (terms : dictm::dict string string) : string =
    ? dictm::has key terms ?> dictm::present key terms |: ""

:= author_id_of (w : api_world) (author : string) : string =
    ? known author w ?> post_key (dictm::present (sm'::to_lower author) w::by_handle) |: author

:== search_ask = { conversation : string; author : string; oldest : string }

:= matches (s : search_ask) (p : term) : bool =
    := mine = s::author = "" || id_text (field "author_id" p) = s::author
    id_text (conversation p) = s::conversation && mine && not_before (stamp p) s::oldest

:= zero_padded (digits : string) : string =
    := padded = call "string" "pad" [ str digits; int 10i32; atom "leading"; int 48i32 ]
    call "erlang" "iolist_to_binary" [ padded ] |> text

:= id_order (p : term) : string =
    := id = post_key p
    zero_padded (sm'::obj_to_string (sm'::length id : i32)) ++# "|" ++# id

:~ ^ by_id_desc (p : term) (sorted : list term) : list term =
    ?= sorted ?|
    | x :: rest ?& not_before (id_order x) (id_order p) => x :: by_id_desc p rest
    | _ => p :: sorted

:~ found_posts (w : api_world) (s : search_ask) : list term =
    := all = w::by_post |> dictm::fold (\ acc _ p => p :: acc) Nil
    all |> keep (matches s) |> listm::fold (\ acc p => by_id_desc p acc) Nil

:= edge_meta (page : list term) : list (string * term) =
    ?= page ?|
    | first :: _ => [ ("newest_id", field "id" first); ("oldest_id", field "id" (listm::fold (\ _ x => x) first page)) ]
    | Nil => Nil

:~ search_meta (page : list term) (next : i32) (more : bool) : term =
    := token = gated more [ ("next_token", str (sm'::obj_to_string next)) ]
    map_of (listm::concat [ [ ("result_count", int (listm::length page)) ]; edge_meta page; token ])

:= search_data (page : list term) (query : string) : list (string * term) =
    listed_field "data" (page |> each (\ p => rendered p (listed "post.fields" query)))

:= meta_after (page : list term) (next : i32) (found : list term) : list (string * term) =
    [ ("meta", search_meta page next (next < listm::length found)) ]

:= page_window (query : string) : i32 * i32 =
    count_or_zero (query_first "next_token" "0" query), count_or_zero (query_first "max_results" "10" query)

:~ search_body (found : list term) (query : string) : term =
    := start, size = page_window query
    := page = sliced start size found
    map_of (listm::append (search_data page query) (meta_after page (start + size) found))

:= author_of (w : api_world) (terms : dictm::dict string string) : string = author_id_of w (term_or "from" terms)

:= search_ask_of (w : api_world) (all : bool) (query : string) : search_ask =
    := terms = search_terms query
    := oldest = oldest_of w (? all ?> 30i32 |: 7i32) all query
    { conversation = term_or "conversation_id" terms; author = author_of w terms; oldest }

:~ search (w : api_world) (all : bool) (query : string) : term =
    := ask = search_ask_of w all query
    ? ask::conversation = "" ?> search_body Nil query |: search_body (found_posts w ask) query

:~ users_reply (w : api_world) (r : request) : string =
    json_reply 200i32 (? r::path = "/2/users/by" ?> users_by w r::query |: users_by_ids w r::query)

:= ok_json (body : term) : string = json_reply 200i32 body

:= search_all (route : api_route) : bool = ?= route ?| SearchAll => !+ | _ => !-

:~ post_reply (w : api_world) (r : request) (route : api_route) : string =
    ?= route ?|
    | Single id => single w id r::query |> ok_json
    | Lookup => lookup w r::query |> ok_json
    | _ => search w (search_all route) r::query |> ok_json

:= following_reply (w : api_world) (u : term) (r : request) : string =
    following w u r::query |> \ (status, body) => json_reply status body

:~ other_reply (w : api_world) (r : request) (route : api_route) : string =
    ?= route ?| UsersBy => users_reply w r | UsersByIds => users_reply w r | _ => post_reply w r route

:~ routed (w : api_world) (r : request) : string =
    ?= route_of w r::path ?|
    | Following u => following_reply w u r
    | Timeline u => timeline w u r::query
    | route => other_reply w r route

:~ answer (w : api_world) (r : request) (kind : string) : string =
    ? kind = "" ?> json_reply 401i32 (unauthorized ()) |: routed w r

:= unsupported_detail () : string =
    "Authenticating with OAuth 2.0 Application-Only is forbidden for this endpoint.  "
    ++# "Supported authentication types are [OAuth 1.0a User Context, OAuth 2.0 User Context]."

:= unsupported_kind () : term = str "https://api.x.com/2/problems/unsupported-authentication"

:= user_context_only () : term =
    := about = [ ("title", str "Unsupported Authentication"); ("detail", str (unsupported_detail ())) ]
    map_of (listm::append about [ ("type", unsupported_kind ()); ("status", int 403i32) ])

:= renewal_error () : term =
    map_of [ ("error", str "invalid_request"); ("error_description", str "Value passed for the token was invalid.") ]

:= token_head (access : string) : list (string * term) =
    [ ("token_type", str "bearer"); ("expires_in", int 7200i32); ("access_token", str access) ]

:= renewed_body (access : string) (refresh : string) : term =
    := tail = [ ("scope", str "tweet.read tweet.write users.read offline.access"); ("refresh_token", str refresh) ]
    map_of (listm::append (token_head access) tail)

:= last_issued (w : api_world) : string = ?= w::issued ?| t :: _ => t | Nil => ""

:= renewal_ok (w : api_world) (form : string) : bool =
    query_first "grant_type" "" form = "refresh_token" && query_first "refresh_token" "" form = last_issued w

:= turned (key : string) (w : api_world) : string =
    text (field key (field "oauth2" w::raw)) ++# "-" ++# sm'::obj_to_string (listm::length w::issued : i32)

:~ issued_next (w : api_world) : string * api_world =
    := refresh = turned "refresh_token" w
    json_reply 200i32 (renewed_body (turned "access_token" w) refresh), { w ?| issued = refresh :: w::issued }

:~ renewed (w : api_world) (r : request) : string * api_world =
    ? renewal_ok w (body_of r) ?> issued_next w |: (json_reply 400i32 (renewal_error ()), w)

:= no_route (path : string) : term = problem 404i32 "Not Found Error" ("no route " ++# path)

:= kept (w : api_world) (status : i32) (body : term) : string * api_world = json_reply status body, w

:~ token_reply (w : api_world) (r : request) (kind : string) : string * api_world =
    ? kind = "" ?> kept w 401i32 (unauthorized ())
    |? kind = "client" ?> renewed w r
    |? kind = "app" ?> kept w 403i32 (user_context_only ()) |: kept w 404i32 (no_route r::path)

:= empty_map () : term = call "maps" "new" []

:= json_body (r : request) : term = ? body_of r = "" ?> empty_map () |: call "json" "decode" [ str (body_of r) ]

:= trimmed_end (s : string) : string = call "string" "trim" [ str s; atom "trailing" ] |> text

:= sent_text (b : term) : string = trimmed_end (text (field_or "text" (str "") b))

:= sent_parent (b : term) : string =
    := reply = field_or "reply" (empty_map ()) b
    ? has_key "in_reply_to_tweet_id" reply ?> id_text (field "in_reply_to_tweet_id" reply) |: ""

:= stamp_after (w : api_world) (n : i32) : string =
    cut 0i32 19i32 (rfc3339_of (call "erlang" "+" [ seconds_of w::now; int n ])) ++# ".000Z"

:= replied_ref (parent : string) : term = map_of [ ("type", str "replied_to"); ("id", str parent) ]

:= reply_refs (parent : string) : term = erlang_term::list_term (? parent = "" ?> Nil |: [ replied_ref parent ])

:= conversation_for (w : api_world) (id : string) (parent : string) : term =
    ? parent = "" ?> str id |: field_or "conversation_id" (str parent) (post_of w parent)

:= created_head (w : api_world) (id : string) (t : string) : list (string * term) =
    := made = str (stamp_after w (dictm::size w::writes::created))
    [ ("id", str id); ("text", str t); ("author_id", w::writes::me); ("created_at", made) ]

:~ created_post (w : api_world) (id : string) (t : string) (parent : string) : term =
    := tail = [ ("conversation_id", conversation_for w id parent); ("refs", reply_refs parent) ]
    map_of (listm::append (created_head w id t) tail)

:= history_one (id : string) : term = erlang_term::list_term [ str id ]

:= created_body (id : string) (t : string) : term =
    map_of [ ("data", map_of [ ("id", str id); ("text", str (escaped t)); ("edit_history_post_ids", history_one id) ]) ]

:= counted (w : api_world) (id : string) : api_world =
    := ws = w::writes
    { w ?| writes = writes_of ws::me (dictm::insert id () ws::created) (ws::next_id + 1i32) }

:= with_created (w : api_world) (id : string) (t : string) (parent : string) : api_world =
    := w' = counted w id
    { w' ?| by_post = dictm::insert id (created_post w' id t parent) w'::by_post }

:~ posted (w : api_world) (t : string) (parent : string) : string * api_world =
    := id = sm'::obj_to_string w::writes::next_id
    json_reply 201i32 (created_body id t), with_created w id t parent

:= bad_text () : term = problem 400i32 "Invalid Request" "text must be 1 to 280 characters"

:= bad_parent (parent : string) : term =
    problem 400i32 "Invalid Request" ("in_reply_to_tweet_id " ++# parent ++# " does not exist")

:= orphan (w : api_world) (parent : string) : bool = parent <> "" && not (dictm::has parent w::by_post)

:= too_heavy (t : string) : bool = t = "" || splitter::x_weight t > 280i32

:~ new_post (w : api_world) (r : request) : string * api_world =
    := b = json_body r
    := t, parent = sent_text b, sent_parent b
    ? too_heavy t ?> kept w 400i32 (bad_text ())
    |? orphan w parent ?> kept w 400i32 (bad_parent parent) |: posted w t parent

:= deleted_body () : term = map_of [ ("data", map_of [ ("deleted", erlang_term::of !+) ]) ]

:= missing_created (id : string) : term =
    problem 404i32 "Not Found Error" ("Could not find post with id: [" ++# id ++# "].")

:= dropped (w : api_world) (id : string) : api_world =
    := writes = writes_of w::writes::me (dictm::remove id w::writes::created) w::writes::next_id
    { w ?| writes = writes; by_post = dictm::remove id w::by_post }

:~ removed (w : api_world) (id : string) : string * api_world =
    := deleted = \ () => (json_reply 200i32 (deleted_body ()), dropped w id)
    ? dictm::has id w::writes::created ?> deleted () |: kept w 404i32 (missing_created id)

:= delete_target (r : request) : option string =
    ?= pieces "/" r::path ?| "" :: "2" :: "tweets" :: id :: Nil ?& r::method = "DELETE" => Some id | _ => None

:= user_kind (kind : string) : bool = kind = "user" || kind = "oauth1"

:~ post_or_delete (w : api_world) (r : request) : string * api_world =
    ? r::method = "POST" && r::path = "/2/tweets" ?> new_post w r
    |: ?= delete_target r ?| Some id => removed w id | None => kept w 404i32 (no_route r::path)

:~ write_reply (w : api_world) (r : request) (kind : string) : string * api_world =
    ? not (user_kind kind) ?> kept w 403i32 (user_context_only ())
    |: post_or_delete w r

:~ change_reply (w : api_world) (r : request) (kind : string) : string * api_world =
    ? kind = "" ?> kept w 401i32 (unauthorized ())
    |? r::method = "POST" && kind = "client" ?> renewed w r |: write_reply w r kind

:~ relayed (opened : term) (raw : string) : string =
    tcp "send" [ second opened; str raw ] |> ignore
    drained (second opened) ""

:~ forwarded (stub_port : i32) (raw : string) : string =
    := opened = tcp "connect" [ loopback (); int stub_port; erlang_term::list_term (raw_options ()) ]
    ? is_ok opened ?> relayed opened raw |: ""

:= noted (r : request) : () =
    := line = str ("xsim serve / answered " ++# r::method ++# " " ++# r::path ++# "\n")
    call "io" "put_chars" [ atom "standard_error"; line ] |> ignore

:~ own_reply (w : api_world) (log : string) (r : request) (kind : string) : string * api_world =
    logged log r kind
    noted r
    ? r::method = "GET" ?> (answer w r kind, w) |: change_reply w r kind

:= after_forward (w : api_world) (r : request) : api_world = { w ?| stale = w::stale || r::method <> "GET" }

:= relay_here (w : api_world) (r : request) (kind : string) : bool = not (served_here w r)

:~ replied (w : api_world) (log : string) (stub_port : i32) (raw : string) : string * api_world =
    := r = request_of raw
    := kind = auth_kind w r
    ? relay_here w r kind ?> (forwarded stub_port raw, after_forward w r) |: own_reply w log r kind

:~ handled (w : api_world) (log : string) (stub_port : i32) (sock : term) : api_world =
    := reply, next = replied w log stub_port (received sock "")
    tcp "send" [ sock; str reply ] |> ignore
    tcp "close" [ sock ] |> ignore
    next

:~ ^ served (w : api_world) (log : string) (stub_port : i32) (listener : term) : i32 =
    := accepted = tcp "accept" [ listener ]
    ? not (is_ok accepted) ?> 1i32
    |:
        served (handled w log stub_port (second accepted)) log stub_port listener

:= port_text (listener : term) : string = sm'::obj_to_string (port_of listener)

:~ listening (world_path : string) (port_file : string) (log : string) (stub : string) : i32 =
    := listener = listened ()
    file_system::write_all_text port_file (port_text listener)
    served (world_of world_path) log (count_or_zero stub) listener

:~ started (world_path : string) (port_file : string) (log : string) (stub : string) : i32 =
    ? oauth1_self_test () ?> listening world_path port_file log stub |: 3i32

:= serve (args : list string) : i32 =
    ?= args ?|
    | world_path :: port_file :: log :: stub :: _ => started world_path port_file log stub
    | _ => 2i32
