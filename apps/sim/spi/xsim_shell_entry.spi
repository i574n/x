///- --package .
///> gleam
test xsim_shell_entry static =
    :< testing

:< sm'_operators
:< prelude
:< events
:< inbox
:< scheduler
:< executors
:< runner_shell

:== shell_run = {stream_path : string; limit : i32}

:= shell_usage () : string = "usage: xsim-shell --replay STREAM [--max-concurrency N]"

:= capped_run (path : string) (n : string) : result shell_run string =
    ?= count_of_text n ?|
    | Some limit => Ok {stream_path = path; limit}
    | None => Error ("--max-concurrency takes a whole number, got '" ++# n ++# "'")

:= replay_rest (path : string) (rest : list string) : result shell_run string =
    ?= rest ?|
    | Nil => Ok {stream_path = path; limit = 4i32}
    | cap :: n :: Nil ?& cap = "--max-concurrency" => capped_run path n
    | _ => Error (shell_usage ())

:= shell_run_of (args : list string) : result shell_run string =
    ?= args ?|
    | flag :: path :: rest ?& flag = "--replay" => replay_rest path rest
    | _ => Error (shell_usage ())

:= limited_faults (limit : i32) : fault_set =
    := f = plain_faults ()
    {f ?| limit = limit}

:= settled_in_shell (limit : i32) (deliveries : list delivery) : result scheduler string =
    ?= shell_started (limited_faults limit) (fake_executor ()) ?|
    | Some inbox => Ok (shell_settled inbox deliveries)
    | None => Error "the runner shell did not start"

:= replayed (limit : i32) (text : string) : result scheduler string =
    ?= decoded_stream text ?|
    | Error why => Error why
    | Ok deliveries => settled_in_shell limit deliveries

:= shell_line (s : scheduler) : string =
    := visible = sm'.obj_to_string (dictm.size s.visible_map)
    "XSHELL visible=" ++# visible ++# " results=" ++# sm'.obj_to_string (dictm.size s.task_work.results)

:= reported_settled (s : scheduler) : i32 =
    console.write_line (shell_line s)
    0i32

:= reported_failure (why : string) : i32 =
    console.write_error_line ("xsim-shell: " ++# why)
    1i32

:= replay_reported (r : shell_run) : i32 =
    ?= replayed r.limit (file_system.read_all_text r.stream_path) ?|
    | Ok s => reported_settled s
    | Error why => reported_failure why

:= shell_entry (args : list string) : i32 =
    ?= shell_run_of args ?|
    | Error why =>
        console.write_error_line why
        2i32
    | Ok r => replay_reported r

:= entry_two_posts () : list delivery =
    [
        post_at 0i32 "p0" None "inl a = 1"
        like_at 1i32 "p0" "u"
        post_at 2i32 "p1" (Some "p0") "inl b = 2"
        like_at 3i32 "p1" "v"
    ]

test a_replayed_stream_settles_in_the_shell =
    := ~limit = 1i32
    ?= replayed limit (stream (entry_two_posts ())) ?|
    | Ok s => shell_line s |> sm'.starts_with "XSHELL visible=2 results=" |> _assert_eq !+
    | Error why => failwith why

:= limit_of (r : result shell_run string) : i32 = ?= r ?| Ok run => run.limit | Error _ => 0i32

:= refusal_of (r : result shell_run string) : string = ?= r ?| Ok _ => "" | Error why => why

test shell_arguments_are_checked =
    := ~path = "s.jsonl"
    (limit_of (shell_run_of ["--replay"; path; "--max-concurrency"; "2"]), refusal_of (shell_run_of ["--replay"]))
    |> _assert_eq (2i32, shell_usage ())

:= shell_arguments () : list string =
    :~ ^ from (i : i32) (acc : list string) : list string =
        ? i < 0i32 ?> acc |: from (i - 1i32) (env.command_line_argument i :: acc)
    from (env.command_line_argument_count () - 1i32) Nil

///> _
:= main () : i32 = shell_entry (shell_arguments ())
