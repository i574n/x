///- --package .
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test final_state static =
    :< testing

:< sm'_operators
:< prelude
:< glyphs
:< events

:== cell_state = { post_id : string; parent : option string; revisions : list string; deleted : bool }

:== tally = { post_id : string; users : list string }

:== replay = { cells : list cell_state; tallies : list tally }

:= latest_of (l : list string) : string =
    ?= l ?|
    | s :: _ => s
    | Nil => ""

:= with_cell (r : replay) (post_id : string) (f : cell_state -> cell_state) : replay =
    { r ?| cells = r.cells |> each (\ (c : cell_state) => ? c.post_id = post_id ?> f c |: c) }

:= revised_cell (source : string) (c : cell_state) : cell_state =
    ? latest_of c.revisions = source ?> c |: { c ?| revisions = source :: c.revisions }

:== user_change = list string -> list string

:= retallied (post_id : string) (f : user_change) (t : tally) : tally =
    ? t.post_id = post_id ?> { t ?| users = f t.users } |: t

:= counted_for (post_id : string) (r : replay) : bool = has (\ (t : tally) => t.post_id = post_id) r.tallies

:= tallied (post_id : string) (f : user_change) (r : replay) : replay =
    ? counted_for post_id r ?> { r ?| tallies = r.tallies |> each (retallied post_id f) }
    |: { r ?| tallies = listm.append r.tallies [ { post_id users = f Nil } ] }

:= joined_user (user : string) (l : list string) : list string = ? has ((=) user) l ?> l |: listm.append l [ user ]

:= left_user (user : string) (l : list string) : list string = l |> keep ((<>) user)

:= posted_cell (r : replay) (p : rooted) : replay =
    { r ?|
        cells =
            listm.append r.cells [ { post_id = p.post_id; parent = p.parent; revisions = [ p.source ]; deleted = !- } ]
    }

:= revision_replayed (r : replay) (v : revision) : replay =
    ?= v ?|
    | Edited s => with_cell r s.post_id (revised_cell s.source)
    | Deleted post_id => with_cell r post_id (\ c => { c ?| deleted = !+ })
    | FrameEdited _ => r

:= reaction_replayed (r : replay) (x : reaction) : replay =
    ?= x ?|
    | Liked s => tallied s.post_id (joined_user s.user) r
    | Unliked s => tallied s.post_id (left_user s.user) r

:= replayed (r : replay) (e : event) : replay =
    ?= e ?|
    | Content (Posted p) => posted_cell r p
    | Content (Framed _) => r
    | Revision v => revision_replayed r v
    | Reaction x => reaction_replayed r x

:~ final_replay (l : list event) : replay = l |> listm.fold replayed { cells = Nil; tallies = Nil }

:= opened_levels () : i32 = 4i32

:= indent (level : i32) : string = sm'.replicate (4i32 * level) " "

:== brackets = { opening : string; closing : string }

:= braces () : brackets = { opening = "{"; closing = "}" }

:= square () : brackets = { opening = "["; closing = "]" }

:= opened (items : list string) (b : brackets) (level : i32) : string =
    := inner = "\n" ++# indent (level + 1i32)
    b.opening ++# inner ++# delimited ("," ++# inner) items ++# "\n" ++# indent level ++# b.closing

:~ shared_layout (items : list string) (b : brackets) (level : i32) : string =
    ?= items ?|
    | Nil => b.opening ++# b.closing
    | _ ?& level < opened_levels () => opened items b level
    | _ => b.opening ++# delimited ", " items ++# b.closing

:= laid_out (items : list string) (b : brackets) (level : i32) : string = shared_layout (dyn items) (dyn b) (dyn level)

:= pair (key : string) (value : string) : string = quoted key ++# ": " ++# value

:= cell_json (level : i32) (c : cell_state) : string =
    [
        pair "parent" (parent_of c.parent)
        pair "post" (quoted c.post_id)
        pair "source" (quoted (latest_of c.revisions))
    ]
    |> \ l => laid_out l (braces ()) level

:~ ^ inserted (t : tally) (l : list tally) : list tally =
    ?= l ?|
    | u :: rest ?& comp t.post_id u.post_id |> gt_is => u :: inserted t rest
    | _ => t :: l

:= tallies_json (level : i32) (l : list tally) : string =
    := sorted = l |> listm.fold (\ acc t => inserted t acc) Nil
    laid_out (sorted |> each (\ (t : tally) => pair t.post_id (number (listm.length t.users)))) (braces ()) level

:= live_cells (r : replay) : list cell_state = r.cells |> keep (\ (c : cell_state) => not c.deleted)

:~ final_json (r : replay) : string =
    := cells = laid_out (live_cells r |> each (cell_json 2i32)) (square ()) 1i32
    laid_out [ pair "cells" cells; pair "likes" (tallies_json 1i32 r.tallies) ] (braces ()) 0i32 ++# "\n"

:= liked_twice () : list event =
    [
        Reaction (Liked { post_id = "p1"; user = "u1" })
        Reaction (Liked { post_id = "p1"; user = "u1" })
        Reaction (Unliked { post_id = "p0"; user = "u2" })
    ]

test likes_count_distinct_users_and_unlikes_leave_zero =
    := ~events = liked_twice ()
    final_replay events
    |> final_json
    |> _assert_eq "{\n    \"cells\": [],\n    \"likes\": {\n        \"p0\": 0,\n        \"p1\": 1\n    }\n}\n"

:= edited_twice () : list event =
    [
        Content (Posted { post_id = "p0"; parent = None; source = "a" })
        Revision (Edited { post_id = "p0"; source = "a" })
        Revision (Edited { post_id = "p0"; source = "b" })
    ]

test the_latest_distinct_revision_is_the_source =
    := ~events = edited_twice ()
    final_replay events |> final_json |> sm'.contains "\"source\": \"b\"" |> _assert_eq !+
