///- --package . --timeout 600000
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test world static =
    :< testing

:< sm'_operators
:< prelude
:< glyphs
:< protocol
:< splitter
:< defuse
:< events
:< final_state
:< personas
:< scenario

:== version = { post_id : post_id; clock : i32; text : string }

:== posted_frame =
    {
        original : post_id
        cell : cell_id
        k : i32
        n : i32
        reply_to : option post_id
        versions : list version
    }

:== frame_key = { cell : cell_id; k : i32 }

:== world =
    { ids : i32; clock : i32; frames : list posted_frame; order : list frame_key;
        last_frame : list (cell_id * post_id); root : option post_id; lost : list cell_id; gone : list cell_id }

:== cursor = world * i32

:= empty_world (id_base : i32) : world =
    { ids = id_base; clock = 0i32; frames = Nil; order = Nil; last_frame = Nil; root = None; lost = Nil; gone = Nil }

:== live_cell = { cell : cell_id; parent : option cell_id; revisions : list string }

:== live = list live_cell

:= parent_cell (p : option string) : option cell_id =
    ?= p ?|
    | Some s => Some (cell_id s)
    | None => None

:= live_of (c : cell_state) : live_cell =
    { cell = cell_id c::post_id; parent = parent_cell c::parent; revisions = listm::rev c::revisions }

:= next_id (w : world) : post_id * world =
    post_id (sm'::obj_to_string (w::ids + 1i32)), { w ?| ids = w::ids + 1i32; clock = w::clock + 1i32 }

:= frame_at (w : world) (cell : cell_id) (k : i32) : option posted_frame =
    first_where (\ (f : posted_frame) => same_cell f::cell cell && f::k = k) w::frames

:= original_at (w : world) (cell : cell_id) (k : i32) : option post_id =
    ?= frame_at w cell k ?|
    | Some f => Some f::original
    | None => None

:= second_of (p : option (cell_id * post_id)) : option post_id =
    ?= p ?|
    | Some (_, v) => Some v
    | None => None

:= looked_up (l : list (cell_id * post_id)) (key : option cell_id) : option post_id =
    ?= key ?|
    | Some id => second_of (first_where (\ (k, _) => same_cell k id) l)
    | None => None

:= stored_text (cell : cell_id) (k : i32) (n : i32) (body : string) : string = trimmed_end (header cell k n ++# body)

:= reply_for (w : world) (c : live_cell) (k : i32) : option post_id =
    ? k = 1i32 ?> looked_up w::last_frame c::parent |: original_at w c::cell (k - 1i32)

:= with_last (cell : cell_id) (id : post_id) (w : world) : world =
    { w ?| last_frame = (cell, id) :: (w::last_frame |> keep (\ (k, _) => not (same_cell k cell))) }

:= added_frame (f : posted_frame) (w : world) : world =
    { w ?| frames = listm::append w::frames [ f ]; order = listm::append w::order [ { cell = f::cell; k = f::k } ] }

:= rooted_at (id : post_id) (w : world) : world =
    ?= w::root ?|
    | Some _ => w
    | None => { w ?| root = Some id }

:= first_frame (c : live_cell) (w : world) (k : i32) (n : i32) (v : version) : posted_frame =
    { original = v::post_id; cell = c::cell; k; n; reply_to = reply_for w c k; versions = [ v ] }

:= version_at (w : world) (c : live_cell) (k : i32) (n : i32) (body : string) : world * version =
    := id, w = next_id w
    w, { post_id = id; clock = w::clock; text = stored_text c::cell k n body }

:= posted_part (c : live_cell) (n : i32) (acc : cursor) (body : string) : cursor =
    := w, k = acc
    := w, v = version_at w c k n body
    added_frame (first_frame c w k n v) w |> rooted_at v::post_id |> with_last c::cell v::post_id, k + 1i32

:= first_revision (c : live_cell) : string =
    ?= c::revisions ?|
    | s :: _ => s
    | Nil => ""

:= chunks_for (chunking : cell_chunker) (c : live_cell) (source : string) : list string =
    chunking (cell_text c::cell) (post_limit ()) source

:= posted_cell (chunking : cell_chunker) (w : world) (c : live_cell) : world =
    := chunks = chunks_for chunking c (first_revision c)
    := w, _ = chunks |> listm::fold (posted_part c (listm::length chunks)) (w, 1i32)
    w

:= other_than (cell : cell_id) (k : i32) (f : frame_key) : bool = not (same_cell f::cell cell) || f::k <> k

:= dropped (cell : cell_id) (k : i32) (w : world) : world =
    := frames = w::frames |> keep (\ (f : posted_frame) => not (same_cell f::cell cell) || f::k <> k)
    { w ?| frames = frames; order = w::order |> keep (other_than cell k) }

:= cell_ks (w : world) (cell : cell_id) : list i32 =
    w::frames |> keep (\ (f : posted_frame) => same_cell f::cell cell) |> each \ (f : posted_frame) => f::k

:= versioned (v : version) (n : i32) (f : posted_frame) : posted_frame =
    { f ?| n = n; versions = listm::append f::versions [ v ] }

:= replaced (cell : cell_id) (k : i32) (g : posted_frame -> posted_frame) (w : world) : world =
    { w ?| frames = w::frames |> each (\ (f : posted_frame) => ? same_cell f::cell cell && f::k = k ?> g f |: f) }

:= edited_in (c : live_cell) (k : i32) (n : i32) (v : version) (w : world) : world =
    ?= frame_at w c::cell k ?|
    | Some _ => replaced c::cell k (versioned v n) w
    | None => added_frame (first_frame c w k n v) w

:= edited_part (c : live_cell) (n : i32) (acc : cursor) (body : string) : cursor =
    := w, k = acc
    := w, v = version_at w c k n body
    edited_in c k n v w, k + 1i32

:= trimmed_to (cell : cell_id) (n : i32) (w : world) : world =
    cell_ks w cell |> keep (\ k => k > n) |> listm::fold (\ w k => dropped cell k w) w

:= revised_with (chunking : cell_chunker) (c : live_cell) (w : world) (source : string) : world =
    := chunks = chunks_for chunking c source
    := n = listm::length chunks
    := w, _ = chunks |> listm::fold (edited_part c n) (trimmed_to c::cell n w, 1i32)
    w

:= later_revisions (c : live_cell) : list string =
    ?= c::revisions ?|
    | _ :: later => later
    | Nil => Nil

:= edited_cell (chunking : cell_chunker) (w : world) (c : live_cell) : world =
    later_revisions c |> listm::fold (revised_with chunking c) w

:= tail_cells (cells : live) : live =
    ?= cells ?|
    | _ :: rest => rest
    | Nil => Nil

:= on_step (step : i32) (i : i32) : bool = i >= step - 1i32 && (i - step + 1i32) % step = 0i32

:= every_step \* t. (step : i32) (l : list t) : list t =
    := _, picked =
        l
        |> listm::fold \ ((i, acc) : i32 * list t) (x : t) =>
                i + 1i32, (? on_step step i ?> x :: acc |: acc)
            (0i32, Nil)
    listm::rev picked

:= cell_ids (cells : live) : list cell_id = cells |> each (\ (c : live_cell) => c::cell)

:= split_cell_at (w : world) (id : cell_id) : bool =
    ?= frame_at w id 2i32 ?|
    | Some _ => !+
    | None => !-

:= loss_step (candidates : list cell_id) (count : i32) : i32 =
    := step = listm::length candidates / (count + 1i32)
    ? step < 1i32 ?> 1i32 |: step

:= lost_one (w : world) (id : cell_id) : world =
    := w2 = dropped id 2i32 w
    { w2 ?| lost = listm::append w::lost [ id ] }

:= lose (w : world) (cells : live) (count : i32) : world =
    := candidates = tail_cells cells |> cell_ids |> keep (split_cell_at w)
    ? count <= 0i32
    ?> w
    |: every_step (loss_step candidates count) candidates |> take_first count |> listm::fold lost_one w

:= parent_is (id : cell_id) (c : live_cell) : bool =
    ?= c::parent ?|
    | Some p => same_cell p id
    | None => !-

:= gone_one (w : world) (id : cell_id) : world =
    := w2 = cell_ks w id |> listm::fold (\ w k => dropped id k w) w
    { w2 ?| gone = listm::append w::gone [ id ] }

:= losable (w : world) (cells : live) (id : cell_id) : bool =
    has (parent_is id) cells && not (has (same_cell id) w::lost)

:= lose_cells (w : world) (cells : live) (count : i32) : world =
    ? count <= 0i32
    ?> w
    |:
        tail_cells cells
        |> cell_ids
        |> keep (losable w cells)
        |> take_first count
        |> listm::fold gone_one w

:== losses = { lost : i32; lost_cells : i32 }

:= laid_down (chunking : cell_chunker) (cells : live) (id_base : i32) : world =
    cells |> listm::fold (edited_cell chunking) (cells |> listm::fold (posted_cell chunking) (empty_world id_base))

:~ materialized (chunking : cell_chunker) (cells : live) (id_base : i32) (l : losses) : world =
    lose_cells (lose (laid_down chunking cells id_base) cells l::lost) cells l::lost_cells

:= originals (w : world) : post_ids = w::frames |> each (\ (f : posted_frame) => f::original)

:= gap_of (w : world) (f : posted_frame) : list cell_id =
    ?= f::reply_to ?|
    | Some id ?& f::k = 1i32 && not (has (same_post id) (originals w)) => [ f::cell ]
    | _ => Nil

:= keyed_frame (w : world) (o : frame_key) : list posted_frame =
    ?= frame_at w o::cell o::k ?|
    | Some f => [ f ]
    | None => Nil

:= ordered_frames (w : world) : list posted_frame = w::order |> spread (keyed_frame w)

:~ gaps (w : world) : list cell_id = ordered_frames w |> spread (gap_of w)

:= body_text (text : string) : string =
    := i = sm'::index_of "\n" text
    ? i < 0i32 ?> "" |: rest_from (i + 1i32) text |> restored_text

:= last_text (f : posted_frame) : string = f::versions |> listm::fold (\ _ (v : version) => v::text) ""

:~ ^ by_k (f : posted_frame) (l : list posted_frame) : list posted_frame =
    ?= l ?|
    | g :: rest ?& g::k < f::k => g :: by_k f rest
    | _ => f :: l

:= sort_by_k (l : list posted_frame) : list posted_frame = l |> listm::fold (\ acc f => by_k f acc) Nil

:= rebuilt (w : world) (cell : cell_id) : string =
    w::frames
    |> keep (\ (f : posted_frame) => same_cell f::cell cell)
    |> sort_by_k
    |> each (\ f => body_text (last_text f))
    |> delimited ""

:= kept_in (w : world) (id : cell_id) : bool = not (has (same_cell id) w::lost) && not (has (same_cell id) w::gone)

:~ program (cells : live) (w : world) : string =
    cells
    |> cell_ids
    |> keep (kept_in w)
    |> each (rebuilt w)
    |> delimited "\n\n"

:== moment = { days : i32; seconds : i32 }

:== civil = { y : i32; m : i32; d : i32 }

:= number_in (s : string) (start : i32) (len : i32) : i32 =
    ?= count_of_text (cut start len s) ?|
    | Some n => n
    | None => 0i32

:= day_of_year (m : i32) (d : i32) : i32 = (153i32 * (? m > 2i32 ?> m - 3i32 |: m + 9i32) + 2i32) / 5i32 + d - 1i32

:= days_from_civil (y : i32) (m : i32) (d : i32) : i32 =
    := y = ? m <= 2i32 ?> y - 1i32 |: y
    := yoe = y % 400i32
    y / 400i32 * 146097i32 + yoe * 365i32 + yoe / 4i32 - yoe / 100i32 + day_of_year m d - 719468i32

:= year_of_era (doe : i32) : i32 = (doe - doe / 1460i32 + doe / 36524i32 - doe / 146096i32) / 365i32

:= day_in_era (doe : i32) (yoe : i32) : i32 = doe - (365i32 * yoe + yoe / 4i32 - yoe / 100i32)

:= month_of (mp : i32) : i32 = ? mp < 10i32 ?> mp + 3i32 |: mp - 9i32

:= civil_of (year : i32) (doy : i32) : civil =
    := mp = (5i32 * doy + 2i32) / 153i32
    := m = month_of mp
    { y = ? m <= 2i32 ?> year + 1i32 |: year; m; d = doy - (153i32 * mp + 2i32) / 5i32 + 1i32 }

:= civil_from_days (days : i32) : civil =
    := z = days + 719468i32
    := doe = z % 146097i32
    := yoe = year_of_era doe
    civil_of (yoe + z / 146097i32 * 400i32) (day_in_era doe yoe)

:= moment_of (iso : string) : moment =
    := days = days_from_civil (number_in iso 0i32 4i32) (number_in iso 5i32 2i32) (number_in iso 8i32 2i32)
    { days seconds = number_in iso 11i32 2i32 * 3600i32 + number_in iso 14i32 2i32 * 60i32 + number_in iso 17i32 2i32 }

:= padded (width : i32) (n : i32) : string =
    := t = sm'::obj_to_string n
    sm'::replicate (width - sm'::length t) "0" ++# t

:= clock_text (s : i32) : string =
    padded 2i32 (s / 3600i32) ++# ":" ++# padded 2i32 (s / 60i32 % 60i32) ++# ":" ++# padded 2i32 (s % 60i32)

:= date_text (c : civil) : string = padded 4i32 c::y ++# "-" ++# padded 2i32 c::m ++# "-" ++# padded 2i32 c::d

:= stamped (base : moment) (clock : i32) : string =
    := total = base::seconds + clock
    date_text (civil_from_days (base::days + total / 86400i32)) ++# "T" ++# clock_text (total % 86400i32) ++# ".000Z"

:= replies_here (id : post_id) (f : posted_frame) : bool =
    ?= f::reply_to ?|
    | Some p => same_post p id
    | None => !-

:= replies_to (w : world) (id : post_id) : i32 = w::frames |> keep (replies_here id) |> listm::length

:= tally_count (r : replay) (cell : cell_id) : i32 =
    r::tallies
    |> keep (\ (t : tally) => t::post_id = cell_text cell)
    |> spread (\ (t : tally) => t::users)
    |> listm::length

:= likes_for_cell (r : replay) (f : posted_frame) : i32 = ? f::k <> 1i32 ?> 0i32 |: tally_count r f::cell

:= metrics_json (w : world) (r : replay) (f : posted_frame) : string =
    laid_out
        [ pair "like_count" (number (likes_for_cell r f)); pair "reply_count" (number (replies_to w f::original)) ]
        (braces ())
        5i32

:= reply_ref (id : post_id) : string =
    laid_out [ pair "id" (quoted (post_text id)); pair "type" (quoted "replied_to") ] (braces ()) 6i32

:= refs_json (f : posted_frame) : string =
    ?= f::reply_to ?|
    | Some id => laid_out [ reply_ref id ] (square ()) 5i32
    | None => "[]"

:= root_json (w : world) : string =
    ?= w::root ?|
    | Some r => quoted (post_text r)
    | None => "null"

:== posting_view = { posted : world; replay : replay; base : moment }

:= history_json (f : posted_frame) : string =
    laid_out (f::versions |> each (\ (v : version) => quoted (post_text v::post_id))) (square ()) 5i32

:= dated_fields (p : posting_view) (f : posted_frame) (v : version) : list string =
    [
        pair "conversation_id" (root_json p::posted)
        pair "created_at" (quoted (stamped p::base v::clock))
        pair "edit_history" (history_json f)
    ]

:= metrics_pair (p : posting_view) (f : posted_frame) : string = pair "metrics" (metrics_json p::posted p::replay f)

:= post_fields_of (p : posting_view) (f : posted_frame) (v : version) : list string =
    [
        pair "id" (quoted (post_text v::post_id))
        metrics_pair p f
        pair "refs" (refs_json f)
        pair "text" (quoted v::text)
    ]

:= post_json (p : posting_view) (f : posted_frame) (v : version) : string =
    laid_out (listm::append (dated_fields p f v) (post_fields_of p f v)) (braces ()) 4i32

:= frame_posts (p : posting_view) (f : posted_frame) : list string = f::versions |> each (post_json p f)

:== account_view = { user_id : string; username : string }

:= user_fields (a : account_view) (posts : list string) : list string =
    [
        pair "id" (quoted a::user_id)
        pair "name" (quoted a::username)
        pair "posts" (laid_out posts (square ()) 3i32)
        pair "username" (quoted a::username)
    ]

:= world_json (p : posting_view) (a : account_view) : string =
    := user = laid_out (user_fields a (ordered_frames p::posted |> spread (frame_posts p))) (braces ()) 2i32
    laid_out [ pair "users" (laid_out [ user ] (square ()) 1i32) ] (braces ()) 0i32 ++# "\n"

:= lines_of_program (text : string) : list string = ? text = "" ?> Nil |: split_on "\n" text

:= quoted_list (l : list string) : string = laid_out (l |> each quoted) (square ()) 1i32

:= cells_json (l : list cell_id) : string = quoted_list (l |> each cell_text)

:= expected_fields (cells : live) (w : world) : list string =
    [
        pair "gaps" (cells_json (gaps w))
        pair "incomplete" (cells_json w::lost)
        pair "program" (quoted_list (lines_of_program (program cells w)))
        pair "root" (root_json w)
    ]

:= expected_json (cells : live) (w : world) : string = laid_out (expected_fields cells w) (braces ()) 0i32 ++# "\n"

:== world_ask =
    {
        seed : i32
        edits : i32
        personas : string
        id_base : i32
        losses : losses
        base_time : string
        account : account_view
        chunking : cell_chunker
    }

:= world_casting (a : world_ask) : casting =
    := c = plain_casting a::seed
    { c ?| edits = a::edits; personas = parsed_personas a::personas }

:= replay_of (a : world_ask) (cells : list string) : replay =
    := s = from_cells (world_casting a) "" cells
    final_replay s::all_events

:= posting_of (a : world_ask) (r : replay) (w : world) : posting_view =
    { posted = w; replay = r; base = moment_of a::base_time }

:= materialized_for (a : world_ask) (alive : live) : world = materialized a::chunking alive a::id_base a::losses

:~ world_files (a : world_ask) (cells : list string) : string * string =
    := r = replay_of a cells
    := alive = live_cells r |> each live_of
    := w = materialized_for a alive
    world_json (posting_of a r w) a::account, expected_json alive w

test stamps_carry_into_the_next_day =
    := ~base = moment_of "2026-12-31T23:59:30Z"
    stamped base 45i32 |> _assert_eq "2027-01-01T00:00:15.000Z"
    stamped (moment_of "2026-08-01T08:00:00Z") 1i32 |> _assert_eq "2026-08-01T08:00:01.000Z"

:= two_cells () : live =
    [
        { cell = cell_id "p0"; parent = None; revisions = [ "a" ] }
        { cell = cell_id "p1"; parent = Some (cell_id "p0"); revisions = [ "b"; "c" ] }
    ]

:= frame_summary (f : posted_frame) : string =
    post_text f::original ++# ":" ++# sm'::obj_to_string (listm::length f::versions : i32)

test edits_add_versions_to_their_frames =
    := ~cells = two_cells ()
    materialized split_named cells 100i32 { lost = 0i32; lost_cells = 0i32 }
    |> ordered_frames
    |> each frame_summary
    |> delimited ","
    |> _assert_eq "101:1,102:2"

:= child_cell (name : string) (parent : string) (revision : string) : live_cell =
    { cell = cell_id name; parent = Some (cell_id parent); revisions = [ revision ] }

:= chained_cells () : live =
    [
        { cell = cell_id "a"; parent = None; revisions = [ "inl a = 1" ] }
        child_cell "b" "a" "inl b = a"
        child_cell "c" "b" "inl c = b"
    ]

:= lost_cell_view (cells : live) : string =
    := w = materialized split_named cells 100i32 { lost = 0i32; lost_cells = 1i32 }
    delimited "," (w::gone |> each cell_text)
    ++# "|"
    ++# delimited "," (gaps w |> each cell_text)
    ++# "|"
    ++# program cells w

test a_cell_lost_with_all_its_posts_leaves_a_gap =
    := ~cells = chained_cells ()
    lost_cell_view cells |> _assert_eq "b|c|inl a = 1\n\ninl c = b"
