///- --package . --timeout 600000
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test scenario static =
    open testing

open sm'_operators
open prelude
open exsss
open glyphs
open events
open personas

type casting = {seed : i32; users : i32; edits : i32; breaking : i32; churn : i32; personas : list persona; branch_tests : bool}

inl plain_casting (seed : i32) : casting = {seed users = 8i32; edits = 3i32; breaking = 0i32; churn = 0i32; personas = Nil; branch_tests = false}

type scenario = {posts : list rooted; all_events : list event; broken : list string}

type flow = list event

type thread = list rooted

inl leads_test (source : string) : bool = sm'.starts_with "///- --test" (sm'.trim_start [] source)

type trunk = {chain : list rooted; parent : option string; n : i32}

inl post_name (prefix : string) (n : i32) : string = prefix ++# "p" ++# sm'.obj_to_string n

inl next_parent (c : casting) (t : trunk) (source : string) (post_id : string) : option string =
    if leads_test source && c.branch_tests then t.parent else Some post_id

inl grown_trunk (c : casting) (prefix : string) (t : trunk) (source : string) : trunk =
    inl post_id = post_name prefix t.n
    {chain = Cons ({post_id parent = t.parent; source}, t.chain); parent = next_parent c t source post_id; n = t.n + 1i32}

inl posts_of_cells (c : casting) (prefix : string) (cells : list string) : list rooted =
    inl t = cells |> listm.fold (grown_trunk c prefix) {chain = Nil; parent = None; n = 0i32}
    listm.rev t.chain

inl user_name (u : i32) : string = "u" ++# sm'.obj_to_string u

inl like_of (r : rooted) (u : i32) : social = {post_id = r.post_id; user = user_name (u + 1i32)}

inl likes_for (users : i32) (acc : list social * exsss) (r : rooted) : list social * exsss =
    inl l, st = acc
    inl k, st = rolled users st
    listm.init k (like_of r) |> listm.fold (fun acc s => Cons (s, acc)) l, st

inl unliked_from (acc : list event * exsss) (s : social) : list event * exsss =
    inl l, st = acc
    inl roll, st = rolled 10i32 st
    (if roll = 1i32 then listm.append l [Reaction (Unliked s)] else l), st

inl edit_draw (pool : list rooted) (edit : rooted -> event) (acc : list event * exsss) (_ : i32) : list event * exsss =
    inl l, st = acc
    inl drawn, st = drawn_from pool st
    match drawn with
    | Some r => listm.append l [edit r], st
    | None => l, st

inl edits_among (pool : list rooted) (count : i32) (edit : rooted -> event) (st : exsss) : list event * exsss =
    match pool with
    | Nil => Nil, st
    | _ => listm.init count id |> listm.fold (edit_draw pool edit) (Nil, st)

inl appended_line (r : rooted) : event = edited_to (r.source ++# "\n") r

inl broken_edit (r : rooted) : event = edited_to (break_source r.source) r

inl churn_edit (root : rooted) (i : i32) : event = edited_to (root.source ++# sm'.replicate ((i + 1i32) % 3i32 + 1i32) "\n") root

inl churned (posts : list rooted) (count : i32) : list event =
    match posts with
    | Cons (root, _) => listm.init count (churn_edit root)
    | Nil => Nil

inl turns (step : i32) (i : i32) : bool = (i + 1i32) % step = 0i32

type weaving = {step : i32; i : i32; churn : list event}

inl taken (w : weaving) (e : event) (acc : flow) : weaving * flow =
    inl next = {w with i = w.i + 1i32}
    match w.churn with
    | Cons (edit, more) when turns w.step w.i => {next with churn = more}, Cons (edit, Cons (e, acc))
    | _ => next, Cons (e, acc)

let rec woven (w : weaving) (l : list event) (acc : list event) : list event =
    match l with
    | Nil => listm.append (listm.rev acc) w.churn
    | Cons (e, rest) => taken w e acc |> fun (w, acc) => woven w rest acc

inl weave_step (events : list event) (churn : list event) : i32 =
    inl step = listm.length events / (listm.length churn + 1i32)
    if step < 1i32 then 1i32 else step

inl weave (events : list event) (churn : list event) : list event =
    match churn with
    | Nil => events
    | _ => woven {step = weave_step events churn; i = 0i32; churn} events Nil

inl liked_event (s : social) : event = Reaction (Liked s)

inl posted_event (r : rooted) : event = Content (Posted r)

type drafts = {likes : list social; unlikes : list event; edits : list event; breaking : list event; rng : exsss}

inl scenario_seed (seed : i32) : exsss = seeded_i32 seed (seed * 7i32 + 1i32) (seed * 13i32 + 3i32)

inl liked_drafts (c : casting) (posts : list rooted) : list social * exsss =
    inl reversed, st = posts |> listm.fold (likes_for c.users) (Nil, scenario_seed c.seed)
    listm.rev reversed, st

inl editable_posts (posts : list rooted) : list rooted = posts |> keep (fun (r : rooted) => not (test_cell r.source))

inl breakable_posts (posts : list rooted) : list rooted = posts |> keep (fun (r : rooted) => breakable r.source)

inl edited (c : casting) (posts : thread) (st : exsss) : flow * flow * exsss =
    inl edits, st = edits_among (editable_posts posts) c.edits appended_line st
    inl breaking, rng = edits_among (breakable_posts posts) c.breaking broken_edit st
    edits, breaking, rng

inl drafted (c : casting) (posts : list rooted) : drafts =
    inl likes, st = liked_drafts c posts
    inl unlikes, st = likes |> listm.fold unliked_from (Nil, st)
    inl edits, breaking, rng = edited c posts st
    {likes unlikes edits breaking rng}

inl interactions (d : drafts) (acts : acted) : list event =
    listm.append (each liked_event d.likes) (listm.append d.edits (listm.append d.breaking (listm.append d.unlikes acts.act_events)))

inl edited_source (e : event) : list string =
    match e with
    | Revision (Edited s) => [s.source]
    | _ => Nil

inl broken_of (d : drafts) (acts : acted) : list string = listm.append (d.breaking |> spread edited_source) acts.broken

inl timeline (c : casting) (posts : list rooted) (d : drafts) (acts : acted) : list event =
    listm.append (each posted_event posts) (weave (interactions d acts) (churned posts c.churn))

inl acted_on (c : casting) (posts : list rooted) (d : drafts) : acted = persona_events posts c.personas d.rng

let from_cells (c : casting) (prefix : string) (cells : list string) : scenario =
    inl posts = posts_of_cells c prefix cells
    inl d = drafted c posts
    inl acts = acted_on c posts d
    {posts all_events = timeline c posts d acts; broken = broken_of d acts}

inl thread_scenario (c : casting) (k : i32) (cells : list string) : scenario =
    inl seeded_c = {c with seed = c.seed + k}
    from_cells seeded_c ("f" ++# sm'.obj_to_string k) cells

type corpus = {scenarios : list scenario; k : i32}

inl next_thread (c : casting) (acc : corpus) (cells : list string) : corpus =
    {scenarios = listm.append acc.scenarios [thread_scenario c acc.k cells]; k = acc.k + 1i32}

inl merged_scenarios (l : list scenario) : scenario =
    inl all_events = round_robin (l |> each (fun (s : scenario) => s.all_events)) Nil
    {posts = l |> spread (fun (s : scenario) => s.posts); all_events; broken = l |> spread (fun (s : scenario) => s.broken)}

let from_corpus (c : casting) (threads : list (list string)) : scenario =
    inl acc = threads |> listm.fold (next_thread c) {scenarios = Nil; k = 0i32}
    merged_scenarios acc.scenarios

inl parent_text (p : option string) : string =
    match p with
    | Some id => id
    | None => "-"

inl chain_text (s : scenario) : string = s.posts |> each (fun (r : rooted) => r.post_id ++# "<" ++# parent_text r.parent) |> delimited ","

test posts_chain_their_parents =
    inl ~cells = ["a"; "b"]
    from_cells (plain_casting 1i32) "f0" cells |> chain_text |> _assert_eq "f0p0<-,f0p1<f0p0"

inl deleted_id (e : event) : string =
    match e with
    | Revision (Deleted id) => id
    | _ => "?"

inl deletions (l : list string) : list event = l |> each (fun id => Revision (Deleted id))

test churn_lands_between_every_step =
    inl ~churn = deletions ["x"; "y"]
    weave (deletions ["1"; "2"; "3"; "4"]) churn |> each deleted_id |> delimited "," |> _assert_eq "1,x,2,y,3,4"
