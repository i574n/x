///- --package . --timeout 600000
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test scenario static =
    :< testing

:< sm'_operators
:< prelude
:< exsss
:< glyphs
:< events
:< personas

:== casting = {seed : i32; users : i32; edits : i32; breaking : i32; churn : i32; personas : list persona; branch_tests : bool}

:= plain_casting (seed : i32) : casting = {seed users = 8i32; edits = 3i32; breaking = 0i32; churn = 0i32; personas = Nil; branch_tests = !-}

:== scenario = {posts : list rooted; all_events : list event; broken : list string}

:== flow = list event

:== thread = list rooted

:= leads_test (source : string) : bool = sm'.starts_with "///- --test" (sm'.trim_start [] source)

:== trunk = {chain : list rooted; parent : option string; n : i32}

:= post_name (prefix : string) (n : i32) : string = prefix ++# "p" ++# sm'.obj_to_string n

:= next_parent (c : casting) (t : trunk) (source : string) (post_id : string) : option string =
    ? leads_test source && c.branch_tests ?> t.parent |: Some post_id

:= grown_trunk (c : casting) (prefix : string) (t : trunk) (source : string) : trunk =
    := post_id = post_name prefix t.n
    {chain = {post_id parent = t.parent; source} :: t.chain; parent = next_parent c t source post_id; n = t.n + 1i32}

:= posts_of_cells (c : casting) (prefix : string) (cells : list string) : list rooted =
    := t = cells |> listm.fold (grown_trunk c prefix) {chain = Nil; parent = None; n = 0i32}
    listm.rev t.chain

:= user_name (u : i32) : string = "u" ++# sm'.obj_to_string u

:= like_of (r : rooted) (u : i32) : social = {post_id = r.post_id; user = user_name (u + 1i32)}

:= likes_for (users : i32) (acc : list social * exsss) (r : rooted) : list social * exsss =
    := l, st = acc
    := k, st = rolled users st
    listm.init k (like_of r) |> listm.fold (\ acc s => s :: acc) l, st

:= unliked_from (acc : list event * exsss) (s : social) : list event * exsss =
    := l, st = acc
    := roll, st = rolled 10i32 st
    (? roll = 1i32 ?> listm.append l [Reaction (Unliked s)] |: l), st

:= edit_draw (pool : list rooted) (edit : rooted -> event) (acc : list event * exsss) (_ : i32) : list event * exsss =
    := l, st = acc
    := drawn, st = drawn_from pool st
    ?= drawn ?|
    | Some r => listm.append l [edit r], st
    | None => l, st

:= edits_among (pool : list rooted) (count : i32) (edit : rooted -> event) (st : exsss) : list event * exsss =
    ?= pool ?|
    | Nil => Nil, st
    | _ => listm.init count id |> listm.fold (edit_draw pool edit) (Nil, st)

:= appended_line (r : rooted) : event = edited_to (r.source ++# "\n") r

:= broken_edit (r : rooted) : event = edited_to (break_source r.source) r

:= churn_edit (root : rooted) (i : i32) : event = edited_to (root.source ++# sm'.replicate ((i + 1i32) % 3i32 + 1i32) "\n") root

:= churned (posts : list rooted) (count : i32) : list event =
    ?= posts ?|
    | root :: _ => listm.init count (churn_edit root)
    | Nil => Nil

:= turns (step : i32) (i : i32) : bool = (i + 1i32) % step = 0i32

:== weaving = {step : i32; i : i32; churn : list event}

:= taken (w : weaving) (e : event) (acc : flow) : weaving * flow =
    := next = {w ?| i = w.i + 1i32}
    ?= w.churn ?|
    | edit :: more ?& turns w.step w.i => {next ?| churn = more}, edit :: e :: acc
    | _ => next, e :: acc

:~ ^ woven (w : weaving) (l : list event) (acc : list event) : list event =
    ?= l ?|
    | Nil => listm.append (listm.rev acc) w.churn
    | e :: rest => taken w e acc |> \ (w, acc) => woven w rest acc

:= weave_step (events : list event) (churn : list event) : i32 =
    := step = listm.length events / (listm.length churn + 1i32)
    ? step < 1i32 ?> 1i32 |: step

:= weave (events : list event) (churn : list event) : list event =
    ?= churn ?|
    | Nil => events
    | _ => woven {step = weave_step events churn; i = 0i32; churn} events Nil

:= liked_event (s : social) : event = Reaction (Liked s)

:= posted_event (r : rooted) : event = Content (Posted r)

:== drafts = {likes : list social; unlikes : list event; edits : list event; breaking : list event; rng : exsss}

:= scenario_seed (seed : i32) : exsss = seeded_i32 seed (seed * 7i32 + 1i32) (seed * 13i32 + 3i32)

:= liked_drafts (c : casting) (posts : list rooted) : list social * exsss =
    := reversed, st = posts |> listm.fold (likes_for c.users) (Nil, scenario_seed c.seed)
    listm.rev reversed, st

:= editable_posts (posts : list rooted) : list rooted = posts |> keep (\ (r : rooted) => not (test_cell r.source))

:= breakable_posts (posts : list rooted) : list rooted = posts |> keep (\ (r : rooted) => breakable r.source)

:= edited (c : casting) (posts : thread) (st : exsss) : flow * flow * exsss =
    := edits, st = edits_among (editable_posts posts) c.edits appended_line st
    := breaking, rng = edits_among (breakable_posts posts) c.breaking broken_edit st
    edits, breaking, rng

:= drafted (c : casting) (posts : list rooted) : drafts =
    := likes, st = liked_drafts c posts
    := unlikes, st = likes |> listm.fold unliked_from (Nil, st)
    := edits, breaking, rng = edited c posts st
    {likes unlikes edits breaking rng}

:= interactions (d : drafts) (acts : acted) : list event =
    listm.append (each liked_event d.likes) (listm.append d.edits (listm.append d.breaking (listm.append d.unlikes acts.act_events)))

:= edited_source (e : event) : list string =
    ?= e ?|
    | Revision (Edited s) => [s.source]
    | _ => Nil

:= broken_of (d : drafts) (acts : acted) : list string = listm.append (d.breaking |> spread edited_source) acts.broken

:= timeline (c : casting) (posts : list rooted) (d : drafts) (acts : acted) : list event =
    listm.append (each posted_event posts) (weave (interactions d acts) (churned posts c.churn))

:= acted_on (c : casting) (posts : list rooted) (d : drafts) : acted = persona_events posts c.personas d.rng

:~ from_cells (c : casting) (prefix : string) (cells : list string) : scenario =
    := posts = posts_of_cells c prefix cells
    := d = drafted c posts
    := acts = acted_on c posts d
    {posts all_events = timeline c posts d acts; broken = broken_of d acts}

:= thread_scenario (c : casting) (k : i32) (cells : list string) : scenario =
    := seeded_c = {c ?| seed = c.seed + k}
    from_cells seeded_c ("f" ++# sm'.obj_to_string k) cells

:== corpus = {scenarios : list scenario; k : i32}

:= next_thread (c : casting) (acc : corpus) (cells : list string) : corpus =
    {scenarios = listm.append acc.scenarios [thread_scenario c acc.k cells]; k = acc.k + 1i32}

:= merged_scenarios (l : list scenario) : scenario =
    := all_events = round_robin (l |> each (\ (s : scenario) => s.all_events)) Nil
    {posts = l |> spread (\ (s : scenario) => s.posts); all_events; broken = l |> spread (\ (s : scenario) => s.broken)}

:~ from_corpus (c : casting) (threads : list (list string)) : scenario =
    := acc = threads |> listm.fold (next_thread c) {scenarios = Nil; k = 0i32}
    merged_scenarios acc.scenarios

:= parent_text (p : option string) : string =
    ?= p ?|
    | Some id => id
    | None => "-"

:= chain_text (s : scenario) : string = s.posts |> each (\ (r : rooted) => r.post_id ++# "<" ++# parent_text r.parent) |> delimited ","

test posts_chain_their_parents =
    := ~cells = ["a"; "b"]
    from_cells (plain_casting 1i32) "f0" cells |> chain_text |> _assert_eq "f0p0<-,f0p1<f0p0"

:= deleted_id (e : event) : string =
    ?= e ?|
    | Revision (Deleted id) => id
    | _ => "?"

:= deletions (l : list string) : list event = l |> each (\ id => Revision (Deleted id))

test churn_lands_between_every_step =
    := ~churn = deletions ["x"; "y"]
    weave (deletions ["1"; "2"; "3"; "4"]) churn |> each deleted_id |> delimited "," |> _assert_eq "1,x,2,y,3,4"
