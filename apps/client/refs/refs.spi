open sm'_operators
open prelude
open posts
open cli
open wire
open transport

type traced = {author_ids : list string; named : list string; failure : string; bodies : list string}

inl entry (body : string) : string = "{\"role\":\"lookup\",\"author\":\"\",\"doc\":" ++# body ++# "}"

inl ids_at (key : string) (items : json) : list string = items |> collect (field key >> text_of)

inl referenced (data : json) : list string =
    data |> collect (field "referenced_posts" >> ids_at "id") |> spread id

inl named_ids (inc : json) : list string = inc |> field "users" |> named_accounts |> each (fun (a : account) => a.id)

inl seen_authors (doc : json) : list string =
    listm.append (doc |> field "data" |> ids_at "author_id") (doc |> field "includes" |> field "posts" |> ids_at "author_id")

inl with_named (inc : json) (t : traced) : traced = {t with named = listm.append t.named (named_ids inc)}

let absorbed (doc : json) (body : string) (t : traced) : traced =
    inl t = with_named (doc |> field "includes") t
    {t with author_ids = listm.append t.author_ids (seen_authors doc); bodies = listm.append t.bodies [entry body]}

inl posts_by (a : app) (q : query) (wanted : ids) : got fetched = get_raw a (read_path (PostsById (take_first 100 wanted, q)))

inl failed_with (f : failure) (t : traced) : traced = {t with failure = describe_failure f}

inl next_ids (doc : json) : ids = referenced (doc |> field "data")

let rec deepen (a : app) (q : query) (level : i32) (l : ids) (t : traced) : traced =
    match distinct l with
    | Nil => t
    | _ when level >= q.depth => t
    | wanted => posts_by a q wanted |> deepened a q level t

and let deepened (a : app) (q : query) (level : i32) (t : traced) (r : got fetched) : traced =
    match r with
    | Error f => failed_with f t
    | Ok (doc, body) => deepen a q (level + 1) (next_ids doc) (absorbed doc body t)

inl unnamed (t : traced) : list string =
    t.author_ids |> keep (fun id => id <> "" && not (has ((=) id) t.named)) |> distinct

type refs_reply = string * string * string

inl reply_of (t : traced) : refs_reply = sm'.concat_list "," t.bodies, t.failure, sm'.concat_list "," (unnamed t)

inl started (authors : string) (named : string) : traced =
    {author_ids = pieces "," authors; named = pieces "," named; failure = ""; bodies = Nil}

let traced_refs (base : string) (bearer : string) (refs : string) (authors : string) (named : string) (q : query) : refs_reply =
    deepen (app_api base bearer) q 1i32 (pieces "," refs) (started authors named) |> reply_of

inl query_of (depth : i32) (hints : bool) : query = {max_results = 5i32; filters = no_filters (); depth hints}

inl main () : i32 =
    !!!!Export("xc_refs", ((fun (base, bearer, refs, authors, named, depth, hints) => traced_refs base bearer refs authors named (query_of depth hints)) : string * string * string * string * string * i32 * bool -> refs_reply))
    0i32