///- --package .
test oauth1 static =
    :< testing

:< sm'_operators

:== oauth1 = oauth.oauth1_credentials

:== pair = oauth.oauth1_pair

:= percent (s : string) : string = sm'.percent_encode s

:! system_time = $'std::time::SystemTime'

:! elapsed = $'std::time::Duration'

:= system_now () : system_time = $'std::time::SystemTime::now()'

:= since_epoch (t : system_time) : elapsed = $'!t.duration_since(std::time::UNIX_EPOCH).unwrap_or_default()'

:= whole_seconds (d : elapsed) : u64 = $'!d.as_secs()'

:= sub_micros (d : elapsed) : u32 = $'!d.subsec_micros()'

:= process_id () : u32 = $'std::process::id()'

:= clock_seed () : string =
    := d = since_epoch (system_now ())
    := micros : u64 = whole_seconds d * 1000000u64 + conv (sub_micros d)
    sm'.obj_to_string micros ++# "-" ++# sm'.obj_to_string (process_id ())

:= unix_seconds () : string = since_epoch (system_now ()) |> whole_seconds |> sm'.obj_to_string

:= fresh_nonce () : string = crypto.sha1_hex (clock_seed ())

:~ oauth_header (o : oauth1) (method : string) (url : string) (nonce : string) (stamp : string) : string =
    oauth.authorization_header o method url nonce stamp

///> rust -d sha1
test a_fresh_nonce_is_forty_hex_digits =
    sm'.length (fresh_nonce ()) |> _assert_eq 40i32
