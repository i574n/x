///- --package . --timeout 600000
///> rust
///> gleam
///> zig
test protocol static =
    :< testing

:< sm'_operators
:< prelude

:! cell_id = string

:= cell_text (c : cell_id) : string =
    ?= c ?|
    | cell_id s => s

:= same_cell (a : cell_id) (b : cell_id) : bool = cell_text a = cell_text b

:! post_id = string

:= post_text (p : post_id) : string =
    ?= p ?|
    | post_id s => s

:= same_post (a : post_id) (b : post_id) : bool = post_text a = post_text b

:== post_ids = list post_id

:== bluesky_writer = { repo : string; at : string }

:| platform =
    | OnX
    | OnMastodon
    | OnBluesky : bluesky_writer

:= unwritten () : bluesky_writer = { repo = ""; at = "" }

:= platform_named (name : string) : platform =
    ? name = "mastodon" ?> OnMastodon |? name = "bluesky" ?> OnBluesky (unwritten ()) |: OnX

:= optional_post (s : string) : option post_id = ? s = "" ?> None |: Some (post_id s)

:= optional_text (p : option post_id) : string =
    ?= p ?|
    | Some q => post_text q
    | None => ""

:== frame_header = { cell : cell_id; part : i32; part_count : i32 }

:| header_rejection =
    | NotTwoWords
    | NotAFraction
    | PartOutOfRange

:| thread_flaw =
    | MissingFrames : { cell : cell_id; missing : list i32; part_count : i32 }
    | ReplyGap : { cell : cell_id; parent : post_id }

:= cell_label (cell : i32) : cell_id = cell_id ("c" ++# sm'.obj_to_string cell)

:= rendered (h : frame_header) : string =
    cell_text h.cell ++# " " ++# sm'.obj_to_string h.part ++# "/" ++# sm'.obj_to_string h.part_count

:== header_reading = result frame_header header_rejection

:= header_in (cell : cell_id) (part : i32) (part_count : i32) : header_reading =
    ? part >= 1i32 && part <= part_count ?> Ok { cell part part_count } |: Error PartOutOfRange

:= rest_after (at : i32) (text : string) : string = cut (at + 1i32) (sm'.length text - at - 1i32) text

:= counted_after (cell : cell_id) (part : i32) (rest : string) : header_reading =
    ?= count_of_text rest ?|
    | Some part_count => header_in cell part part_count
    | None => Error NotAFraction

:= split_fraction (cell : cell_id) (slash : i32) (fraction : string) : header_reading =
    ?= count_of_text (cut 0i32 slash fraction) ?|
    | Some part => counted_after cell part (rest_after slash fraction)
    | None => Error NotAFraction

:~ fraction_of (cell : cell_id) (fraction : string) : header_reading =
    := slash = sm'.index_of "/" fraction
    ? slash > 0i32 ?> split_fraction cell slash fraction |: Error NotAFraction

:= second_word (space : i32) (line : string) : string = ? space > 0i32 ?> rest_after space line |: ""

:~ parsed (line : string) : header_reading =
    := space = sm'.index_of " " line
    := fraction = second_word space line
    ? space <= 0i32 || sm'.index_of " " fraction >= 0i32
    ?> Error NotTwoWords
    |: fraction_of (cell_id (cut 0i32 space line)) fraction

:= listed (l : list i32) : string = l |> each sm'.obj_to_string |> delimited ", "

:= missing_note (cell : cell_id) (missing : list i32) (part_count : i32) : string =
    "cell " ++# cell_text cell ++# " is missing frame " ++# listed missing ++# " of " ++# sm'.obj_to_string part_count

:= gap_note (cell : cell_id) (parent : post_id) : string =
    "cell "
    ++# cell_text cell
    ++# " replies to "
    ++# post_text parent
    ++# ", which is not in the thread: posts before it are missing"

:= note_of (flaw : thread_flaw) : string =
    ?= flaw ?|
    | MissingFrames { cell missing part_count } => missing_note cell missing part_count
    | ReplyGap { cell parent } => gap_note cell parent

:= exit_code (flaws : list thread_flaw) : i32 =
    ?= flaws ?|
    | Nil => 0i32
    | _ => 4i32

:= packed (h : frame_header) : i32 = h.part * 100i32 + h.part_count

:= read_back (r : header_reading) : string =
    ?= r ?|
    | Ok h => cell_text h.cell ++# sm'.obj_to_string (packed h)
    | Error _ => "rejected"

test headers_round_trip =
    := ~cell = cell_label 12i32
    := h = { cell part = 3i32; part_count = 10i32 }
    rendered h |> _assert_eq "c12 3/10"
    parsed (rendered h) |> read_back |> _assert_eq "c12310"

:= rejection_number (e : header_rejection) : i32 =
    ?= e ?|
    | NotTwoWords => 1i32
    | NotAFraction => 2i32
    | PartOutOfRange => 3i32

:= rejection_code (r : header_reading) : i32 =
    ?= r ?|
    | Ok _ => 0i32
    | Error e => rejection_number e

:= code_of (line : string) : i32 = parsed line |> rejection_code

test parts_must_fall_inside_the_count =
    := ~line = "c1 4/3"
    code_of line |> _assert_eq 3i32
    code_of "c1 0/3" |> _assert_eq 3i32
    code_of "c7 2/2" |> _assert_eq 0i32
    code_of "p2 1/6" |> _assert_eq 0i32

test headers_are_two_words =
    := ~line = "c1"
    code_of line |> _assert_eq 1i32
    code_of "c1  1/2" |> _assert_eq 1i32
    code_of " 1/2" |> _assert_eq 1i32

test the_second_word_is_a_fraction =
    := ~line = "c1 1-2"
    code_of line |> _assert_eq 2i32
    code_of "c1 1/2/3" |> _assert_eq 2i32
    code_of "c1 a/2" |> _assert_eq 2i32

test a_missing_frame_names_its_cell =
    := ~cell = cell_id "c3"
    note_of (MissingFrames { cell missing = [ 2i32; 4 ]; part_count = 5i32 })
    |> _assert_eq "cell c3 is missing frame 2, 4 of 5"
    exit_code Nil |> _assert_eq 0i32

test a_reply_gap_names_the_parent =
    := ~cell = cell_id "p2"
    := gap = ReplyGap { cell parent = post_id "1900" }
    note_of gap |> _assert_eq "cell p2 replies to 1900, which is not in the thread: posts before it are missing"
    exit_code [ gap ] |> _assert_eq 4i32

test words_beyond_ascii_are_no_header =
    := ~line = "c’est parti"
    code_of line |> _assert_eq 2i32
    code_of "c1 é/2" |> _assert_eq 2i32
    code_of "c1 1/2…" |> _assert_eq 2i32
