///- --package .
test wire static =
    :< testing

:< sm'_operators
:< prelude
:< protocol
:< posts
:< cli
:< oauth1
:< paging

:! json = $'serde_json::Value'

:= parse_json (text : string) : json =
    $'serde_json::from_str::<serde_json::Value>(&*!text).unwrap_or_default()'

:= field (key : string) (v : json) : json = $'!v.get(&*!key).cloned().unwrap_or_default()'

:= text_of (v : json) : string = $'Rc::<str>::from(!v.as_str().unwrap_or(""))'

:= json_text (v : json) : string = $'Rc::<str>::from((!v).to_string())'

:= json_string (s : string) : string = $'Rc::<str>::from(serde_json::Value::from(&*!s).to_string())'

:= flag_of_json (v : json) : bool = $'!v.as_bool().unwrap_or(false)'

:= number_of (v : json) : i32 = ($'!v.as_i64().unwrap_or(0)' : i64) |> conv

:= count_of (v : json) : i32 = ($'!v.as_array().map_or(0, Vec::len)' : convert.unativeint) |> convert.convert

:= item (i : i32) (v : json) : json =
    := at : convert.unativeint = convert.convert i
    $'!v.get(!at).cloned().unwrap_or_default()'

:= absent (v : json) : bool = $'!v.is_null()'

:= text_body (text : string) : string =
    $'Rc::<str>::from(serde_json::json\!({"text": &*!text}).to_string())'

:= reply_body (text : string) (to : string) : string =
    $'Rc::<str>::from(serde_json::json\!({"text": &*!text, "reply": {"in_reply_to_tweet_id": &*!to}}).to_string())'

:= unescaped (t : string) : string = t |> sm'.replace "&lt;" "<" |> sm'.replace "&gt;" ">" |> sm'.replace "&amp;" "&"

:! app_context = ()

:! user_context = ()

:| authorizer c =
    | BearerToken :: \* c. string -> authorizer c
    | Signed :: oauth1 * string * string -> authorizer user_context

:== endpoint c = {base : string; auth : authorizer c}

:! api c = endpoint c

:== app = api app_context

:== halted_cursor = {resource : string; halt : cursor_halt}

:| failure =
    | Reported : string
    | NoSuchAccount : string
    | CursorHalted : halted_cursor

:== got r = result r failure

:~ ^ after_first \* t. (n : i32) (items : list t) : list t =
    ?= items ?|
    | Cons (_, rest) ?& n > 0i32 => after_first (n - 1i32) rest
    | _ => items

:~ ^ chunked \* t. (n : i32) (items : list t) : list (list t) =
    ?= items ?|
    | Nil => Nil
    | _ => Cons (take_first n items, chunked n (after_first n items))

:~ ^ all_got \* r. (each_got : list (got r)) (acc : list r) : got (list r) =
    ?= each_got ?|
    | Nil => Ok (listm.rev acc)
    | Cons (Error f, _) => Error f
    | Cons (Ok x, rest) => all_got rest (Cons (x, acc))

:== usernames = list string

:== query = {max_results : i32; filters : filters; depth : i32; hints : bool}

:! users_reply = {found : accounts; unknown : list string}

:! page_reply = {page : accounts; next_token : string}

:! posts_reply = {pool : pool; primary : list post; skipped : string}

:! created_reply = {id : post_id; text : string}

:! deleted_reply = {deleted : bool}

:! conversation_id = string

:= conversation_text (c : conversation_id) : string =
    ?= c ?|
    | conversation_id s => s

:! root_reply = {conversation_id : conversation_id; author_id : user_id; created_at : string; missing : string}

:== thread_search = {conversation_id : conversation_id; author_id : user_id; start_time : string}

:! thread_page = {framed : list framed; next_token : string}

:== following_page = {follower : user_id; size : i32; pagination_token : string}

:| threads r =
    | ThreadRoot :: post_id -> threads root_reply
    | ThreadPage :: thread_search * string -> threads thread_page

:| user_key =
    | Named : usernames
    | Ids : user_ids

:| reads r =
    | Users :: user_key -> reads users_reply
    | FollowedBy :: following_page -> reads page_reply
    | PostsOf :: account * query -> reads posts_reply
    | PostsById :: post_ids * query -> reads posts_reply

:| writes r =
    | CreatePost :: string -> writes created_reply
    | ReplyPost :: string * created_reply -> writes created_reply
    | DeletePost :: post_id -> writes deleted_reply

:| verb =
    | Read
    | Write : string
    | Remove

:= trimmed_base (base_url : string) : string =
    := n : i32 = sm'.length base_url
    ? sm'.ends_with "/" base_url ?> sm'.slice 0i32 (n - 2i32) base_url |: base_url

:= header_kind \* c. (a : authorizer c) : string =
    ?= a ?|
    | BearerToken _ => "bearer"
    | Signed _ => "signed"
:= endpoint_of \* c. (base_url : string) (token : string) : endpoint c = {base = trimmed_base base_url; auth = BearerToken token}

:= app_api (base_url : string) (token : string) : api app_context = api (endpoint_of base_url token)

:= user_api (base_url : string) (token : string) : api user_context = api (endpoint_of base_url token)

:= signed_api (base_url : string) (o : oauth1) (nonce : string) (stamp : string) : api user_context =
    api {base = trimmed_base base_url; auth = Signed (o, nonce, stamp)}

:= base_of \* c. (a : api c) : string =
    ?= a ?|
    | api e => e.base

:= following_path (p : following_page) : string =
    := first = "/2/users/" ++# user_text p.follower ++# "/following?max_results=" ++# sm'.obj_to_string p.size
    ? p.pagination_token = "" ?> first |: first ++# "&pagination_token=" ++# p.pagination_token

:= expansions_of (q : query) : list string =
    listm.append (? q.depth > 0 ?> ["referenced_posts"; "referenced_posts.author_id"] |: Nil)
        (? q.hints ?> ["attachments.media_keys"] |: Nil)

:= expansion_params (q : query) : string =
    := media = ? q.hints ?> "&media.fields=type,alt_text" |: ""
    ?= expansions_of q ?|
    | Nil => ""
    | names => "&expansions=" ++# sm'.concat_list "," names ++# media

:= fields_params (q : query) : string =
    "&post.fields=created_at,author_id,public_metrics,entities,attachments" ++# expansion_params q

:= exclude_param (f : filters) : string =
    ?= f.no_replies, f.no_reposts ?|
    | !+, !+ => "&exclude=replies,retweets"
    | !+, !- => "&exclude=replies"
    | !-, !+ => "&exclude=retweets"
    | !-, !- => ""

:= window_params (f : filters) : string =
    := start_time = ? f.start_time = "" ?> "" |: "&start_time=" ++# f.start_time
    start_time ++# (? f.end_time = "" ?> "" |: "&end_time=" ++# f.end_time)

:= timeline_floor () : i32 = 5i32

:= requested_posts (shown : i32) : i32 = ? shown < timeline_floor () ?> timeline_floor () |: shown

:~ posts_path (u : user_id) (q : query) : string =
    "/2/users/" ++# user_text u ++# "/tweets?max_results=" ++# sm'.obj_to_string (requested_posts q.max_results)
    ++# fields_params q ++# window_params q.filters ++# exclude_param q.filters

:= joined (prefix : string) (ids : list string) : string = prefix ++# sm'.concat_list "," ids

:~ lookup_path (l : post_ids) (q : query) : string = joined "/2/tweets?ids=" (l |> each post_text) ++# fields_params q

:= users_path (k : user_key) : string =
    ?= k ?|
    | Named hs => joined "/2/users/by?usernames=" hs
    | Ids l => joined "/2/users?ids=" (l |> each user_text)

:= root_path (id : post_id) : string = "/2/tweets/" ++# post_text id ++# "?post.fields=conversation_id,author_id,created_at"

:= search_head (s : thread_search) : string =
    "/2/tweets/search/all?query=conversation_id%3A" ++# conversation_text s.conversation_id ++# "%20from%3A" ++# user_text s.author_id ++# "&start_time=" ++# s.start_time

:= page_path (s : thread_search) (token : string) : string =
    := first = search_head s ++# "&max_results=100&post.fields=conversation_id,entities,referenced_posts"
    ? token = "" ?> first |: first ++# "&next_token=" ++# token

:= thread_path \* r. (q : threads r) : string =
    ?= q ?|
    | ThreadRoot id => root_path id
    | ThreadPage (s, t) => page_path s t

:= read_path \* r. (q : reads r) : string =
    ?= q ?|
    | Users k => users_path k
    | FollowedBy p => following_path p
    | PostsOf (a, qy) => posts_path a.id qy
    | PostsById (l, qy) => lookup_path l qy

:= write_path \* r. (q : writes r) : string =
    ?= q ?|
    | CreatePost _ | ReplyPost _ => "/2/tweets"
    | DeletePost id => "/2/tweets/" ++# post_text id

:= write_verb \* r. (q : writes r) : verb =
    ?= q ?|
    | CreatePost text => Write (text_body text)
    | ReplyPost (text, created_reply {id}) => Write (reply_body text (post_text id))
    | DeletePost _ => Remove

:= method_of (v : verb) : string =
    ?= v ?|
    | Read => "GET"
    | Write _ => "POST"
    | Remove => "DELETE"

:= body_of_verb (v : verb) : string =
    ?= v ?|
    | Write body => body
    | _ => ""

:= collect \* t. (f : json -> t) (items : json) : list t =
    :~ ^ from (i : i32) (acc : list t) : list t =
        ? i < 0i32 ?> acc |: from (i - 1) (Cons (f (item i items), acc))
    from (count_of items - 1) Nil

:= texts (items : json) : list string = items |> collect text_of

:= at_key (key : string) (v : json) : string = v |> field key |> text_of

:= account_of (v : json) : account = {id = user_id (at_key "id" v); username = at_key "username" v}

:= reference_of (v : json) : list reference = reference_as (at_key "type" v) (post_id (at_key "id" v))

:= url_entity_of (v : json) : url_entity =
    {url = at_key "url" v; expanded_url = at_key "expanded_url" v; title = at_key "title" v}

:= urls_in (v : json) : list url_entity = v |> field "entities" |> field "urls" |> collect url_entity_of

:= refs_in (v : json) : list reference = v |> field "referenced_posts" |> collect reference_of |> spread id

:= keys_in (v : json) : list string = v |> field "attachments" |> field "media_keys" |> texts

:= public_metrics_in (v : json) : public_metrics =
    := m = v |> field "public_metrics"
    := n (key : string) : i32 = m |> field key |> number_of
    {reply_count = n "reply_count"; repost_count = n "repost_count"; like_count = n "like_count"}

:= post_texts (v : json) : post_id * user_id * string * string =
    post_id (at_key "id" v), user_id (at_key "author_id" v), at_key "created_at" v, unescaped (at_key "text" v)

:~ post_by (author : string) (v : json) : post =
    := id, author_id, created_at, text = post_texts v
    heap {id author_id author_username = author; created_at text public_metrics = public_metrics_in v;
     refs = refs_in v; urls = urls_in v; media_keys = keys_in v}

:= medium_of (v : json) : medium = {media_key = at_key "media_key" v; kind = at_key "type" v; alt_text = at_key "alt_text" v}

:= accounts_in (doc : json) : accounts = doc |> field "data" |> collect account_of

:= named_accounts (users : json) : accounts =
    users |> collect account_of |> keep (\ (a : account) => a.username <> "")

:= unknown_in (doc : json) : list string = doc |> field "errors" |> collect (at_key "value")

:= next_token_in (doc : json) : string = doc |> field "meta" |> at_key "next_token"

:= first_error (doc : json) : string =
    := e = doc |> field "errors" |> item 0i32
    := detail = at_key "detail" e
    ? detail <> "" ?> detail |: at_key "title" e

:= included_pool (primary : list post) (inc : json) : pool =
    := extra = inc |> field "posts" |> collect (post_by "")
    {posts = listm.append primary extra; media = inc |> field "media" |> collect medium_of; users = inc |> field "users" |> named_accounts}

:~ posts_of_doc (author : string) (doc : json) : posts_reply =
    := primary = doc |> field "data" |> collect (post_by author)
    posts_reply {pool = included_pool primary (doc |> field "includes"); primary; skipped = first_error doc}

:= users_of_doc (doc : json) : users_reply = users_reply {found = accounts_in doc; unknown = unknown_in doc}

:= page_of_doc (doc : json) : page_reply = page_reply {page = accounts_in doc; next_token = next_token_in doc}

:~ ^ first_reply_from (i : i32) (refs : json) : string =
    ? i >= count_of refs ?> ""
    |? at_key "type" (item i refs) = "replied_to" ?> at_key "id" (item i refs)
    |: first_reply_from (i + 1i32) refs

:= replied_to_in (v : json) : string = v |> field "referenced_posts" |> first_reply_from 0i32

:= framed_of (v : json) : framed =
    {id = post_id (at_key "id" v); text = unescaped (at_key "text" v); history = v |> field "edit_history_post_ids" |> texts |> each post_id; urls = urls_in v; parent = optional_post (replied_to_in v)}

:= root_of (doc : json) : root_reply =
    := d = doc |> field "data"
    root_reply {conversation_id = conversation_id (at_key "conversation_id" d); author_id = user_id (at_key "author_id" d); created_at = at_key "created_at" d; missing = first_error doc}

:= decode_thread \* r. (q : threads r) (doc : json) : r =
    ?= q ?|
    | ThreadRoot _ => root_of doc
    | ThreadPage _ => thread_page {framed = doc |> field "data" |> collect framed_of; next_token = next_token_in doc}

:= decode_read \* r. (q : reads r) (doc : json) : r =
    ?= q ?|
    | Users _ => users_of_doc doc
    | FollowedBy _ => page_of_doc doc
    | PostsOf (a, _) => posts_of_doc a.username doc
    | PostsById _ => posts_of_doc "" doc

:= created_of (d : json) : created_reply = created_reply {id = post_id (at_key "id" d); text = at_key "text" d}

:= decode_write \* r. (q : writes r) (doc : json) : r =
    := d = doc |> field "data"
    ?= q ?|
    | CreatePost _ | ReplyPost _ => created_of d
    | DeletePost _ => deleted_reply {deleted = d |> field "deleted" |> flag_of_json}

:= clipped (n : i32) (text : string) : string =
    ? sm'.length text <= n ?> text |: sm'.slice 0i32 (n - 1i32) text ++# "..."

:= distinct_parts (title : string) (detail : string) : bool = title <> "" && detail <> "" && title <> detail

:= title_and_detail (title : string) (detail : string) (body : string) : string =
    ? distinct_parts title detail ?> title ++# ": " ++# detail
    |? detail <> "" ?> detail
    |? title <> "" ?> title
    |: clipped 300i32 (single_line body)

:= problem_detail (body : string) : string =
    := doc = parse_json body
    title_and_detail (at_key "title" doc) (at_key "detail" doc) body

:= accepted (status : i32) : bool = status >= 200i32 && status < 300i32

:= ids_of (l : list post) : post_ids = l |> each (\ (p : post) => p.id)

:= refs_of (l : list post) : post_ids = l |> spread (\ (p : post) => p.refs |> each (\ (r : reference) => r.id))

:= distinct (l : list string) : list string =
    listm.fold (\ acc x => ? has ((=) x) acc ?> acc |: listm.append acc [x]) Nil l

:= distinct_posts (l : post_ids) : post_ids =
    listm.fold (\ acc x => ? has (same_post x) acc ?> acc |: listm.append acc [x]) Nil l

:= without_ids (ids : post_ids) (l : list post) : list post =
    l |> keep (\ (p : post) => not (has (same_post p.id) ids))

:= absorb (old : pool) (fresh : pool) : pool =
    merge_pools fresh {old ?| posts = without_ids (ids_of fresh.posts) old.posts}

:= wanted_of (c : following_cap) : i32 =
    ?= c ?|
    | AtMost n => n
    | AllFollowing => 2147483647i32

:= page_size (remaining : i32) : i32 = ? remaining < 1000i32 ?> remaining |: 1000i32

:= answered (status : i32) (resource : string) (detail : string) : string =
    "X API answered " ++# sm'.obj_to_string status ++# " for " ++# resource ++# ": " ++# detail

:= unreached (resource : string) (detail : string) : string =
    "could not reach the X API for " ++# resource ++# ": " ++# detail

:= unexpected (resource : string) (body : string) : string =
    "unexpected X API reply for " ++# resource ++# ": " ++# body

:= no_account (h : string) : string = "no X account @" ++# h

:= decodable (resource : string) (body : string) : result string string =
    ? absent (parse_json body) ?> Error (unexpected resource (clipped 300i32 body)) |: Ok body

:= refusal (resource : string) (status : i32) (body : string) : string =
    ? status = 0i32 ?> unreached resource body |: answered status resource (problem_detail body)

:~ classified (resource : string) (status : i32) (body : string) : result string string =
    ? accepted status ?> decodable resource body |: Error (refusal resource status body)

:= pages_text (s : cursor_stop) : string = sm'.obj_to_string s.pages ++# " pages"

:= cursor_halt_text (h : cursor_halt) : string =
    ?= h ?|
    | CursorRepeated s => "the API repeated cursor " ++# s.token ++# " after " ++# pages_text s
    | CursorBudget s => "stopped after " ++# pages_text s ++# " (page budget)"

:= cursor_text (x : halted_cursor) : string = x.resource ++# ": " ++# cursor_halt_text x.halt

:= other_failure (f : failure) : string =
    ?= f ?|
    | NoSuchAccount h => no_account h
    | CursorHalted x => cursor_text x
    | _ => ""

:~ describe_failure (f : failure) : string =
    ?= f ?|
    | Reported text => text
    | _ => other_failure f

:= plain_query () : query = {max_results = 5i32; filters = no_filters (); depth = 0i32; hints = !-}

:= erin () : account = {id = user_id "7"; username = "erin"}

:= fields_query () : string = "&post.fields=created_at,author_id,public_metrics,entities,attachments"

:= plain_posts () : string = "/2/users/7/tweets?max_results=5" ++# fields_query ()

:= expansions_query () : string =
    "&expansions=referenced_posts,referenced_posts.author_id,attachments.media_keys&media.fields=type,alt_text"

///> zig
test users_lookup_path =
    := ~h = "alice"
    read_path (Users (Named [h; "bob"])) |> _assert_eq "/2/users/by?usernames=alice,bob"

///> zig
test following_path_carries_the_token =
    := ~pagination_token = "t1"
    read_path (FollowedBy {follower = user_id "42"; size = 2i32; pagination_token})
    |> _assert_eq "/2/users/42/following?max_results=2&pagination_token=t1"

///> zig
test first_following_page_has_no_token =
    := ~size = 1000i32
    read_path (FollowedBy {follower = user_id "42"; size; pagination_token = ""}) |> _assert_eq "/2/users/42/following?max_results=1000"

///> zig
test plain_posts_path_asks_for_no_expansions =
    := ~n = 5i32
    := q = plain_query ()
    read_path (PostsOf (erin (), {q ?| max_results = n})) |> _assert_eq (plain_posts ())

///> zig
test posts_below_the_api_floor_ask_for_five =
    := ~n = 1i32
    := q = plain_query ()
    read_path (PostsOf (erin (), {q ?| max_results = n})) |> _assert_eq (plain_posts ())

:= filtered (f : filters) : string =
    := q = plain_query ()
    read_path (PostsOf (erin (), {q ?| filters = f}))

///> zig
test start_time_is_sent =
    := ~start_time = "2026-10-15T00:00:00Z"
    := f = no_filters ()
    filtered {f ?| start_time} |> _assert_eq (plain_posts () ++# "&start_time=" ++# start_time)

:= archive_page (start_time : string) : string =
    "/2/tweets/search/all?query=conversation_id%3A7%20from%3A5&start_time=" ++# start_time
    ++# "&max_results=100&post.fields=conversation_id,entities,referenced_posts"

:= root_search (start_time : string) : thread_search = {conversation_id = conversation_id "7"; author_id = user_id "5"; start_time}

///> zig
test thread_pages_search_the_archive_from_the_root =
    := ~start_time = "2026-09-01T18:12:00Z"
    thread_path (ThreadPage (root_search start_time, "t2"))
    |> _assert_eq (archive_page start_time ++# "&next_token=t2")

///> zig
test originals_exclude_replies_and_reposts =
    := ~on = !+
    := f = no_filters ()
    filtered {f ?| no_replies = on; no_reposts = on} |> _assert_eq (plain_posts () ++# "&exclude=replies,retweets")

///> zig
test depth_and_hints_add_expansions =
    := ~depth = 1i32
    := q = plain_query ()
    read_path (PostsById ([post_id "1"; post_id "2"], {q ?| depth; hints = !+}))
    |> _assert_eq ("/2/tweets?ids=1,2" ++# fields_query () ++# expansions_query ())

///> zig
test writes_use_their_verbs_and_paths =
    := ~id = post_id "9"
    write_path (DeletePost id) |> _assert_eq "/2/tweets/9"
    ?= write_verb (DeletePost id) ?|
    | Remove => ()
    | _ => _assert_eq "Remove" "other"

///> zig
test endpoint_drops_a_trailing_slash =
    := ~base = "http://127.0.0.1:9/"
    base_of (app_api base "k") |> _assert_eq "http://127.0.0.1:9"

///> zig
test page_size_never_exceeds_the_api_maximum =
    := ~remaining = 2147483647i32
    page_size remaining |> _assert_eq 1000i32

///> zig
test a_users_lookup_is_not_a_posts_read fails "Expected: reads posts_reply" =
    := q : reads posts_reply = Users (Named ["alice"])
    read_path q |> ignore

///> zig
test a_deletion_does_not_reply_with_a_created_post fails "Expected: writes created_reply" =
    := q : writes created_reply = DeletePost (post_id "9")
    write_path q |> ignore

///> zig
test the_app_token_cannot_write fails "Expected: api user_context" =
    := a : api user_context = app_api "http://127.0.0.1:9" "k"
    a |> ignore

:= quoted_text (s : string) : string = "\"" ++# s ++# "\""

:= member (k : string) (v : string) : string = quoted_text k ++# ":" ++# v

:= object (l : list string) : string = "{" ++# sm'.concat_list "," l ++# "}"

:= items (l : list string) : string = "[" ++# sm'.concat_list "," l ++# "]"

:= metrics_json () : string = object [member "reply_count" "2"; member "repost_count" "1"; member "like_count" "14"]

:= quote_json () : string = items [object [member "type" (quoted_text "quoted"); member "id" (quoted_text "2")]]

:= post_json () : string =
    := named = [member "id" (quoted_text "1"); member "author_id" (quoted_text "7"); member "text" (quoted_text "hi")]
    object (listm.append named [member "public_metrics" (metrics_json ()); member "referenced_posts" (quote_json ())])

:= posts_doc () : json = parse_json (object [member "data" (items [post_json ()])])

:= post_summary (p : post) : string =
    := refs = refs_text p.refs
    post_text p.id ++# " " ++# p.author_username ++# " " ++# sm'.obj_to_string p.public_metrics.like_count ++# " " ++# refs

///> rust -d serde_json
test posts_decode_ids_counts_and_references =
    ?= posts_of_doc "erin" (posts_doc ()) ?|
    | posts_reply {primary} => primary |> each post_summary |> sm'.concat_list "|" |> _assert_eq "1 erin 14 quoted:2"

:= account_names (l : accounts) : string = l |> each (\ (a : account) => user_text a.id ++# ":" ++# a.username) |> sm'.concat_list ","

:= users_doc () : json =
    := bob = object [member "id" (quoted_text "9"); member "username" (quoted_text "bob")]
    parse_json (object [member "data" (items [bob]); member "errors" (items [object [member "value" (quoted_text "ghost")]])])

///> rust -d serde_json
test users_lookup_names_found_and_unknown =
    ?= users_of_doc (users_doc ()) ?|
    | users_reply {found unknown} => account_names found ++# " " ++# sm'.concat_list "," unknown |> _assert_eq "9:bob ghost"

:= next_page_doc () : json = parse_json (object [member "data" (items []); member "meta" (object [member "next_token" (quoted_text "n2")])])

///> rust -d serde_json
test a_page_carries_its_next_token =
    ?= page_of_doc (next_page_doc ()) ?|
    | page_reply {next_token} => next_token |> _assert_eq "n2"

///> rust -d serde_json
test errors_prefer_their_detail =
    := problem = object [member "title" (quoted_text "T"); member "detail" (quoted_text "D")]
    parse_json (object [member "errors" (items [problem])]) |> first_error |> _assert_eq "D"

///> rust -d serde_json
test text_comes_back_unescaped =
    := ~escaped = "a |&gt; b &amp;&amp; c &lt;d&gt; &amp;lt;"
    unescaped escaped |> _assert_eq "a |> b && c <d> &lt;"

///> rust -d serde_json
test replies_name_their_parent =
    write_verb (ReplyPost ("hi", created_reply {id = post_id "7"; text = "c1 1/2"})) |> body_of_verb |> _assert_eq "{\"reply\":{\"in_reply_to_tweet_id\":\"7\"},\"text\":\"hi\"}"

:= blank_keys () : oauth1 = {consumer_key = ""; consumer_secret = ""; token = ""; token_secret = ""}

///> rust -d serde_json
test only_a_user_context_is_signed =
    := ~nonce = "n"
    ?= signed_api "https://api.x.com" (blank_keys ()) nonce "1" ?|
    | api {auth} => header_kind auth |> _assert_eq "signed"

///> rust -d serde_json
test an_app_token_cannot_be_signed fails "Unification failure" =
    := a : authorizer app_context = Signed (blank_keys (), "n", "1")
    a
