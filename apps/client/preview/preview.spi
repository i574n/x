///- --package ..
///> rust -d serde_json
test preview static =
    :< testing

:< sm'_operators
:< prelude
:< wire

:== framed_post = { text : string; weight : i32 }

:= framed_post_of (v : json) : framed_post = { text = at_key "text" v; weight = v |> field "weight" |> number_of }

:= framed_text (site : string) (text : string) : string = $'xc_frames::xc_frames(&*!site, &*!text)'

:= framed_posts (site : string) (text : string) : list framed_post =
    framed_text site text |> parse_json |> collect framed_post_of

:= post_price_thousandths () : i32 = 15i32

:= dollars (thousandths : i32) : string =
    := rest = thousandths % 1000i32
    := pad = ? rest < 10i32 ?> "00" |? rest < 100i32 ?> "0" |: ""
    "$" ++# sm'::obj_to_string (thousandths / 1000i32) ++# "." ++# pad ++# sm'::obj_to_string rest

:= previewed (n : i32) (k : i32) (p : framed_post) : string =
    "--- post "
    ++# sm'::obj_to_string k
    ++# " of "
    ++# sm'::obj_to_string n
    ++# ", weight "
    ++# sm'::obj_to_string p::weight
    ++# "\n"
    ++# p::text

:~ ^ previews (n : i32) (k : i32) (l : list framed_post) (acc : list string) : list string =
    ?= l ?|
    | Nil => listm::rev acc
    | p :: rest => previews n (k + 1i32) rest (previewed n k p :: acc)

:= cost_of (site : string) (n : i32) : string =
    ? site = "x" ?> ", " ++# dollars (n * post_price_thousandths ()) ++# " to create" |: ""

:= summary (site : string) (n : i32) : string = "\n--- " ++# sm'::obj_to_string n ++# " posts" ++# cost_of site n

:~ preview (site : string) (text : string) : string =
    := posts = framed_posts site text
    := n = listm::length posts
    sm'::concat_list "\n" (previews n 1i32 posts Nil) ++# summary site n

test previews_price_every_post =
    := ~n = 15i32
    dollars n |> _assert_eq "$0.015"
    dollars 1725i32 |> _assert_eq "$1.725"
    (summary "x" 2i32, summary "mastodon" 2i32) |> _assert_eq ("\n--- 2 posts, $0.030 to create", "\n--- 2 posts")

test a_framed_post_keeps_its_text_and_weight =
    := ~text = "c1 1/1\na"
    "[{\"text\":\"c1 1/1\\na\",\"weight\":8}]"
    |> parse_json
    |> collect framed_post_of
    |> each (\ p => p::text, p::weight)
    |> _assert_eq [ text, 8i32 ]

///> _
:= main () : i32 =
    export "xc_preview" ((\ (site, t) => preview site t) : string * string -> string)
    0i32
