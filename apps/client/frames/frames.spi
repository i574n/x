///- --package ..
///> rust -d serde_json unicode-segmentation=1.13 unicode-normalization=0.1
test frames static =
    open testing

open sm'_operators
open prelude
open splitter

inl post_json (t : string) : string =
    inl w = x_weight t
    $'Rc::<str>::from(serde_json::json\!({"text": &*!t, "weight": !w}).to_string())'

let framed_json (text : string) : string = "[" ++# (posts_of text |> each post_json |> sm'.concat_list ",") ++# "]"

test each_post_carries_its_weight =
    inl ~text = "a"
    framed_json text |> _assert_eq "[{\"text\":\"c1 1/1\\na\",\"weight\":8}]"

///> _
inl main () : i32 =
    !!!!Export("xc_frames", ((fun t => framed_json t) : string -> string))
    !!!!Export("xc_preview", ((fun t => preview t) : string -> string))
    0i32