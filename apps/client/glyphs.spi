///- --package .
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test glyphs static =
    :< testing

:< sm'_operators
:< prelude

:= char_of (n : i32) : string = unicode.char_of n

:= zero_width_space () : string = char_of 8203i32

:= defused_dot () : string = zero_width_space () ++# "."

:= graphemes (s : string) : list string = unicode.graphemes s

:= rust_weight (s : string) : i32 =
    $'(&*!s).chars().map(|c| match c as u32 { 0..=4351 | 8192..=8205 | 8208..=8223 | 8242..=8247 => 1, _ => 2 }).sum::<i32>()'

:= gleam_light () : () =
    global "fn x_light(n: Int) -> Bool { n <= 4351 || n >= 8192 && n <= 8205 || n >= 8208 && n <= 8223 || n >= 8242 && n <= 8247 }"

:= gleam_weight (s : string) : i32 =
    gleam_light ()
    global "import gleam/list"
    global "import gleam/string"
    $'string.to_utf_codepoints(!s) |> list.fold(0, fn(sum, c) { sum + case x_light(string.utf_codepoint_to_int(c)) { True -> 1 False -> 2 } })'

:= plain_weight (s : string) : i32 =
    backend_switch {
        Gleam = \ () => gleam_weight s
        Rust = \ () => rust_weight s
    }

:= first_code_point (s : string) : i32 = unicode.first_code_point s

:= code_point_count (s : string) : i32 = unicode.code_point_count s

:= holds_code_point (n : i32) (s : string) : bool = sm'.index_of (char_of n) s >= 0i32

:= pictograph_led (first : i32) : bool = first >= 126976i32

:= symbol_led (first : i32) : bool =
    (first >= 8192i32 && first <= 11263i32) || first = 169i32 || first = 174i32 || first = 12336i32 || first = 12349i32 || first = 12951i32 || first = 12953i32

:= keycap_led (first : i32) : bool = first = 35i32 || first = 42i32 || (first >= 48i32 && first <= 57i32)

:= emoji_presented (g : string) (first : i32) : bool = holds_code_point 65039i32 g && symbol_led first

:= keycap (g : string) (first : i32) : bool = holds_code_point 8419i32 g && keycap_led first

:= emoji_entity (g : string) : bool =
    := first = first_code_point g
    code_point_count g > 1i32 && (pictograph_led first || emoji_presented g first || keycap g first)

:= glyph_weight (g : string) : i32 = ? emoji_entity g ?> 2i32 |: plain_weight g

:= nfc (s : string) : string = unicode.nfc s

:= ascii_letters () : string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

:= one_of (chars : string) (g : string) : bool = sm'.length g = 1i32 && sm'.index_of g chars >= 0i32

:= letter (g : string) : bool = one_of (ascii_letters ()) g

:= label_char (g : string) : bool = one_of (ascii_letters () ++# "0123456789_-") g

:= rust_blank (s : string) : bool = $'(&*!s).trim().is_empty()'

:= gleam_white () : () =
    global "fn x_white(n: Int) -> Bool { n >= 9 && n <= 13 || n == 32 || n == 133 || n == 160 || n == 5760 || n >= 8192 && n <= 8202 }"

:= gleam_spaced () : () =
    gleam_white ()
    global "fn x_spaced(n: Int) -> Bool { x_white(n) || n == 8232 || n == 8233 || n == 8239 || n == 8287 || n == 12288 }"

:= gleam_blank (s : string) : bool =
    gleam_spaced ()
    global "import gleam/list"
    global "import gleam/string"
    $'string.to_utf_codepoints(!s) |> list.all(fn(c) { x_spaced(string.utf_codepoint_to_int(c)) })'

:= blank (s : string) : bool =
    backend_switch {
        Gleam = \ () => gleam_blank s
        Rust = \ () => rust_blank s
    }

:! gleam_pieces = $'List(String)'

:= gleam_binary_split () : () =
    global "type XSplitScope { Global }"
    global """
        @ external(erlang, "binary", "split")
        fn x_binary_split(s: String, sep: String, options: List(XSplitScope)) -> List(String)
        """

:= gleam_split (sep : string) (s : string) : gleam_pieces =
    gleam_binary_split ()
    $'x_binary_split(!s, !sep, [Global])'

:= gleam_done (l : gleam_pieces) : bool = $'case !l { [] -> True _ -> False }'

:= gleam_head (l : gleam_pieces) : string = $'case !l { [h, ..] -> h [] -> "" }'

:= gleam_tail (l : gleam_pieces) : gleam_pieces = $'case !l { [_, ..t] -> t [] -> [] }'

:~ ^ listed_pieces (l : gleam_pieces) (acc : list string) : list string =
    ? gleam_done l ?> listm.rev acc |: listed_pieces (gleam_tail l) (Cons (gleam_head l, acc))

:= split_all (sep : string) (s : string) : list string =
    backend_switch {
        Gleam = \ () => listed_pieces (gleam_split sep s) Nil
        Rust = \ () => split_on sep s
    }

:= all_pieces (sep : string) (s : string) : list string = ? s = "" ?> Nil |: split_all sep s

:~ ^ without_blank_tail (l : list string) : list string =
    ?= l ?|
    | Cons (g, rest) ?& blank g => without_blank_tail rest
    | _ => l

:= trimmed_end (s : string) : string = graphemes s |> listm.rev |> without_blank_tail |> listm.rev |> sm'.concat_list ""

:= thumb () : string = char_of 128077i32 ++# char_of 127997i32

:= accented () : string = "e" ++# char_of 769i32

test graphemes_hold_clusters =
    := ~s = "a" ++# accented () ++# " " ++# thumb () ++# "."
    graphemes s |> listm.length |> _assert_eq 5i32
    graphemes "" |> listm.length |> _assert_eq 0i32

:= crlf () : string = char_of 13i32 ++# char_of 10i32

test a_line_break_pair_is_one_grapheme =
    := ~s = "a" ++# crlf () ++# "b"
    graphemes s |> listm.length |> _assert_eq 3i32

test weights_follow_x =
    := ~s = "abc"
    plain_weight s |> _assert_eq 3i32
    plain_weight (char_of 26085i32) |> _assert_eq 2i32
    plain_weight (thumb ()) |> _assert_eq 4i32
    plain_weight (char_of 8212i32 ++# zero_width_space ()) |> _assert_eq 2i32

:= family () : string =
    char_of 128104i32 ++# char_of 8205i32 ++# char_of 128105i32 ++# char_of 8205i32 ++# char_of 128103i32 ++# char_of 8205i32 ++# char_of 128102i32

:= japan () : string = char_of 127471i32 ++# char_of 127477i32

:= keycap_one () : string = "1" ++# char_of 65039i32 ++# char_of 8419i32

:= red_heart () : string = char_of 10084i32 ++# char_of 65039i32

:= letter_vs16 () : string = "a" ++# char_of 65039i32

test emoji_entities_weigh_two =
    := ~g = thumb ()
    (glyph_weight g, glyph_weight (family ()), glyph_weight (red_heart ()), glyph_weight (keycap_one ()), glyph_weight (japan ()))
        |> _assert_eq (2i32, 2i32, 2i32, 2i32, 2i32)

test other_clusters_keep_code_point_weights =
    := ~g = accented ()
    (glyph_weight g, glyph_weight (letter_vs16 ()), glyph_weight (char_of 26085i32), glyph_weight (char_of 169i32), glyph_weight "a")
        |> _assert_eq (2i32, 3i32, 2i32, 1i32, 1i32)

test blanks_and_tails =
    := ~s = "x \t\n"
    trimmed_end s |> _assert_eq "x"
    blank (char_of 160i32) |> _assert_eq !+
    blank (zero_width_space ()) |> _assert_eq !-
    trimmed_end ("a" ++# char_of 160i32) |> _assert_eq "a"

:= rejoined (sep : string) (s : string) : string = split_all sep s |> sm'.concat_list "|"

test split_all_keeps_empty_pieces =
    := ~s = "a\n" ++# char_of 26085i32 ++# "\n\nb\n"
    rejoined "\n" s |> _assert_eq ("a|" ++# char_of 26085i32 ++# "||b|")
    all_pieces "\n" "" |> listm.length |> _assert_eq 0i32
    rejoined "," "x" |> _assert_eq "x"

test nfc_composes =
    := ~s = accented ()
    nfc s |> _assert_eq (char_of 233i32)
    letter "a" |> _assert_eq !+
    label_char "-" |> _assert_eq !+
    letter "." |> _assert_eq !-
