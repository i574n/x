///- --package ..
///> rust -d serde_json
test write static =
    :< testing

:< sm'_operators
:< prelude
:< protocol
:< oauth1
:< wire
:< transport

:~ send_write \* r. (a : api user_context) (q : writes r) : got r =
    ?= a ?|
    | api e => raw_reply e (write_verb q) (write_path q) |> map_ok \ (doc, _) => decode_write q doc

:= user_side (base : string) (token : string) (o : oauth1) (nonce : string) (stamp : string) : api user_context =
    ? token <> "" ?> user_api base token |: signed_api base o nonce stamp

:= posted (r : got created_reply) : i32 * string =
    ?= r ?|
    | Ok (created_reply {id}) => 0i32, "posted " ++# post_text id
    | Error f => 4i32, describe_failure f

:= removed (id : string) (r : got deleted_reply) : i32 * string =
    ?= r ?|
    | Ok (deleted_reply {deleted}) => ? deleted ?> 0i32, "deleted " ++# id |: 4i32, "not deleted " ++# id
    | Error f => 4i32, describe_failure f

:~ write (a : api user_context) (kind : i32) (payload : string) : i32 * string =
    ? kind = 1i32 ?> send_write a (CreatePost payload) |> posted
    |: send_write a (DeletePost (post_id payload)) |> removed payload

:== write_args = string * string * string * string * string * string * string * string * i32 * string

:= nonce_at (nonce : string) (k : i32) : string = ? k = 0i32 ?> nonce |: nonce ++# sm'.obj_to_string k

:= side_of (x : write_args) (k : i32) : api user_context =
    := base, token, ck, cs, t, ts, nonce, stamp, _, _ = x
    user_side base token {consumer_key = ck; consumer_secret = cs; token = t; token_secret = ts} (nonce_at nonce k) stamp

:| chain =
    | Unstarted
    | After : created_reply

:= next_post (last : chain) (text : string) : writes created_reply =
    ?= last ?|
    | Unstarted => CreatePost text
    | After parent => ReplyPost (text, parent)


:== side = i32 -> api user_context

:== posting = {last : chain; lines : list string; ids : list string; resumed : bool}

:= continue_hint (p : posting) : string =
    ?= listm.rev p.ids ?|
    | _ ?& p.resumed => "; continue with the same --resume command"
    | root :: _ => "; continue with: xc post-thread --resume " ++# root ++# " FILE"
    | Nil => ""

:= stopped (p : posting) (f : failure) : i32 * string =
    := before = ? listm.length p.ids = 0i32 ?> "" |: "; posted before it: " ++# sm'.concat_list " " (listm.rev p.ids)
    4i32, describe_failure f ++# before ++# continue_hint p

:= id_of (r : created_reply) : string =
    ?= r ?|
    | created_reply {id} => post_text id

:= advanced (p : posting) (r : created_reply) (text : string) : posting =
    := id = id_of r
    {p ?| last = After r; lines = "posted " ++# id ++# " " ++# first_line text :: p.lines; ids = id :: p.ids}

:= sent (s : side) (p : posting) (text : string) : got created_reply =
    send_write (s (listm.length p.ids + 1i32)) (next_post p.last text)

:= all_posted (p : posting) : i32 * string = 0i32, sm'.concat_list "\n" (listm.rev p.lines)

:~ ^ chained (s : side) (l : list string) (p : posting) : i32 * string =
    ?= l ?|
    | Nil => all_posted p
    | text :: rest =>
        ?= sent s p text ?|
        | Ok r => chained s rest (advanced p r text)
        | Error f => stopped p f

:= removal_line (id : string) (r : got deleted_reply) : result string string =
    ?= r ?|
    | Ok (deleted_reply {deleted}) => ? deleted ?> Ok ("deleted " ++# id) |: Error ("not deleted " ++# id)
    | Error f => Error (describe_failure f)

:== removal = {lines : list string; failed : bool}

:= with_line (acc : removal) (line : result string string) : removal =
    ?= line ?|
    | Ok text => {acc ?| lines = text :: acc.lines}
    | Error message => {lines = message :: acc.lines; failed = !+}

:= removed_one (s : side) (acc : removal) (id : string) : removal =
    removal_line id (send_write (s (listm.length acc.lines + 1i32)) (DeletePost (post_id id))) |> with_line acc

:= removal_reply (r : removal) : i32 * string = (? r.failed ?> 4i32 |: 0i32), sm'.concat_list "\n" (listm.rev r.lines)

:~ removed_all (s : side) (ids : list string) : i32 * string = listm.fold (removed_one s) {lines = Nil; failed = !-} ids |> removal_reply

:= first_posting () : posting = {last = Unstarted; lines = Nil; ids = Nil; resumed = !-}

:= resumed_line (posted : i32) (total : i32) : string = "resumed after post " ++# sm'.obj_to_string posted ++# " of " ++# sm'.obj_to_string total

:= resumed_posting (last : string) (posted : i32) (total : i32) : posting =
    := parent = created_reply {id = post_id last; text = ""}
    {last = After parent; lines = [resumed_line posted total]; ids = Nil; resumed = !+}

:= resume_plan_of (payload : string) : i32 * i32 * string = $'xc_resume::xc_resume_plan(&*!payload)'

:= resumed_rest (s : side) (last : string) (posted : i32) (text : string) : i32 * string =
    := remaining = parse_json text |> collect text_of
    chained s remaining (resumed_posting last posted (posted + listm.length remaining))

:~ resume_written (s : side) (last : string) (payload : string) : i32 * string =
    := code, posted, text = resume_plan_of payload
    ? code <> 0i32 ?> 4i32, text |: resumed_rest s last posted text

:= last_found (l : list string) : string = listm.fold (\ _ s => s) "" l

:= last_id_in (found : json) : string = found |> collect (at_key "id") |> last_found

:= resume_of (x : write_args) (payload : string) : i32 * string =
    resume_written (side_of x) (parse_json payload |> field "found" |> last_id_in) payload

:= thread_written (x : write_args) (kind : i32) (payload : string) : i32 * string =
    ? kind = 9i32 ?> removed_all (side_of x) (pieces "\n" payload)
    |: chained (side_of x) (parse_json payload |> collect (at_key "text")) (first_posting ())

:= written (x : write_args) : i32 * string =
    := _, _, _, _, _, _, _, _, kind, payload = x
    ? kind = 10i32 ?> resume_of x payload
    |? kind >= 7i32 ?> thread_written x kind payload
    |: write (side_of x 0i32) kind payload

:= removal_of (l : list (result string string)) : i32 * string = l |> listm.fold with_line {lines = Nil; failed = !-} |> removal_reply

:= removal_text (r : i32 * string) : string =
    := code, text = r
    sm'.obj_to_string code ++# "|" ++# text

test a_failed_delete_still_reports_every_post =
    := ~gone = "deleted 1"
    [Ok gone; Error "not deleted 2"; Ok "deleted 3"] |> removal_of |> removal_text |> _assert_eq "4|deleted 1\nnot deleted 2\ndeleted 3"

test post_lines_name_only_the_header =
    := ~text = "c1 1/2\ninl a = 1"
    first_line text |> _assert_eq "c1 1/2"
    first_line "c2 1/1" |> _assert_eq "c2 1/1"

:= rate_limited () : failure = Reported (answered 429i32 "/2/tweets" "Too Many Requests")

:= stop_text (p : posting) : string = stopped p (rate_limited ()) |> \ (_, text) => text

test a_stopped_thread_names_its_resume_command =
    := ~root = "1"
    := p = first_posting ()
    stop_text {p ?| ids = ["2"; root]} |> sm'.ends_with "; continue with: xc post-thread --resume 1 FILE" |> _assert_eq !+

test a_stopped_resume_says_to_repeat_it =
    := ~id = "2"
    := p = first_posting ()
    := r = stop_text {p ?| ids = [id]; resumed = !+}
    (sm'.ends_with "same --resume command" r, sm'.contains "continue" (stop_text p)) |> _assert_eq (!+, !-)

///> _
:= main () : i32 =
    !!!!Export("xc_write", ((\ x => written x) : write_args -> i32 * string))
    0i32
