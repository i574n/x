///- --package ..
///> rust -d serde_json
test write static =
    open testing

open sm'_operators
open prelude
open protocol
open oauth1
open wire
open transport

let send_write forall r. (a : api user_context) (q : writes r) : got r =
    match a with
    | api e => raw_reply e (write_verb q) (write_path q) |> map_ok fun (doc, _) => decode_write q doc

inl user_side (base : string) (token : string) (o : oauth1) (nonce : string) (stamp : string) : api user_context =
    if token <> "" then user_api base token else signed_api base o nonce stamp

inl posted (r : got created_reply) : i32 * string =
    match r with
    | Ok (created_reply {id}) => 0i32, "posted " ++# post_text id
    | Error f => 4i32, describe_failure f

inl removed (id : string) (r : got deleted_reply) : i32 * string =
    match r with
    | Ok (deleted_reply {deleted}) => if deleted then 0i32, "deleted " ++# id else 4i32, "not deleted " ++# id
    | Error f => 4i32, describe_failure f

let write (a : api user_context) (kind : i32) (payload : string) : i32 * string =
    if kind = 1i32 then send_write a (CreatePost payload) |> posted
    else send_write a (DeletePost (post_id payload)) |> removed payload

type write_args = string * string * string * string * string * string * string * string * i32 * string

inl nonce_at (nonce : string) (k : i32) : string = if k = 0i32 then nonce else nonce ++# sm'.obj_to_string k

inl side_of (x : write_args) (k : i32) : api user_context =
    inl base, token, ck, cs, t, ts, nonce, stamp, _, _ = x
    user_side base token {consumer_key = ck; consumer_secret = cs; token = t; token_secret = ts} (nonce_at nonce k) stamp

union chain =
    | Unstarted
    | After : created_reply

inl next_post (last : chain) (text : string) : writes created_reply =
    match last with
    | Unstarted => CreatePost text
    | After parent => ReplyPost (text, parent)

inl header_line (text : string) : string =
    inl i : i32 = sm'.index_of "\n" text
    if i < 0i32 then text else sm'.substring 0i32 i text

type side = i32 -> api user_context

type posting = {last : chain; lines : list string; ids : list string; resumed : bool}

inl continue_hint (p : posting) : string =
    match listm.rev p.ids with
    | _ when p.resumed => "; continue with the same --resume command"
    | Cons (root, _) => "; continue with: xc post-thread --resume " ++# root ++# " FILE"
    | Nil => ""

inl stopped (p : posting) (f : failure) : i32 * string =
    inl before = if listm.length p.ids = 0i32 then "" else "; posted before it: " ++# sm'.concat_list " " (listm.rev p.ids)
    4i32, describe_failure f ++# before ++# continue_hint p

inl id_of (r : created_reply) : string =
    match r with
    | created_reply {id} => post_text id

inl advanced (p : posting) (r : created_reply) (text : string) : posting =
    inl id = id_of r
    {p with last = After r; lines = Cons ("posted " ++# id ++# " " ++# header_line text, p.lines); ids = Cons (id, p.ids)}

inl sent (s : side) (p : posting) (text : string) : got created_reply =
    send_write (s (listm.length p.ids + 1i32)) (next_post p.last text)

inl all_posted (p : posting) : i32 * string = 0i32, sm'.concat_list "\n" (listm.rev p.lines)

let rec chained (s : side) (l : list string) (p : posting) : i32 * string =
    match l with
    | Nil => all_posted p
    | Cons (text, rest) =>
        match sent s p text with
        | Ok r => chained s rest (advanced p r text)
        | Error f => stopped p f

inl removal_line (id : string) (r : got deleted_reply) : result string string =
    match r with
    | Ok (deleted_reply {deleted}) => if deleted then Ok ("deleted " ++# id) else Error ("not deleted " ++# id)
    | Error f => Error (describe_failure f)

type removal = {lines : list string; failed : bool}

inl with_line (acc : removal) (line : result string string) : removal =
    match line with
    | Ok text => {acc with lines = Cons (text, acc.lines)}
    | Error message => {lines = Cons (message, acc.lines); failed = true}

inl removed_one (s : side) (acc : removal) (id : string) : removal =
    removal_line id (send_write (s (listm.length acc.lines + 1i32)) (DeletePost (post_id id))) |> with_line acc

inl removal_reply (r : removal) : i32 * string = (if r.failed then 4i32 else 0i32), sm'.concat_list "\n" (listm.rev r.lines)

let removed_all (s : side) (ids : list string) : i32 * string = listm.fold (removed_one s) {lines = Nil; failed = false} ids |> removal_reply

inl first_posting () : posting = {last = Unstarted; lines = Nil; ids = Nil; resumed = false}

union resume_plan =
    | ResumeAfter : {posted : i32; remaining : list string}
    | PostDiffers : {at : i32; planned : string; found : string}
    | MorePostedThanPlanned : i32

inl differing (k : i32) (p : string) (f : string) : resume_plan =
    PostDiffers {at = k + 1i32; planned = header_line p; found = header_line f}

inl resume_end (k : i32) (planned : list string) (found : list string) : resume_plan =
    match found with
    | Nil => ResumeAfter {posted = k; remaining = planned}
    | _ => MorePostedThanPlanned (k + (listm.length found : i32))

let rec resume_from (k : i32) (planned : list string) (found : list string) : resume_plan =
    match planned, found with
    | Cons (p, ps), Cons (f, fs) => if p = f then resume_from (k + 1i32) ps fs else differing k p f
    | _ => resume_end k planned found

inl resume_count (n : i32) : string = sm'.obj_to_string n

inl differs_head (at : i32) : string =
    inl n = resume_count at
    "post " ++# n ++# " of the thread differs from post " ++# n ++# " of the file"

inl differs_text (at : i32) (found : string) (planned : string) : string =
    differs_head at ++# " (found '" ++# found ++# "', planned '" ++# planned ++# "'); nothing posted"

inl longer_text (n : i32) : string = "the thread already has " ++# resume_count n ++# " posts, more than the file plans; nothing posted"

inl resume_refusal (plan : resume_plan) : string =
    match plan with
    | PostDiffers d => differs_text d.at d.found d.planned
    | MorePostedThanPlanned n => longer_text n
    | ResumeAfter _ => "no posted thread found before the resume point; nothing posted"

inl resumed_line (posted : i32) (total : i32) : string = "resumed after post " ++# resume_count posted ++# " of " ++# resume_count total

inl resumed_posting (last : string) (posted : i32) (total : i32) : posting =
    inl parent = created_reply {id = post_id last; text = ""}
    {last = After parent; lines = [resumed_line posted total]; ids = Nil; resumed = true}

inl continued_after (s : side) (last : string) (plan : list string) (r : {posted : i32; remaining : list string}) : i32 * string =
    chained s r.remaining (resumed_posting last r.posted (listm.length plan))

let resume_written (s : side) (last : string) (plan : list string) (seen : list string) : i32 * string =
    match resume_from 0i32 plan seen with
    | ResumeAfter r when r.posted > 0i32 => continued_after s last plan r
    | refused => 4i32, resume_refusal refused

inl last_found (l : list string) : string = listm.fold (fun _ s => s) "" l

inl texts_in (v : json) : list string = v |> collect (at_key "text")

inl last_id_in (found : json) : string = found |> collect (at_key "id") |> last_found

inl resume_of (x : write_args) (payload : string) : i32 * string =
    inl doc = parse_json payload
    inl found = doc |> field "found"
    resume_written (side_of x) (last_id_in found) (texts_in (doc |> field "planned")) (texts_in found)

inl thread_written (x : write_args) (kind : i32) (payload : string) : i32 * string =
    if kind = 9i32 then removed_all (side_of x) (pieces "\n" payload)
    else chained (side_of x) (parse_json payload |> collect (at_key "text")) (first_posting ())

inl written (x : write_args) : i32 * string =
    inl _, _, _, _, _, _, _, _, kind, payload = x
    if kind = 10i32 then resume_of x payload
    elif kind >= 7i32 then thread_written x kind payload
    else write (side_of x 0i32) kind payload

inl removal_of (l : list (result string string)) : i32 * string = l |> listm.fold with_line {lines = Nil; failed = false} |> removal_reply

inl removal_text (r : i32 * string) : string =
    inl code, text = r
    sm'.obj_to_string code ++# "|" ++# text

test a_failed_delete_still_reports_every_post =
    inl ~gone = "deleted 1"
    [Ok gone; Error "not deleted 2"; Ok "deleted 3"] |> removal_of |> removal_text |> _assert_eq "4|deleted 1\nnot deleted 2\ndeleted 3"

inl plan_text (p : resume_plan) : string =
    match p with
    | ResumeAfter r when r.posted > 0i32 => "after " ++# resume_count r.posted ++# ": " ++# sm'.concat_list "|" r.remaining
    | refused => resume_refusal refused

test a_half_posted_thread_resumes_after_its_last_post =
    inl ~planned = ["c1 1/3\na"; "c1 2/3\nb"; "c1 3/3\nc"]
    resume_from 0i32 planned ["c1 1/3\na"; "c1 2/3\nb"] |> plan_text |> _assert_eq "after 2: c1 3/3\nc"

inl changed_refusal () : string = "post 2 of the thread differs from post 2 of the file (found 'c1 2/3', planned 'c1 2/3'); nothing posted"

test a_changed_post_refuses_the_resume =
    inl ~planned = ["c1 1/3\na"; "c1 2/3\nb"; "c1 3/3\nc"]
    resume_from 0i32 planned ["c1 1/3\na"; "c1 2/3\nB"] |> plan_text |> _assert_eq (changed_refusal ())

test a_longer_thread_refuses =
    inl ~planned = ["c1 1/1\na"]
    resume_from 0i32 planned ["c1 1/1\na"; "c2 1/1\nb"] |> plan_text
        |> _assert_eq "the thread already has 2 posts, more than the file plans; nothing posted"

test no_posted_thread_refuses =
    inl ~planned = ["c1 1/1\na"]
    resume_from 0i32 planned Nil |> plan_text |> _assert_eq "no posted thread found before the resume point; nothing posted"

test post_lines_name_only_the_header =
    inl ~text = "c1 1/2\ninl a = 1"
    header_line text |> _assert_eq "c1 1/2"
    header_line "c2 1/1" |> _assert_eq "c2 1/1"

inl rate_limited () : failure = HttpStatus {status = 429i32; resource = "/2/tweets"; detail = "Too Many Requests"}

inl stop_text (p : posting) : string = stopped p (rate_limited ()) |> fun (_, text) => text

test a_stopped_thread_names_its_resume_command =
    inl ~root = "1"
    inl p = first_posting ()
    stop_text {p with ids = ["2"; root]} |> sm'.ends_with "; continue with: xc post-thread --resume 1 FILE" |> _assert_eq true

test a_stopped_resume_says_to_repeat_it =
    inl ~id = "2"
    inl p = first_posting ()
    inl r = stop_text {p with ids = [id]; resumed = true}
    (sm'.ends_with "same --resume command" r, sm'.contains "continue" (stop_text p)) |> _assert_eq (true, false)

///> _
inl main () : i32 =
    !!!!Export("xc_write", ((fun x => written x) : write_args -> i32 * string))
    0i32
