///- --package . --timeout 600000
///> rust
///> gleam
test paging static =
    :< testing

:< sm'_operators
:< prelude

:== page = { next_token : string; body : string }

:== pager e = string -> result page e

:== cursor_stop = { token : string; pages : i32 }

:| cursor_halt =
    | CursorRepeated : cursor_stop
    | CursorBudget : cursor_stop

:= page_budget () : i32 = 500i32

:== walk = { seen : list string; pages : i32; bodies : list string }

:= start_walk () : walk = { seen = Nil; pages = 0i32; bodies = Nil }

:= walk_step (w : walk) (p : page) : walk =
    { seen = p.next_token :: w.seen; pages = w.pages + 1i32; bodies = p.body :: w.bodies }

:= repeats (w : walk) (p : page) : bool = has (\ t => t = p.next_token) w.seen

:= halt_at (w : walk) (p : page) : option cursor_halt =
    ? repeats w p ?> Some (CursorRepeated { token = p.next_token; pages = w.pages + 1i32 }) |: None

:= walk_bodies (w : walk) (p : page) : list string = listm.rev (walk_step w p).bodies

:== walker e = { halted : cursor_halt -> e; budget : i32; fetch : pager e }

:~ ^ walked_from \* e. (k : walker e) (token : string) (w : walk) : result (list string) e =
    ? w.pages >= k.budget ?> Error (k.halted (CursorBudget { token pages = w.pages }))
    |: k.fetch token |> then_ok (next_of k w)

:& :~ next_of \* e. (k : walker e) (w : walk) (p : page) : result (list string) e =
    ? p.next_token = "" ?> Ok (walk_bodies w p) |: walk_on k w p

:& :~ walk_on \* e. (k : walker e) (w : walk) (p : page) : result (list string) e =
    ?= halt_at w p ?|
    | Some h => Error (k.halted h)
    | None => walked_from k p.next_token (walk_step w p)

:= all_pages \* e. (halted : cursor_halt -> e) (fetch : pager e) : result (list string) e =
    walked_from { halted budget = page_budget (); fetch } "" (start_walk ())

:= whole_second (created_at : string) : string =
    ? sm'.length created_at < 19i32 ?> created_at |: cut 0i32 19i32 created_at ++# "Z"

:= two_pages (token : string) : result page string =
    ? token = "" ?> Ok { next_token = "t2"; body = "a" }
    |? token = "t2" ?> Ok { next_token = ""; body = "b" }
    |: Error token

:= walked (r : result (list string) string) : string =
    ?= r ?|
    | Ok bodies => delimited "," bodies
    | Error e => "stopped at " ++# e

:= halt_text (h : cursor_halt) : string =
    ?= h ?|
    | CursorRepeated s => "repeated " ++# s.token ++# " after " ++# sm'.obj_to_string s.pages
    | CursorBudget s => "budget at " ++# sm'.obj_to_string s.pages

:= walk_with (budget : i32) (fetch : pager string) (first : string) : result (list string) string =
    walked_from { halted = halt_text; budget = budget; fetch = fetch } first (start_walk ())

test pages_follow_next_tokens =
    := ~first = ""
    walk_with 500i32 two_pages first |> walked |> _assert_eq "a,b"

:= broken (token : string) : result page string = ? token = "" ?> Ok { next_token = "bad"; body = "a" } |: Error token

test a_failed_page_stops_the_walk =
    := ~first = ""
    walk_with 500i32 broken first |> walked |> _assert_eq "stopped at bad"

:= looping (token : string) : result page string = Ok { next_token = "t1"; body = token }

test a_repeated_cursor_stops_the_walk =
    := ~first = ""
    walk_with 500i32 looping first |> walked |> _assert_eq "stopped at repeated t1 after 2"

:= endless (token : string) : result page string = Ok { next_token = token ++# "x"; body = "b" }

test the_page_budget_stops_an_endless_cursor =
    := ~first = ""
    walk_with 3i32 endless first |> walked |> _assert_eq "stopped at budget at 3"

test searches_start_at_a_whole_second =
    := ~at = "2026-10-18T12:00:00.000Z"
    whole_second at |> _assert_eq "2026-10-18T12:00:00Z"
    whole_second "2026" |> _assert_eq "2026"
