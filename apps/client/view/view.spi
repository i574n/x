open sm'_operators
open prelude
open posts

inl local_minute (stamp : string) : string = $'xc_net::xc_local_minute(&*!stamp)'

inl shown_lines (d : digest) (o : view_options) (shown : list entry) : string * i32 =
    shown |> spread (entry_lines d.pool o) |> sm'.concat_list "\n", listm.length shown

let rendered (text : string) (limit : i32) (per_author : i32) (depth : i32) (hints : bool) : string * i32 =
    inl d = digest_of text
    d.primary |> selected {limit per_author} |> shown_lines d {depth hints minute = local_minute}

type view_args = string * i32 * i32 * i32 * bool

inl main () : i32 =
    !!!!Export("xc_view", ((fun (text, limit, per_author, depth, hints) => rendered text limit per_author depth hints) : view_args -> string * i32))
    0i32