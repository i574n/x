///- --package ..
///> rust -d serde_json
test assemble static =
    :< testing

:< sm'_operators
:< prelude
:< posts
:< wire
:< protocol
:< reading

:= frame_of (v : json) : frame =
    heap { cell = cell_id (at_key "cell" v); k = field "k" v |> number_of; n = field "n" v |> number_of;
        body = at_key "body" v; original = post_id (at_key "original" v); parent = optional_post (at_key "parent" v) }

:== assembled_reply = i32 * string * string

:= reply_of (p : program) : assembled_reply =
    exit_code p.flaws, delimited """



        """ p.sources, p.flaws |> each note_of |> delimited "\n"

:~ assembled_of (located : string) : assembled_reply =
    := doc = parse_json located
    assembled (field "frames" doc |> collect frame_of) (field "known" doc |> collect text_of |> each post_id)
    |> reply_of

:= place_doc (cell : string) (k : i32) (n : i32) : list string =
    [ member "cell" (quoted_text cell); member "k" (sm'::obj_to_string k); member "n" (sm'::obj_to_string n) ]

:= frame_members (body : string) : list string =
    [ member "body" (json_string body); member "original" (quoted_text "5"); member "parent" (quoted_text "") ]

:= frame_doc (cell : string) (k : i32) (n : i32) (body : string) : string =
    object (listm::append (place_doc cell k n) (frame_members body))

:= located_of (frames : list string) : string =
    object [ member "frames" (items frames); member "known" (items [ quoted_text "5" ]) ]

:= reply_text (r : assembled_reply) : string =
    := code, sources, notes = r
    sm'::obj_to_string code ++# "|" ++# sources ++# "|" ++# notes

test frames_in_any_order_join_their_cell =
    := ~body = "inl a"
    [ frame_doc "c1" 2i32 2i32 " = 1"; frame_doc "c1" 1i32 2i32 body ]
    |> located_of
    |> assembled_of
    |> reply_text
    |> _assert_eq "0|inl a = 1|"

test a_lost_frame_holes_its_cell =
    := ~body = "inl a"
    [ frame_doc "c1" 1i32 2i32 body ]
    |> located_of
    |> assembled_of
    |> reply_text
    |> _assert_eq "4||cell c1 is missing frame 2 of 2"

///> _
:= main () : i32 =
    export "xc_assemble" ((\ bundle => assembled_of bundle) : string -> assembled_reply)
    0i32
