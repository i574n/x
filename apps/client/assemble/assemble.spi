open sm'_operators
open prelude
open posts
open cli
open wire
open glyphs
open protocol

type frame_fields = {cell : i32; k : i32; n : i32; body : string; original : string; parent : string}

type frame = heap frame_fields

inl last_of (l : list string) (fallback : string) : string =
    match listm.rev l with
    | Cons (x, _) => x
    | Nil => fallback

inl first_of (l : list string) (fallback : string) : string =
    match l with
    | Cons (x, _) => x
    | Nil => fallback

inl latest (f : framed) : bool = last_of f.history f.id = f.id

inl header_end (i : i32) (text : string) : i32 = if i < 0i32 then sm'.length text else i

inl head_of (i : i32) (text : string) : string = sm'.substring 0i32 (header_end i text) text

inl frame_from (f : framed) (h : frame_header) (body : string) : frame =
    heap {cell = h.cell; k = h.part; n = h.part_count; body original = first_of f.history f.id; parent = f.parent}

inl body_at (i : i32) (text : string) : string = if i < 0i32 then "" else after i text |> sm'.replace (defused_dot ()) "."

let frames_of (f : framed) : list frame =
    inl text = expand_urls f.urls f.text
    inl i : i32 = sm'.index_of "\n" text
    match parsed (head_of i text) with
    | Ok h when latest f => [frame_from f h (body_at i text)]
    | _ => Nil

type cell_frames = {cell : i32; n : i32; first : string; frames : list frame}

inl joined (c : cell_frames) (f : frame) : cell_frames =
    inl first = if later_id c.first f.original then f.original else c.first
    {c with n = if f.n > c.n then f.n else c.n; first; frames = Cons (f, c.frames)}

let rec grouped (l : list cell_frames) (f : frame) : list cell_frames =
    match l with
    | Cons (c, rest) when c.cell = f.cell => Cons (joined c f, rest)
    | Cons (c, rest) => Cons (c, grouped rest f)
    | Nil => [{cell = f.cell; n = f.n; first = f.original; frames = [f]}]

let rec placed (c : cell_frames) (l : list cell_frames) : list cell_frames =
    match l with
    | Cons (d, rest) when later_id c.first d.first => Cons (d, placed c rest)
    | _ => Cons (c, l)

inl frame_at (c : cell_frames) (k : i32) : list frame = c.frames |> keep (fun (f : frame) => f.k = k && f.n = c.n)

inl missing_ks (c : cell_frames) : list i32 =
    listm.init c.n (fun i => i + 1i32) |> keep (fun k => listm.length (frame_at c k) <> 1i32)

inl body_at (c : cell_frames) (k : i32) : string = frame_at c k |> each (fun (f : frame) => f.body) |> sm'.concat_list ""

inl source_of (c : cell_frames) : string = listm.init c.n (fun i => body_at c (i + 1i32)) |> sm'.concat_list ""

union private cell_reading =
    | Whole : string
    | Holed : thread_flaw

inl reading_of (c : cell_frames) : cell_reading =
    match missing_ks c with
    | Nil => Whole (source_of c)
    | missing => Holed (MissingFrames {cell = c.cell; missing; part_count = c.n})

type program = {sources : list string; flaws : list thread_flaw}

inl with_cell (p : program) (c : cell_frames) : program =
    match reading_of c with
    | Whole source => {p with sources = listm.append p.sources [source]}
    | Holed flaw => {p with flaws = listm.append p.flaws [flaw]}

inl gap_flaws (known : list string) (c : cell_frames) : list thread_flaw =
    frame_at c 1i32 |> keep (fun (f : frame) => f.parent <> "" && not (has (fun x => x = f.parent) known))
    |> each (fun (f : frame) => ReplyGap {cell = c.cell; parent = f.parent})

inl gaps (known : list string) (cells : list cell_frames) : list thread_flaw =
    match cells with
    | Cons (_, rest) => rest |> spread (gap_flaws known)
    | Nil => Nil

inl ordered (l : list framed) : list cell_frames =
    l |> spread frames_of |> listm.fold grouped Nil |> listm.fold (fun acc c => placed c acc) Nil

inl known_ids (l : list framed) : list string = l |> spread (fun (f : framed) => Cons (f.id, f.history))

let assembled (l : list framed) : program =
    inl cells = ordered l
    inl p = cells |> listm.fold with_cell {sources = Nil; flaws = Nil}
    {p with flaws = listm.append p.flaws (gaps (known_ids l) cells)}

inl posts_of_pages (doc : json) : json =
    $'serde_json::Value::from((!doc).as_array().map(|ps| ps.iter().flat_map(|p| p["data"].as_array().cloned().unwrap_or_default()).collect::<Vec<_>>()).unwrap_or_default())'

type assembled_reply = i32 * string * string

inl reply_of (p : program) : assembled_reply =
    exit_code p.flaws, sm'.concat_list """



        """ p.sources, p.flaws |> each note_of |> sm'.concat_list "\n"

let assembled_of (bundle : string) : assembled_reply =
    parse_json bundle |> posts_of_pages |> collect framed_of |> assembled |> reply_of

inl main () : i32 =
    !!!!Export("xc_assemble", ((fun bundle => assembled_of bundle) : string -> assembled_reply))
    0i32