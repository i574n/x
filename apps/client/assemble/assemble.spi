open sm'_operators
open prelude
open posts
open wire
open protocol
open reading

inl frame_of (v : json) : frame =
    heap {cell = at_key "cell" v; k = field "k" v |> number_of; n = field "n" v |> number_of; body = at_key "body" v; original = at_key "original" v; parent = at_key "parent" v}

type assembled_reply = i32 * string * string

inl reply_of (p : program) : assembled_reply =
    exit_code p.flaws, delimited """



        """ p.sources, p.flaws |> each note_of |> delimited "\n"

let assembled_of (located : string) : assembled_reply =
    inl doc = parse_json located
    assembled (field "frames" doc |> collect frame_of) (field "known" doc |> collect text_of) |> reply_of

inl main () : i32 =
    !!!!Export("xc_assemble", ((fun bundle => assembled_of bundle) : string -> assembled_reply))
    0i32
