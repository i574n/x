///- --package ..
:# domains static =
    :< testing

:< sm'_operators
:< prelude
:< tlds

:~ known_tld (label : string) : bool = is_tld label

///> rust
:# known_tlds_are_found =
    := ~label = "com"
    (known_tld label, known_tld "IO", known_tld "head") |> _assert_eq (!+, !+, !-)

:= main () : i32 =
    export "xc_is_tld" ((\ label => known_tld label) : string -> bool)
    0i32
