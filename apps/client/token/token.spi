///- --package ..
///> rust -d serde_json
test token static =
    :< testing

:< sm'_operators
:< prelude
:< posts
:< wire
:< oauth1

:! file_text = $'std::io::Result<String>'

:= read_text (path : string) : file_text = $'std::fs::read_to_string(&*!path)'

:= text_read (r : file_text) : bool = $'!r.is_ok()'

:= text_of_file (r : file_text) : string = $'Rc::<str>::from(!r.as_deref().unwrap_or(""))'

:! created_file = $'std::io::Result<std::fs::File>'

:! open_file = $'std::fs::File'

:! io_outcome = $'std::io::Result<()>'

:= file_created (path : string) : created_file = $'std::fs::File::create(&*!path)'

:= creation_ok (r : created_file) : bool = $'!r.is_ok()'

:= created_handle (r : created_file) : open_file = $'!r.unwrap()'

:= text_written (f : open_file) (text : string) : io_outcome = $'std::io::Write::write_all(&mut !f, (!text).as_bytes())'

:= disk_synced (f : open_file) : io_outcome = $'!f.sync_all()'

:= io_ok (r : io_outcome) : bool = $'!r.is_ok()'

:= synced_write (path : string) (text : string) : bool =
    := r = file_created path
    ? creation_ok r
    ?>
        := f = created_handle r
        io_ok (text_written f text) && io_ok (disk_synced f)
    |: !-

:= renamed (from : string) (into : string) : bool = $'std::fs::rename(&*!from, &*!into).is_ok()'

:= temp_of (path : string) : string = path ++# ".tmp"

:= file_replaced (path : string) (text : string) : bool =
    synced_write (temp_of path) text && renamed (temp_of path) path

:== tokens = { access_token : string; refresh_token : string; expires_in : string }

:= tokens_of (doc : json) : tokens =
    := expires_in = sm'::obj_to_string (doc |> field "expires_in" |> number_of)
    { access_token = at_key "access_token" doc; refresh_token = at_key "refresh_token" doc; expires_in }

:= token_form (client_id : string) (refresh_token : string) : string =
    "grant_type=refresh_token&refresh_token=" ++# percent refresh_token ++# "&client_id=" ++# percent client_id

:= token_path () : string = "/2/oauth2/token"

:= post_form (url : string) (user : string) (password : string) (body : string) : i32 * string =
    $'xc_net::xc_post_form(&*!url, &*!user, &*!password, &*!body)'

:= refusal_detail (body : string) : string =
    := doc = parse_json body
    := why, code = at_key "error_description" doc, at_key "error" doc
    ? why <> "" ?> why |? code <> "" ?> code |: body

:= refusal (status : i32) (body : string) : string =
    := detail = refusal_detail body
    "X API answered " ++# sm'::obj_to_string status ++# " for " ++# token_path () ++# ": " ++# detail

:= key_line (key : string) (value : string) (line : string) : string =
    := cr = ? sm'::ends_with "\r" line ?> "\r" |: ""
    ? sm'::starts_with (key ++# "=") line ?> key ++# "=" ++# value ++# cr |: line

:= has_key (key : string) (lines : list string) : bool = has (sm'::starts_with (key ++# "=")) lines

:= line_end (lines : list string) : string = ? has (sm'::ends_with "\r") lines ?> "\r" |: ""

:= with_key (key : string) (value : string) (lines : list string) : list string =
    ? has_key key lines
    ?> lines |> each (key_line key value)
    |: listm::append lines [ key ++# "=" ++# value ++# line_end lines ]

:= trailing (lines : list string) : list string =
    ?= listm::rev lines ?|
    | "" :: rest => listm::rev rest
    | _ => lines

:= with_tokens (t : tokens) (lines : list string) : list string =
    lines |> with_key "X_OAUTH2_ACCESS_TOKEN" t::access_token |> with_key "X_OAUTH2_REFRESH_TOKEN" t::refresh_token

:~ rewritten (text : string) (t : tokens) : string =
    := lines = split_on "\n" text |> trailing |> with_tokens t
    sm'::concat_list "\n" lines ++# "\n"

:= renewed (path : string) (t : tokens) : string =
    "renewed X_OAUTH2_ACCESS_TOKEN and X_OAUTH2_REFRESH_TOKEN in "
    ++# path
    ++# "; the access token expires in "
    ++# t::expires_in
    ++# " s"

:= no_tokens () : string = "the token reply had no access_token or refresh_token"

:= aside_of (path : string) : string = path ++# ".renewed"

:= set_aside (path : string) : string =
    "could not replace " ++# path ++# "; the renewed tokens are in " ++# aside_of path ++# ", move it over " ++# path

:= token_lost (path : string) : string =
    "could not write " ++# path ++# " or " ++# aside_of path ++# "; the renewed refresh token is lost, authorize again"

:= kept_aside (path : string) (text : string) : i32 * string =
    4i32, (? synced_write (aside_of path) text ?> set_aside path |: token_lost path)

:= saved (path : string) (text : string) (t : tokens) : i32 * string =
    ? t::access_token = "" || t::refresh_token = "" ?> 4i32, no_tokens ()
    |? file_replaced path (rewritten text t) ?> 0i32, renewed path t
    |: kept_aside path (rewritten text t)

:== refresh_args = string * string * string * string * string

:= unreachable_token (body : string) : string = "cannot reach " ++# token_path () ++# ": " ++# body

:= failed_reply (status : i32) (body : string) : i32 * string =
    4i32, (? status = 0i32 ?> unreachable_token body |: refusal status body)

:= answered (path : string) (text : string) (reply : i32 * string) : i32 * string =
    := status, body = reply
    ? accepted status ?> saved path text (tokens_of (parse_json body)) |: failed_reply status body

:== client = { base : string; client_id : string; client_secret : string }

:= exchanged (c : client) (refresh_token : string) (path : string) (text : string) : i32 * string =
    := form = token_form c::client_id refresh_token
    post_form (c::base ++# token_path ()) c::client_id c::client_secret form |> answered path text

:= unread (path : string) : i32 * string = 3i32, "cannot read " ++# path

:~ refreshed (x : refresh_args) : i32 * string =
    := base, client_id, client_secret, refresh_token, path = x
    := file = read_text path
    ? text_read file ?> exchanged { base client_id client_secret } refresh_token path (text_of_file file)
    |: unread path

:= renewed_tokens () : tokens = { access_token = "new"; refresh_token = "r2"; expires_in = "7200" }

:= shown_cr (s : string) : string = sm'::replace "\r" "~" s

test renewal_replaces_and_appends_keys =
    := ~text = "X_BEARER_TOKEN=kept\r\nX_OAUTH2_ACCESS_TOKEN=old\r\n"
    rewritten text (renewed_tokens ()) |> shown_cr
    |> _assert_eq "X_BEARER_TOKEN=kept~\nX_OAUTH2_ACCESS_TOKEN=new~\nX_OAUTH2_REFRESH_TOKEN=r2~\n"

///> _
:= main () : i32 =
    export "xc_refresh" ((\ x => refreshed x) : refresh_args -> i32 * string)
    0i32
