open sm'_operators
open prelude
open posts
open wire
open transport

inl page_of (a : app) (s : thread_search) (token : string) : got fetched = get_raw a (thread_path (ThreadPage (s, token)))

let rec paged (a : app) (s : thread_search) (token : string) (acc : list string) : got (list string) =
    page_of a s token |> then_ok fun (doc, body) =>
        inl next, acc = next_token_in doc, listm.append acc [body]
        if next = "" then Ok acc else paged a s next acc

inl whole_second (created_at : string) : string = if sm'.length created_at < 19i32 then created_at else sm'.substring 0i32 19i32 created_at ++# "Z"

inl absent (id : string) (missing : string) : failure = HttpStatus {status = 404i32; resource = root_path id; detail = missing}

inl search_of (r : root_reply) : thread_search =
    match r with
    | root_reply {conversation_id author_id created_at} => {conversation_id author_id start_time = whole_second created_at}

inl missing_of (r : root_reply) : string =
    match r with
    | root_reply {missing} => missing

let rooted (a : app) (id : string) (r : root_reply) : got (list string) =
    inl s = search_of r
    if s.conversation_id <> "" then paged a s "" Nil else Error (absent id (missing_of r))

inl root_of_post (a : app) (id : string) : got root_reply =
    get_raw a (thread_path (ThreadRoot id)) |> map_ok fun (doc, _) => root_of doc

type pages_reply = i32 * string * string

inl bundle_of (bodies : list string) : string = "[" ++# sm'.concat_list "," bodies ++# "]"

let pages_of (base : string) (bearer : string) (id : string) : pages_reply =
    inl a = app_api base bearer
    match root_of_post a id |> then_ok (rooted a id) with
    | Ok bodies => 0i32, bundle_of bodies, ""
    | Error f => 4i32, "", describe_failure f

inl main () : i32 =
    !!!!Export("xc_thread_pages", ((fun (base, bearer, id) => pages_of base bearer id) : string * string * string -> pages_reply))
    0i32