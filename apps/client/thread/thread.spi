///- --package ..
///> rust -d serde_json
test thread static =
    :< testing

:< sm'_operators
:< prelude
:< protocol
:< posts
:< wire
:< transport
:< cursor_walk
:< paging

:= pager_of (a : app) (s : thread_search) : pager failure =
    \ token => get_raw a (thread_path (ThreadPage (s, token))) |> map_ok \ (doc, body) => {
        next_token = next_token_in doc
        body
    }

:= halted_in (s : thread_search) (h : cursor_halt) : failure =
    CursorHalted { resource = "conversation " ++# conversation_text s.conversation_id; halt = h }

:= absent (id : post_id) (missing : string) : failure = Reported (answered 404i32 (root_path id) missing)

:= search_of (r : root_reply) : thread_search =
    ?= r ?|
    | root_reply { conversation_id author_id created_at } =>
        { conversation_id author_id start_time = whole_second created_at }

:= missing_of (r : root_reply) : string =
    ?= r ?|
    | root_reply { missing } => missing

:~ rooted (a : app) (id : post_id) (r : root_reply) : got (list string) =
    := s = search_of r
    ? conversation_text s.conversation_id <> ""
    ?> all_pages (halted_in s) (pager_of a s)
    |: Error (absent id (missing_of r))

:= root_of_post (a : app) (id : post_id) : got root_reply =
    get_raw a (thread_path (ThreadRoot id)) |> map_ok \ (doc, _) => root_of doc

:~ thread_bodies (base : string) (bearer : string) (id : string) : got (list string) =
    := a = app_api base bearer
    := root = post_id id
    root_of_post a root |> then_ok (rooted a root)

:== pages_reply = i32 * string * string

:= replied (f : list string -> string) (r : got (list string)) : pages_reply =
    ?= r ?|
    | Ok bodies => 0i32, f bodies, ""
    | Error e => 4i32, "", describe_failure e

:= bundle_of (bodies : list string) : string = "[" ++# delimited "," bodies ++# "]"

:= framed_page (body : string) : list framed = parse_json body |> field "data" |> collect framed_of

:= latest_ids (body : string) : list string = framed_page body |> keep latest |> each (\ f => post_text f.id)

:= ids_text (bodies : list string) : string = bodies |> spread latest_ids |> delimited "\n"

:= versioned (id : string) (history : list string) : string =
    object [ member "id" (quoted_text id); member "edit_history_post_ids" (items (history |> each quoted_text)) ]

:= edited_page () : string = object [ member "data" (items [ versioned "1" [ "1" ]; versioned "2" [ "2"; "3" ] ]) ]

test only_latest_versions_are_deleted =
    := ~page = edited_page ()
    ids_text [ page; page ] |> _assert_eq "1\n1"
    bundle_of [ "a"; "b" ] |> _assert_eq "[a,b]"

:== ask = string * string * string

:= asked (f : list string -> string) (x : ask) : pages_reply =
    x |> \ (base, bearer, id) => thread_bodies base bearer id |> replied f


///> _
:= main () : i32 =
    export "xc_thread_pages" ((\ x => asked bundle_of x) : ask -> pages_reply)
    export "xc_thread_ids" ((\ x => asked ids_text x) : ask -> pages_reply)
    0i32
