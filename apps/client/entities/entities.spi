///- --package ..
:# entities static =
    :< testing

:< sm'_operators
:< prelude
:< glyphs
:< defuse

:~ tags_defused (s : string) : string = defused_entities s

///> rust -d unicode-segmentation=1.13
:# a_mention_sigil_gets_its_zero_width_space =
    := ~at = "@"
    tags_defused (at ++# "bob hi") |> _assert_eq (at ++# zero_width_space () ++# "bob hi")

:= main () : i32 =
    export "xc_defused_entities" ((\ s => tags_defused s) : string -> string)
    0i32
