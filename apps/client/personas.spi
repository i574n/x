///- --package . --timeout 600000
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test personas static =
    :< testing

:< sm'_operators
:< prelude
:< exsss
:< glyphs
:< events

:| persona =
    | Lurker
    | Fickle
    | Editor
    | Breaker

:= persona_name (p : persona) : string =
    ?= p ?|
    | Lurker => "lurker"
    | Fickle => "fickle"
    | Editor => "editor"
    | Breaker => "breaker"

:= persona_of (name : string) : option persona =
    ? name = "lurker" ?> Some Lurker |? name = "fickle" ?> Some Fickle
    |? name = "editor" ?> Some Editor |? name = "breaker" ?> Some Breaker |: None

:= repeated_persona (p : persona) (count : i32) : list persona = listm.init count (\ _ => p)

:= named_count (name : string) (count : string) : list persona =
    ?= persona_of name, count_of_text count ?|
    | Some p, Some n => repeated_persona p n
    | _ => Nil

:= entry_personas (entry : string) : list persona =
    ?= split_on "=" (sm'.trim entry) ?|
    | Cons (name, Cons (count, Nil)) => named_count name count
    | _ => Nil

:= parsed_personas (text : string) : list persona =
    pieces "+" (sm'.replace "," "+" text) |> keep (\ e => e <> "") |> spread entry_personas

:= test_cell (source : string) : bool = sm'.contains "///- --test" source

:= ends_blank (s : string) : bool = has (\ b => sm'.ends_with b s) [" "; "\t"; "\n"; "\r"; char_of 11i32; char_of 12i32]

:= ends_digit (s : string) : bool = has (\ d => sm'.ends_with (sm'.obj_to_string d) s) (listm.init 10i32 id)

:~ ^ blank_start (s : string) (i : i32) : i32 = ? i > 0i32 && ends_blank (cut 0i32 i s) ?> blank_start s (i - 1i32) |: i

:~ ^ digits_start (s : string) (i : i32) : i32 = ? i > 0i32 && ends_digit (cut 0i32 i s) ?> digits_start s (i - 1i32) |: i

:~ ^ unpadded (d : string) : string = ? sm'.length d > 1i32 && sm'.starts_with "0" d ?> unpadded (rest_from 1i32 d) |: d

:= all_but_last (d : string) : string = cut 0i32 (sm'.length d - 1i32) d

:= last_digit (d : string) : i32 = ? d = "" ?> -1i32 |: digit_at (sm'.length d - 1i32) d

:~ ^ plus_one (d : string) : string =
    := last = last_digit d
    ? last < 0i32 ?> "1"
    |? last = 9i32 ?> plus_one (all_but_last d) ++# "0"
    |: all_but_last d ++# sm'.obj_to_string (last + 1i32)

:= bumped_at (s : string) (start : i32) (stop : i32) : string =
    cut 0i32 start s ++# plus_one (unpadded (cut start (stop - start) s)) ++# rest_from stop s

:= ends_dot (s : string) (i : i32) : bool = i > 0i32 && sm'.ends_with "." (cut 0i32 i s)

:= decimal_break (s : string) (fraction : i32) : string =
    := dot = fraction - 1i32
    := whole = digits_start s dot
    ? whole = dot || ends_dot s whole ?> s |: bumped_at s whole dot

:~ break_source (s : string) : string =
    := stop = blank_start s (sm'.length s)
    := start = digits_start s stop
    ? start = stop ?> s |? ends_dot s start ?> decimal_break s start |: bumped_at s start stop

:= breakable (source : string) : bool = test_cell source && break_source source <> source

:~ ^ picked \* t. (i : i32) (l : list t) : option t =
    ?= l ?|
    | Cons (x, rest) => ? i <= 0i32 ?> Some x |: picked (i - 1i32) rest
    | Nil => None

:= liked_by (user : string) (r : rooted) : event = Reaction (Liked {post_id = r.post_id; user})

:= unliked_by (user : string) (r : rooted) : event = Reaction (Unliked {post_id = r.post_id; user})

:= edited_to (source : string) (r : rooted) : event = Revision (Edited {post_id = r.post_id; source})

:== acted = {act_events : list event; broken : list string; rng : exsss}

:= quiet_act (st : exsss) : acted = {act_events = Nil; broken = Nil; rng = st}

:= lurked (user : string) (acc : list event * exsss) (r : rooted) : list event * exsss =
    := l, st = acc
    := roll, st = rolled 2i32 st
    (? roll = 1i32 ?> listm.append l [liked_by user r] |: l), st

:= lurker_act (user : string) (posts : list rooted) (st : exsss) : acted =
    := act_events, rng = posts |> listm.fold (lurked user) (Nil, st)
    {act_events broken = Nil; rng}

:= toggled (user : string) (r : rooted) (k : i32) : event = ? k % 2i32 = 0i32 ?> liked_by user r |: unliked_by user r

:= drawn_from (pool : list rooted) (st : exsss) : option rooted * exsss =
    := i, st = rolled (listm.length pool) st
    picked (i - 1i32) pool, st

:= toggle_drawn (user : string) (posts : list rooted) (st : exsss) : acted =
    ?= drawn_from posts st ?|
    | Some r, rng => {act_events = listm.init 5i32 (toggled user r); broken = Nil; rng}
    | None, _ => quiet_act st

:= fickle_act (user : string) (posts : list rooted) (st : exsss) : acted =
    ?= posts ?|
    | Nil => quiet_act st
    | _ => toggle_drawn user posts st

:= rewritten (user : string) (r : rooted) : list event =
    := rewrites = listm.init 3i32 (\ k => edited_to (r.source ++# sm'.replicate (k + 1i32) " " ++# "\n") r)
    Cons (liked_by user r, listm.append rewrites [edited_to r.source r])

:= rewrite_drawn (user : string) (pool : list rooted) (st : exsss) : acted =
    ?= drawn_from pool st ?|
    | Some r, rng => {act_events = rewritten user r; broken = Nil; rng}
    | None, _ => quiet_act st

:= editor_act (user : string) (posts : list rooted) (st : exsss) : acted =
    ?= posts |> keep (\ (r : rooted) => not (test_cell r.source)) ?|
    | Nil => quiet_act st
    | pool => rewrite_drawn user pool st

:= broken_by (user : string) (r : rooted) : list event = [liked_by user r; edited_to (break_source r.source) r; edited_to r.source r]

:= break_drawn (user : string) (pool : list rooted) (st : exsss) : acted =
    ?= drawn_from pool st ?|
    | Some r, rng => {act_events = broken_by user r; broken = [break_source r.source]; rng}
    | None, _ => quiet_act st

:= breaker_act (user : string) (posts : list rooted) (st : exsss) : acted =
    ?= posts |> keep (\ (r : rooted) => breakable r.source) ?|
    | Nil => quiet_act st
    | pool => break_drawn user pool st

:= act (p : persona) (user : string) (posts : list rooted) (st : exsss) : acted =
    ?= p ?|
    | Lurker => lurker_act user posts st
    | Fickle => fickle_act user posts st
    | Editor => editor_act user posts st
    | Breaker => breaker_act user posts st

:= rest_of (l : list event) : list event =
    ?= l ?|
    | Cons (_, rest) => rest
    | Nil => Nil

:= live_streams (streams : list (list event)) : list (list event) = streams |> keep (\ l => listm.length l > 0i32)

:~ ^ round_robin (streams : list (list event)) (acc : list event) : list event =
    ?= live_streams streams ?|
    | Nil => acc
    | live => round_robin (live |> each rest_of) (listm.append acc (live |> spread (take_first 1i32)))

:== cast = {streams : list (list event); broken : list string; rng : exsss; n : i32}

:= user_of (p : persona) (n : i32) : string = persona_name p ++# sm'.obj_to_string n

:= acted_in (posts : list rooted) (c : cast) (p : persona) : cast =
    := a = act p (user_of p c.n) posts c.rng
    {streams = listm.append c.streams [a.act_events]; broken = listm.append c.broken a.broken; rng = a.rng; n = c.n + 1i32}

:~ persona_events (posts : list rooted) (personas : list persona) (st : exsss) : acted =
    := c = personas |> listm.fold (acted_in posts) {streams = Nil; broken = Nil; rng = st; n = 1i32}
    {act_events = round_robin c.streams Nil; broken = c.broken; rng = c.rng}

test numbers_at_the_end_are_broken =
    := ~s = "///- --test\n1 + 1 |> _assert_eq 2  \n"
    break_source s |> _assert_eq "///- --test\n1 + 1 |> _assert_eq 3  \n"
    break_source "x 1.50" |> _assert_eq "x 2.50"
    break_source "x 099" |> _assert_eq "x 100"

test numbers_after_a_dot_or_none_stay =
    := ~s = "v1.2.3"
    break_source s |> _assert_eq "v1.2.3"
    break_source "x .5" |> _assert_eq "x .5"
    break_source "no digits" |> _assert_eq "no digits"

:= persona_text (l : list persona) : string = l |> each persona_name |> delimited ","

test persona_lists_parse_like_the_simulator =
    := ~text = "fickle=1+editor=2"
    parsed_personas text |> persona_text |> _assert_eq "fickle,editor,editor"
    parsed_personas "lurker=0, breaker=1" |> persona_text |> _assert_eq "breaker"
