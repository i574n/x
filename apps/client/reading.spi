///- --package .
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test reading static =
    open testing

open sm'_operators
open prelude
open posts
open glyphs
open protocol
open splitter

type frame_fields = {cell : string; k : i32; n : i32; body : string; original : string; parent : string}

type frame = heap frame_fields

type frame_text = {header : frame_header; body : string}

inl header_end (i : i32) (text : string) : i32 = if i < 0i32 then sm'.length text else i

inl head_of (i : i32) (text : string) : string = cut 0i32 (header_end i text) text

inl restored_body (i : i32) (text : string) : string = if i < 0i32 then "" else after i text |> sm'.replace (defused_dot ()) "."

let frame_text_of (text : string) : option frame_text =
    inl i : i32 = sm'.index_of "\n" text
    match parsed (head_of i text) with
    | Ok header => Some {header body = restored_body i text}
    | Error _ => None

inl frame_in (t : frame_text) (original : string) (parent : string) : frame =
    heap {cell = t.header.cell; k = t.header.part; n = t.header.part_count; body = t.body; original; parent}

type cell_frames = {cell : string; n : i32; first : string; frames : list frame}

inl merged (c : cell_frames) (f : frame) : cell_frames =
    inl first = if later_id c.first f.original then f.original else c.first
    {c with n = if f.n > c.n then f.n else c.n; first; frames = Cons (f, c.frames)}

let rec grouped (l : list cell_frames) (f : frame) : list cell_frames =
    match l with
    | Cons (c, rest) when c.cell = f.cell => Cons (merged c f, rest)
    | Cons (c, rest) => Cons (c, grouped rest f)
    | Nil => [{cell = f.cell; n = f.n; first = f.original; frames = [f]}]

let rec placed (c : cell_frames) (l : list cell_frames) : list cell_frames =
    match l with
    | Cons (d, rest) when later_id c.first d.first => Cons (d, placed c rest)
    | _ => Cons (c, l)

inl frame_at (c : cell_frames) (k : i32) : list frame = c.frames |> keep (fun (f : frame) => f.k = k && f.n = c.n)

inl missing_ks (c : cell_frames) : list i32 =
    listm.init c.n (fun i => i + 1i32) |> keep (fun k => listm.length (frame_at c k) <> 1i32)

inl part_body (c : cell_frames) (k : i32) : string = frame_at c k |> each (fun (f : frame) => f.body) |> delimited ""

inl source_of (c : cell_frames) : string = listm.init c.n (fun i => part_body c (i + 1i32)) |> delimited ""

union private cell_reading =
    | Whole : string
    | Holed : thread_flaw

inl reading_of (c : cell_frames) : cell_reading =
    match missing_ks c with
    | Nil => Whole (source_of c)
    | missing => Holed (MissingFrames {cell = c.cell; missing; part_count = c.n})

type program = {sources : list string; flaws : list thread_flaw}

inl with_cell (p : program) (c : cell_frames) : program =
    match reading_of c with
    | Whole source => {p with sources = listm.append p.sources [source]}
    | Holed flaw => {p with flaws = listm.append p.flaws [flaw]}

inl gap_flaws (known : list string) (c : cell_frames) : list thread_flaw =
    frame_at c 1i32 |> keep (fun (f : frame) => f.parent <> "" && not (has (fun x => x = f.parent) known))
    |> each (fun (f : frame) => ReplyGap {cell = c.cell; parent = f.parent})

inl gaps (known : list string) (cells : list cell_frames) : list thread_flaw =
    match cells with
    | Cons (_, rest) => rest |> spread (gap_flaws known)
    | Nil => Nil

inl ordered (l : list frame) : list cell_frames =
    l |> listm.fold grouped Nil |> listm.fold (fun acc c => placed c acc) Nil

let assembled (frames : list frame) (known : list string) : program =
    inl cells = ordered frames
    inl p = cells |> listm.fold with_cell {sources = Nil; flaws = Nil}
    {p with flaws = listm.append p.flaws (gaps known cells)}

inl frames_in (text : string) (original : string) (parent : string) : list frame =
    match frame_text_of text with
    | Some t => [frame_in t original parent]
    | None => Nil

let rec chained (k : i32) (parent : string) (l : list string) (acc : list frame) : list frame =
    match l with
    | Nil => acc
    | Cons (t, rest) => chained (k + 1i32) (sm'.obj_to_string k) rest (listm.append (frames_in t (sm'.obj_to_string k) parent) acc)

inl ids_to (n : i32) : list string = listm.init n (fun i => sm'.obj_to_string (i + 1i32))

inl read_thread (posts : list string) : program = assembled (chained 1i32 "" posts Nil) (ids_to (listm.length posts))

inl mixed_cells () : string =
    "go x.io now\n\n" ++# repeated 150i32 "日本" "" ++# "\n\n" ++# repeated 120i32 "ab " ""

test posted_cells_rebuild_exactly =
    inl ~text = mixed_cells ()
    inl p = posts_of text |> read_thread
    p.sources |> delimited "|" |> _assert_eq (file_cells text |> delimited "|")
    p.flaws |> listm.length |> _assert_eq 0i32

inl carries_defused_dot (t : string) : bool = sm'.index_of (defused_dot ()) t >= 0i32

test posted_frames_keep_no_trailing_space =
    inl ~text = mixed_cells ()
    inl posts = posts_of text
    (listm.length posts > 3i32) |> _assert_eq true
    has (fun t => trimmed_end t <> t) posts |> _assert_eq false
    has carries_defused_dot posts |> _assert_eq true

inl without_post (k : i32) (l : list string) : list string = listm.init (listm.length l) id |> keep (fun i => i <> k) |> each (fun i => field_at i l)

test a_lost_frame_leaves_its_cell_holed =
    inl ~lost = 2i32
    inl p = posts_of (mixed_cells ()) |> without_post lost |> read_thread
    p.flaws |> each note_of |> delimited "|" |> _assert_eq "cell c2 is missing frame 2 of 3"
    p.sources |> listm.length |> _assert_eq 2i32
