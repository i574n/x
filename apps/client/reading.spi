///- --package .
///> rust -d unicode-segmentation=1.13 unicode-normalization=0.1
///> gleam
test reading static =
    :< testing

:< sm'_operators
:< prelude
:< posts
:< glyphs
:< protocol
:< splitter

:== frame_fields = {cell : cell_id; k : i32; n : i32; body : string; original : post_id; parent : option post_id}

:== frame = heap frame_fields

:== frame_text = {header : frame_header; body : string}

:= header_end (i : i32) (text : string) : i32 = ? i < 0i32 ?> sm'.length text |: i

:= head_of (i : i32) (text : string) : string = cut 0i32 (header_end i text) text

:= restored_body (i : i32) (text : string) : string = ? i < 0i32 ?> "" |: after i text |> sm'.replace (defused_dot ()) "."

:~ frame_text_of (text : string) : option frame_text =
    := i : i32 = sm'.index_of "\n" text
    ?= parsed (head_of i text) ?|
    | Ok header => Some {header body = restored_body i text}
    | Error _ => None

:= frame_in (t : frame_text) (original : post_id) (parent : option post_id) : frame =
    heap {cell = t.header.cell; k = t.header.part; n = t.header.part_count; body = t.body; original; parent}

:== cell_frames = {cell : cell_id; n : i32; first : post_id; frames : list frame}

:= merged (c : cell_frames) (f : frame) : cell_frames =
    := first = ? later_id c.first f.original ?> f.original |: c.first
    {c ?| n = ? f.n > c.n ?> f.n |: c.n; first; frames = f :: c.frames}

:= opened (f : frame) : cell_frames = {cell = f.cell; n = f.n; first = f.original; frames = [f]}

:~ ^ grouped (l : list cell_frames) (f : frame) : list cell_frames =
    ?= l ?|
    | c :: rest ?& same_cell c.cell f.cell => merged c f :: rest
    | c :: rest => c :: grouped rest f
    | Nil => [opened f]

:~ ^ placed (c : cell_frames) (l : list cell_frames) : list cell_frames =
    ?= l ?|
    | d :: rest ?& later_id c.first d.first => d :: placed c rest
    | _ => c :: l

:= frame_at (c : cell_frames) (k : i32) : list frame = c.frames |> keep (\ (f : frame) => f.k = k && f.n = c.n)

:= missing_ks (c : cell_frames) : list i32 =
    listm.init c.n (\ i => i + 1i32) |> keep (\ k => listm.length (frame_at c k) <> 1i32)

:= part_body (c : cell_frames) (k : i32) : string = frame_at c k |> each (\ (f : frame) => f.body) |> delimited ""

:= source_of (c : cell_frames) : string = listm.init c.n (\ i => part_body c (i + 1i32)) |> delimited ""

:| private cell_reading =
    | Whole : string
    | Holed : thread_flaw

:= reading_of (c : cell_frames) : cell_reading =
    ?= missing_ks c ?|
    | Nil => Whole (source_of c)
    | missing => Holed (MissingFrames {cell = c.cell; missing; part_count = c.n})

:== program = {sources : list string; flaws : list thread_flaw}

:= with_cell (p : program) (c : cell_frames) : program =
    ?= reading_of c ?|
    | Whole source => {p ?| sources = listm.append p.sources [source]}
    | Holed flaw => {p ?| flaws = listm.append p.flaws [flaw]}

:= unknown_parent (known : post_ids) (f : frame) : list post_id =
    ?= f.parent ?|
    | Some p ?& not (has (same_post p) known) => [p]
    | _ => Nil

:= gap_flaws (known : post_ids) (c : cell_frames) : list thread_flaw =
    frame_at c 1i32 |> spread (unknown_parent known) |> each (\ parent => ReplyGap {cell = c.cell; parent})

:= gaps (known : post_ids) (cells : list cell_frames) : list thread_flaw =
    ?= cells ?|
    | _ :: rest => rest |> spread (gap_flaws known)
    | Nil => Nil

:= ordered (l : list frame) : list cell_frames =
    l |> listm.fold grouped Nil |> listm.fold (\ acc c => placed c acc) Nil

:~ assembled (frames : list frame) (known : post_ids) : program =
    := cells = ordered frames
    := p = cells |> listm.fold with_cell {sources = Nil; flaws = Nil}
    {p ?| flaws = listm.append p.flaws (gaps known cells)}

:= frames_in (text : string) (original : post_id) (parent : option post_id) : list frame =
    ?= frame_text_of text ?|
    | Some t => [frame_in t original parent]
    | None => Nil

:= numbered_post (k : i32) : post_id = post_id (sm'.obj_to_string k)

:~ ^ chained (k : i32) (parent : option post_id) (l : list string) (acc : list frame) : list frame =
    ?= l ?|
    | Nil => acc
    | t :: rest => chained (k + 1i32) (Some (numbered_post k)) rest (listm.append (frames_in t (numbered_post k) parent) acc)

:= ids_to (n : i32) : post_ids = listm.init n (\ i => numbered_post (i + 1i32))

:= read_thread (posts : list string) : program = assembled (chained 1i32 None posts Nil) (ids_to (listm.length posts))

:= mixed_cells () : string =
    "go x.io now\n\n" ++# repeated 150i32 "日本" "" ++# "\n\n" ++# repeated 120i32 "ab " ""

test posted_cells_rebuild_exactly =
    := ~text = mixed_cells ()
    := p = posts_of text |> read_thread
    p.sources |> delimited "|" |> _assert_eq (file_cells text |> delimited "|")
    p.flaws |> listm.length |> _assert_eq 0i32

:= carries_defused_dot (t : string) : bool = sm'.index_of (defused_dot ()) t >= 0i32

:= ends_in_space (t : string) : bool = trimmed_end t <> t

test posted_frames_keep_no_trailing_space =
    := ~text = mixed_cells ()
    := posts = posts_of text
    (listm.length posts > 3i32) |> _assert_eq !+
    has ends_in_space posts |> _assert_eq !-
    has carries_defused_dot posts |> _assert_eq !+

:= without_post (k : i32) (l : list string) : list string = listm.init (listm.length l) id |> keep (\ i => i <> k) |> each (\ i => field_at i l)

:= notes_of (p : program) : string = p.flaws |> each note_of |> delimited "|"

test a_lost_frame_leaves_its_cell_holed =
    := ~lost = 2i32
    := p = posts_of (mixed_cells ()) |> without_post lost |> read_thread
    notes_of p |> _assert_eq "cell c2 is missing frame 2 of 3"
    p.sources |> listm.length |> _assert_eq 2i32
