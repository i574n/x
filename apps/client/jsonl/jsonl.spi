///- --package ..
///> rust -d serde_json
test jsonl static =
    open testing

open sm'_operators
open prelude
open protocol
open posts

inl quoted (s : string) : string = $'Rc::<str>::from(serde_json::Value::from(&*!s).to_string())'

inl ref_json (r : reference) : string = "{\"type\":" ++# quoted (ref_word r.kind) ++# ",\"id\":" ++# quoted (post_text r.id) ++# "}"

inl array (l : list string) : string = "[" ++# sm'.concat_list "," l ++# "]"

inl pair (key : string) (value : string) : string = "\"" ++# key ++# "\":" ++# value

inl counts_json (e : entry) : list string =
    [pair "reply_count" e.reply_count; pair "repost_count" e.repost_count; pair "like_count" e.like_count]

inl names_json (e : entry) : list string =
    [pair "id" (quoted (entry_id e)); pair "username" (quoted e.username); pair "created_at" (quoted e.created_at); pair "text" (quoted e.text)]

inl links_json (e : entry) : list string =
    [pair "refs" (array (e.refs |> each ref_json)); pair "hints" (array (e.hints |> each quoted))]

inl place_json (level : i32) (via : string) : list string = [pair "level" (sm'.obj_to_string level); pair "via" (quoted via)]

let entry_json (level : i32) (via : string) (e : entry) : string =
    inl links, place = links_json e, place_json level via
    "{" ++# sm'.concat_list "," (listm.append (names_json e) (listm.append (counts_json e) (listm.append links place))) ++# "}"

let rec referenced_json (pool : list entry) (depth : i32) (level : i32) (e : entry) : list string =
    if level >= depth then Nil else e.refs |> spread (reference_json pool depth level e)

and let reference_json (pool : list entry) (depth : i32) (level : i32) (e : entry) (r : reference) : list string =
    match find_entry pool r.id with
    | Some q => Cons (entry_json (level + 1) (entry_id e) q, referenced_json pool depth (level + 1) q)
    | None => Nil

inl with_references (pool : list entry) (depth : i32) (e : entry) : list string =
    Cons (entry_json 0i32 "" e, referenced_json pool depth 0i32 e)

inl lines_of (pool : list entry) (depth : i32) (shown : list entry) : string = shown |> spread (with_references pool depth) |> sm'.concat_list "\n"

let json_lines (text : string) (limit : i32) (per_author : i32) (depth : i32) : string * i32 =
    inl d = digest_of text
    inl shown = d.primary |> selected {limit per_author}
    lines_of d.pool depth shown, listm.length shown

inl quiet_entry () : string =
    "{\"id\":\"1\",\"username\":\"b\",\"created_at\":\"09:05\",\"text\":\"t1\",\"reply_count\":0,\"repost_count\":0,\"like_count\":0,\"refs\":[],\"hints\":[],\"level\":0,\"via\":\"\"}"

inl lines_text (r : string * i32) : string =
    inl text, n = r
    text ++# "|" ++# sm'.obj_to_string n

test entry_lines_become_json_lines =
    inl ~line = at "1" "b" "09:05" |> lone |> entry_line "p"
    json_lines line 20i32 0i32 0i32 |> lines_text |> _assert_eq (quiet_entry () ++# "|1")

type jsonl_args = string * i32 * i32 * i32

///> _
inl main () : i32 =
    !!!!Export("xc_jsonl", ((fun (text, limit, per_author, depth) => json_lines text limit per_author depth) : jsonl_args -> string * i32))
    0i32