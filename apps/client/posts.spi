///- --package .
test posts static =
    open testing

open sm'_operators
open prelude

type account = {id : string; username : string}

type accounts = list account

union ref_kind =
    | Quoted
    | RepliedTo
    | Reposted

type reference = {kind : ref_kind; id : string}

type url_entity = {url : string; expanded_url : string; title : string}

type medium = {media_key : string; kind : string; alt_text : string}

type public_metrics = {reply_count : i32; repost_count : i32; like_count : i32}

inl no_metrics () : public_metrics = {reply_count = 0i32; repost_count = 0i32; like_count = 0i32}

type post =
    {id : string; author_id : string; author_username : string; created_at : string; text : string;
     public_metrics : public_metrics; refs : list reference; urls : list url_entity; media_keys : list string}

type pool = {posts : list post; media : list medium; users : accounts}

inl empty_pool () : pool = {posts = Nil; media = Nil; users = Nil}

inl media_in (p : pool) : list medium =
    inl {media} = p
    media

inl merge_pools (a : pool) (b : pool) : pool =
    {posts = listm.append a.posts b.posts; media = listm.append (media_in a) (media_in b); users = listm.append a.users b.users}

inl ref_kind_of (text : string) : option ref_kind =
    if text = "quoted" then Some Quoted
    elif text = "replied_to" then Some RepliedTo
    elif text = "reposted" || text = "retweeted" then Some Reposted
    else None

inl ref_label (k : ref_kind) : string =
    match k with
    | Quoted => "quoted"
    | RepliedTo => "replied to"
    | Reposted => "reposted"

inl second_of (stamp : string) : string =
    if sm'.length stamp < 19i32 then stamp else sm'.slice 0i32 18i32 stamp

inl later_id (a : string) (b : string) : bool =
    inl la : i32 = sm'.length a
    inl lb : i32 = sm'.length b
    if la <> lb then la > lb else comp a b |> gt_is

inl newer (a : post) (b : post) : bool =
    inl sa = second_of a.created_at
    inl sb = second_of b.created_at
    if sa <> sb then comp sa sb |> gt_is else later_id a.id b.id

let rec merge_newest (a : list post) (b : list post) : list post =
    match a, b with
    | Nil, _ => b
    | _, Nil => a
    | Cons (x, xs), Cons (y, ys) =>
        if newer x y then Cons (x, merge_newest xs b)
        else Cons (y, merge_newest a ys)

let rec halves (l : list post) : list post * list post =
    match l with
    | Cons (x, Cons (y, rest)) =>
        inl left, right = halves rest
        Cons (x, left), Cons (y, right)
    | _ => l, Nil

let rec newest_first (l : list post) : list post =
    match l with
    | Nil | Cons (_, Nil) => l
    | _ =>
        inl left, right = halves l
        merge_newest (newest_first left) (newest_first right)

type tally = {seen : list (string * i32); kept : list post}

inl count_of_author (author : string) (seen : list (string * i32)) : i32 =
    match first_where (fun (a, _) => a = author) seen with
    | Some (_, n) => n
    | None => 0

inl counted (author : string) (seen : list (string * i32)) : list (string * i32) =
    Cons ((author, count_of_author author seen + 1), keep (fun (a, _) => a <> author) seen)

inl tally_step (cap : i32) (t : tally) (p : post) : tally =
    if count_of_author p.author_username t.seen >= cap then t
    else {seen = counted p.author_username t.seen; kept = Cons (p, t.kept)}

inl per_author (cap : i32) (l : list post) : list post =
    if cap <= 0 then l
    else listm.fold (tally_step cap) {seen = Nil; kept = Nil} l |> fun t => listm.rev t.kept

inl single_line (text : string) : string =
    text
    |> sm'.replace "\r\n" " "
    |> sm'.replace "\n" " "
    |> sm'.replace "\r" " "

inl expand_urls (urls : list url_entity) (text : string) : string =
    listm.fold (fun t (u : url_entity) => if u.expanded_url = "" then t else sm'.replace u.url u.expanded_url t) text urls

let shown_text (p : post) : string = p.text |> expand_urls p.urls |> single_line

inl utc_minute (at : string) : string =
    if sm'.length at < 16i32 then at
    else sm'.slice 0i32 9i32 at ++# " " ++# sm'.slice 11i32 15i32 at

inl quantity (n : i32) (one : string) (many : string) : string =
    sm'.obj_to_string n ++# " " ++# (if n = 1i32 then one else many)

let metrics_text (m : public_metrics) : string =
    inl parts = [quantity m.reply_count "reply" "replies"; quantity m.repost_count "repost" "reposts"; quantity m.like_count "like" "likes"]
    "  [" ++# sm'.concat_list ", " parts ++# "]"

let render_post (minute : string -> string) (p : post) : string =
    minute p.created_at ++# "  @" ++# p.author_username ++# "  " ++# shown_text p ++# metrics_text p.public_metrics

inl indent (level : i32) : string =
    listm.fold (fun s _ => s ++# "  ") "" (listm.init level id)

inl medium_text (m : medium) : string =
    if m.alt_text = "" then "[" ++# m.kind ++# "]" else "[" ++# m.kind ++# "] " ++# single_line m.alt_text

inl medium_hint (pl : pool) (key : string) : string =
    match first_where (fun (m : medium) => m.media_key = key) (media_in pl) with
    | Some m => medium_text m
    | None => "[media]"

inl url_hints (p : post) : list string =
    p.urls |> keep (fun (u : url_entity) => u.title <> "") |> each (fun (u : url_entity) => "[url] " ++# single_line u.title)

let hint_lines (pl : pool) (level : i32) (p : post) : list string =
    listm.append (p.media_keys |> each (medium_hint pl)) (url_hints p) |> each (fun h => indent level ++# h)

inl author_of (pl : pool) (p : post) : string =
    if p.author_username <> "" then p.author_username
    else
        match first_where (fun (a : account) => a.id = p.author_id) pl.users with
        | Some a => a.username
        | None => "user " ++# p.author_id

let ref_line (pl : pool) (level : i32) (kind : ref_kind) (p : post) : string =
    indent level ++# "> " ++# ref_label kind ++# " @" ++# author_of pl p ++# ": " ++# shown_text p ++# metrics_text p.public_metrics

inl find_post (pl : pool) (id : string) : option post = first_where (fun (p : post) => p.id = id) pl.posts

inl missing_ref (level : i32) (r : reference) : string =
    indent level ++# "> " ++# ref_label r.kind ++# " a post not loaded (" ++# r.id ++# ")"

type view_options = {depth : i32; hints : bool; minute : string -> string}

inl hints_of (pl : pool) (o : view_options) (level : i32) (p : post) : list string =
    if o.hints then hint_lines pl (level + 1) p else Nil

let rec post_lines (pl : pool) (o : view_options) (level : i32) (p : post) : list string =
    inl hints = hints_of pl o level p
    if level >= o.depth then hints else listm.append hints (spread (ref_lines pl o level) p.refs)

and let ref_lines (pl : pool) (o : view_options) (level : i32) (r : reference) : list string =
    match find_post pl r.id with
    | Some p => Cons (ref_line pl (level + 1) r.kind p, post_lines pl o (level + 1) p)
    | None => [missing_ref (level + 1) r]

inl reposted_id (p : post) : option string =
    match p.refs with
    | Cons ({kind id}, Nil) =>
        match kind with
        | Reposted => Some id
        | _ => None
    | _ => None

inl original_of (pl : pool) (o : view_options) (p : post) : option post =
    match reposted_id p with
    | Some id when o.depth > 0 => find_post pl id
    | _ => None

inl repost_line (pl : pool) (o : view_options) (p : post) (q : post) : string =
    inl head = o.minute p.created_at ++# "  @" ++# p.author_username ++# "  reposted @" ++# author_of pl q
    head ++# ": " ++# shown_text q ++# metrics_text q.public_metrics

let entry_lines (pl : pool) (o : view_options) (p : post) : list string =
    match original_of pl o p with
    | Some q => Cons (repost_line pl o p q, post_lines pl o 0 q)
    | None => Cons (render_post o.minute p, post_lines pl o 0 p)

type selection = {limit : i32; per_author : i32}

let selected (s : selection) (l : list post) : list post =
    l |> newest_first |> per_author s.per_author |> take_first s.limit

inl at (id : string) (who : string) (stamp : string) : post =
    {id author_id = "u" ++# who; author_username = who; created_at = stamp; text = "t" ++# id; public_metrics = no_metrics (); refs = Nil; urls = Nil; media_keys = Nil}

inl citing (kind : ref_kind) (target : string) (p : post) : post = {p with refs = [{kind id = target}]}

inl quote_chain () : post * pool =
    inl c = at "3" "c" "07:00"
    inl b = at "2" "b" "08:00" |> citing Quoted "3"
    inl a = at "1" "a" "09:00" |> citing RepliedTo "2"
    inl e = empty_pool ()
    a, {e with posts = [a; b; c]}

inl rendered (p : post) : string = render_post utc_minute p

inl quiet (line : string) : string = line ++# "  [0 replies, 0 reposts, 0 likes]"

inl lines_of (pl : pool) (depth : i32) (p : post) : string = entry_lines pl {depth hints = false; minute = utc_minute} p |> sm'.concat_list "|"

inl ids (l : list post) : string =
    l |> each (fun (p : post) => p.id) |> sm'.concat_list ","

///> zig
test newest_first_orders_by_time =
    inl ~early = "2026-10-15T08:00:00.000Z"
    [at "1" "a" early; at "2" "b" "2026-10-15T09:30:00Z"] |> newest_first |> ids |> _assert_eq "2,1"

///> zig
test same_second_orders_newer_id_first_across_formats =
    inl ~stamp = "2026-10-15T09:30:00.000Z"
    [at "9" "a" stamp; at "10" "b" "2026-10-15T09:30:00Z"; at "8" "c" stamp]
    |> newest_first |> ids |> _assert_eq "10,9,8"

///> zig
test per_author_keeps_quiet_accounts_visible =
    inl ~cap = 1i32
    inl loud = [at "5" "loud" "09:05"; at "4" "loud" "09:04"]
    Cons (at "1" "quiet" "08:00", loud)
    |> selected {limit = 2; per_author = cap} |> ids |> _assert_eq "5,1"

///> zig
test links_are_expanded_and_lines_flattened =
    inl ~url = "s1"
    inl p = at "1" "b" "09:05"
    rendered {p with text = "read\nthis " ++# url; urls = [{url; expanded_url = "long1"; title = ""}]}
    |> _assert_eq (quiet ("09:05  @" ++# "b  read this long1"))

///> zig
test counts_say_one_or_many =
    inl ~likes = 2i32
    inl p = at "1" "b" "09:05"
    rendered {p with public_metrics = {reply_count = 1; repost_count = 0; like_count = likes}}
    |> _assert_eq ("09:05  @" ++# "b  t1  [1 reply, 0 reposts, 2 likes]")

///> zig
test references_nest_to_the_requested_depth =
    inl ~depth = 2i32
    inl a, pl = quote_chain ()
    entry_lines pl {depth hints = false; minute = utc_minute} a |> listm.length |> _assert_eq 3i32

///> zig
test missing_posts_are_named =
    inl ~depth = 1i32
    at "1" "a" "09:00" |> citing Reposted "77" |> lines_of (empty_pool ()) depth
    |> _assert_eq (quiet ("09:00  @" ++# "a  t1") ++# "|  > reposted a post not loaded (77)")

inl pool_of (l : list post) : pool =
    inl e = empty_pool ()
    {e with posts = l}

inl fan_repost () : post =
    inl r = at "3" "fan" "09:00"
    {r with text = "RT @" ++# "orig: trunc"} |> citing Reposted "2"

///> zig
test a_repost_shows_its_original_once =
    inl ~depth = 1i32
    inl r = fan_repost ()
    lines_of (pool_of [r; at "2" "orig" "08:00"]) depth r
    |> _assert_eq (quiet ("09:00  @" ++# "fan  reposted @" ++# "orig: t2"))
