open sm'_operators
open prelude
open posts
open wire
open protocol
open reading

inl last_of (l : list string) (fallback : string) : string =
    match listm.rev l with
    | Cons (x, _) => x
    | Nil => fallback

inl first_of (l : list string) (fallback : string) : string =
    match l with
    | Cons (x, _) => x
    | Nil => fallback

inl latest (f : framed) : bool = last_of f.history f.id = f.id

inl count_member (key : string) (n : i32) : string = member key (sm'.obj_to_string n)

inl place_members (h : frame_header) : list string = [member "cell" (json_string h.cell); count_member "k" h.part; count_member "n" h.part_count]

inl text_member (key : string) (s : string) : string = member key (json_string s)

inl frame_json (h : frame_header) (body : string) (original : string) (parent : string) : string =
    object (listm.append (place_members h) [text_member "body" body; text_member "original" original; text_member "parent" parent])

let frames_of (f : framed) : list string =
    match frame_text_of (expand_urls f.urls f.text) with
    | Some t when latest f => [frame_json t.header t.body (first_of f.history f.id) f.parent]
    | _ => Nil

inl known_ids (l : list framed) : list string = l |> spread (fun (f : framed) => Cons (f.id, f.history))

inl posts_of_pages (doc : json) : json =
    $'serde_json::Value::from((!doc).as_array().map(|ps| ps.iter().flat_map(|p| p["data"].as_array().cloned().unwrap_or_default()).collect::<Vec<_>>()).unwrap_or_default())'

let located (bundle : string) : string =
    inl posts = parse_json bundle |> posts_of_pages |> collect framed_of
    inl frames = posts |> spread frames_of |> items
    object [member "frames" frames; member "known" (known_ids posts |> each quoted_text |> items)]

inl main () : i32 =
    !!!!Export("xc_locate", ((fun bundle => located bundle) : string -> string))
    0i32