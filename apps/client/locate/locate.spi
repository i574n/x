///- --package ..
///> rust -d serde_json
test locate static =
    open testing

open sm'_operators
open prelude
open posts
open wire
open glyphs
open protocol
open reading

inl first_of (l : post_ids) (fallback : post_id) : post_id =
    match l with
    | Cons (x, _) => x
    | Nil => fallback

inl count_member (key : string) (n : i32) : string = member key (sm'.obj_to_string n)

inl place_members (h : frame_header) : list string = [member "cell" (json_string (cell_text h.cell)); count_member "k" h.part; count_member "n" h.part_count]

inl text_member (key : string) (s : string) : string = member key (json_string s)

inl frame_json (h : frame_header) (body : string) (original : post_id) (parent : option post_id) : string =
    object (listm.append (place_members h) [text_member "body" body; text_member "original" (post_text original); text_member "parent" (optional_text parent)])

let frames_of (f : framed) : list string =
    match frame_text_of (expand_urls f.urls f.text) with
    | Some t when latest f => [frame_json t.header t.body (first_of f.history f.id) f.parent]
    | _ => Nil

inl known_ids (l : list framed) : post_ids = l |> spread (fun (f : framed) => Cons (f.id, f.history))

inl page_posts (doc : json) : list json = doc |> collect id |> spread (fun (p : json) => p |> field "data" |> collect id)

inl known_json (l : list framed) : string = known_ids l |> each post_text |> each quoted_text |> items

let located (bundle : string) : string =
    inl posts = parse_json bundle |> page_posts |> each framed_of
    inl frames = posts |> spread frames_of |> items
    object [member "frames" frames; member "known" (known_json posts)]

inl page_post (id : string) (text : string) : string =
    object [member "id" (quoted_text id); member "text" (json_string text); member "edit_history_post_ids" (items [quoted_text id])]

inl one_page (posts : list string) : string = items [object [member "data" (items posts)]]

inl one_frame () : string = "{\"cell\":\"c1\",\"k\":1,\"n\":2,\"body\":\"go a.zz\",\"original\":\"5\",\"parent\":\"\"}"

inl located_pair () : string = "{\"frames\":[" ++# one_frame () ++# "],\"known\":[\"5\",\"5\",\"6\",\"6\"]}"

test posts_with_headers_become_frames =
    inl ~text = "c1 1/2\ngo a" ++# defused_dot () ++# "zz"
    located (one_page [page_post "5" text; page_post "6" "no header here"]) |> _assert_eq (located_pair ())

inl edited_post () : string =
    object [member "id" (quoted_text "7"); member "text" (json_string "c1 1/1\nold"); member "edit_history_post_ids" (items [quoted_text "7"; quoted_text "8"])]

test superseded_edits_are_known_but_not_framed =
    inl ~page = one_page [edited_post ()]
    located page |> _assert_eq "{\"frames\":[],\"known\":[\"7\",\"7\",\"8\"]}"

///> _
inl main () : i32 =
    !!!!Export("xc_locate", ((fun bundle => located bundle) : string -> string))
    0i32