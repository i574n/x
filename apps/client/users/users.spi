///- --package ..
///> rust -d serde_json
test users static =
    :< testing

:< sm'_operators
:< prelude
:< posts
:< cli
:< wire
:< transport

:== lookup_reply = i32 * string * string * string

:== listed = i32 * string * string

:= failed_lookup (f : failure) : lookup_reply = 4i32, "", "", describe_failure f

:= found_lookup (doc : json) : lookup_reply =
    ?= users_of_doc doc ?|
    | users_reply { found unknown } => 0i32, account_lines found, sm'.concat_list "," unknown, ""

:~ named (base : string) (bearer : string) (hs : string) : lookup_reply =
    ?= get_raw (app_api base bearer) (read_path (Users (Named (pieces "," hs)))) ?|
    | Ok (doc, _) => found_lookup doc
    | Error f => failed_lookup f

:= grown (wanted : i32) (acc : accounts) (doc : json) : accounts * string =
    ?= page_of_doc doc ?|
    | page_reply { page next_token } =>
        := acc = listm.append acc page
        acc, (? listm.length acc >= wanted ?> "" |: next_token)

:= page_path (id : user_id) (n : i32) (cursor : string) (acc : accounts) =
    read_path (FollowedBy { follower = id; size = page_size (n - listm.length acc); pagination_token = cursor })

:= page_of (a : app) (id : user_id) (n : i32) (cursor : string) (acc : accounts) : got fetched =
    get_raw a (page_path id n cursor acc)

:~ ^ pages (a : app) (id : user_id) (n : i32) (cursor : string) (acc : accounts) : got accounts =
    page_of a id n cursor acc |> then_ok \ (doc, _) =>
        := l, more = grown n acc doc
        ? more = "" ?> Ok (take_first n l) |: pages a id n more l

:= listed_of (r : got accounts) : listed =
    ?= r ?|
    | Ok l => 0i32, account_lines l, ""
    | Error f => 4i32, "", describe_failure f

:= following_read_limit () : i32 = 200i32

:= too_wide () : string =
    "--max-following all would read more than "
    ++# sm'.obj_to_string (following_read_limit ())
    ++# " timelines; pass a number to confirm"

:= capped_listing (r : got accounts) : listed =
    ?= r ?|
    | Ok l ?& (listm.length l : i32) > following_read_limit () => 4i32, "", too_wide ()
    | _ => listed_of r

:= following_wanted (cap : i32) : i32 = ? cap < 0i32 ?> following_read_limit () + 1i32 |: cap

:~ followed (base : string) (bearer : string) (id : string) (cap : i32) : listed =
    := r = pages (app_api base bearer) (user_id id) (following_wanted cap) "" Nil
    ? cap < 0i32 ?> capped_listing r |: listed_of r

:= listed_items (key : string) (body : string) : list string = parse_json body |> field key |> collect json_text

:= merged_users (bodies : list string) : string =
    object [
        member "data" (items (bodies |> spread (listed_items "data")))
        member "errors" (items (bodies |> spread (listed_items "errors")))
    ]

:= ids_chunks (ids : string) : list (list user_id) = listm'.chunks_ (lookup_limit ()) (pieces "," ids |> each user_id)

test user_ids_chunk_to_the_lookup_limit =
    := ~n = 250i32
    listm.init n (\ i => sm'.obj_to_string i)
    |> delimited ","
    |> ids_chunks
    |> each (\ c => listm.length c : i32)
    |> _assert_eq [ 100i32; 100i32; 50i32 ]

:= users_listed (r : got (list (json * string))) : listed =
    ?= r ?|
    | Ok docs => 0i32, merged_users (docs |> each (\ (_, body) => body)), ""
    | Error f => 4i32, "", describe_failure f

:~ by_ids (base : string) (bearer : string) (ids : string) : listed =
    := a = app_api base bearer
    users_listed (ids_chunks ids |> each (\ c => get_raw a (read_path (Users (Ids c)))) |> resultm.collect_list)

:= account_doc (id : string) (username : string) : string =
    object [ member "id" (quoted_text id); member "username" (quoted_text username) ]

:= two_accounts () : string =
    object [
        member "data" (items [ account_doc "1" "a"; account_doc "2" "b" ])
        member "meta" (object [ member "next_token" (quoted_text "n2") ])
    ]

:= grown_text (wanted : i32) : string =
    := l, more = grown wanted Nil (parse_json (two_accounts ()))
    sm'.obj_to_string (listm.length l : i32) ++# "|" ++# more

test following_pages_stop_once_enough_accounts_are_found =
    := ~wanted = 2i32
    grown_text wanted |> _assert_eq "2|"
    grown_text 5i32 |> _assert_eq "2|n2"

:== asked = string * string * string

:= lookup_exports () : () =
    export "xc_users_named" ((\ (base, bearer, hs) => named base bearer hs) : asked -> lookup_reply)
    export "xc_users_by_ids" ((\ (base, bearer, ids) => by_ids base bearer ids) : asked -> listed)

///> _
:= main () : i32 =
    export
        "xc_users_followed"
        ((\ (base, bearer, id, cap) => followed base bearer id cap) : string * string * string * i32 -> listed)
    lookup_exports ()
    0i32
